diff --git a/drivers/sdxi_char/Makefile b/drivers/sdxi_char/Makefile
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/drivers/sdxi_char/Makefile
@@ -0,0 +1,7 @@
+obj-m := sdxi_char.o
+
+KDIR ?= /lib/modules/$(shell uname -r)/build
+
+all:
+	$(MAKE) -C $(KDIR) M=$(CURDIR) modules
+clean:
+	$(MAKE) -C $(KDIR) M=$(CURDIR) clean

diff --git a/include/uapi/linux/sdxi_user.h b/include/uapi/linux/sdxi_user.h
new file mode 100644
index 000000000000..222222222222
--- /dev/null
+++ b/include/uapi/linux/sdxi_user.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_SDXI_USER_H
+#define _UAPI_LINUX_SDXI_USER_H
+
+#ifdef __KERNEL__
+#include <linux/ioctl.h>
+#include <linux/types.h>
+#else
+#include <sys/ioctl.h>
+#include <stdint.h>
+typedef uint32_t __u32;
+typedef uint64_t __u64;
+#endif
+
+struct sdxi_ioc_memcpy {
+	__u64 src;
+	__u64 dst;
+	__u64 len;
+};
+
+struct sdxi_ioc_compress {
+	__u64 src;
+	__u64 src_len;
+	__u64 dst;
+	__u64 dst_cap;
+	__u32 level;
+	__u32 _pad;
+	__u64 out_len;   /* [out] */
+};
+
+struct sdxi_ioc_decompress {
+	__u64 src;
+	__u64 src_len;
+	__u64 dst;
+	__u64 dst_cap;
+	__u64 out_len;   /* [out] */
+};
+
+#define SDXI_IOC_MAGIC       'X'
+#define SDXI_IOC_MEMCPY      _IOW (SDXI_IOC_MAGIC, 1, struct sdxi_ioc_memcpy)
+#define SDXI_IOC_COMPRESS    _IOWR(SDXI_IOC_MAGIC, 2, struct sdxi_ioc_compress)
+#define SDXI_IOC_DECOMPRESS  _IOWR(SDXI_IOC_MAGIC, 3, struct sdxi_ioc_decompress)
+
+#endif /* _UAPI_LINUX_SDXI_USER_H */

diff --git a/drivers/dma/sdxi/sdxi.h b/drivers/dma/sdxi/sdxi.h
index 000000000000..333333333333 100644
--- a/drivers/dma/sdxi/sdxi.h
+++ b/drivers/dma/sdxi/sdxi.h
@@ -50,6 +50,8 @@
 /* DMAB subtypes */
 #define SDXI_DSC_OP_SUBTYPE_NOP        0x01U
 #define SDXI_DSC_OP_SUBTYPE_COPY       0x03U
+#define SDXI_DSC_OP_SUBTYPE_COMPRESS   0x04U
+#define SDXI_DSC_OP_SUBTYPE_DECOMPRESS 0x05U
 /* ADMIN subtypes */
 #define SDXI_DSC_OP_SUBTYPE_CXT_START  0x03U
 #define SDXI_DSC_OP_SUBTYPE_CXT_STOP   0x04U

Descriptor dispatch in sdxi_engine_process_cxt() needs a new case for
each subtype.  The emulator handles these via zlib compress2() /
uncompress(); an in-tree driver targeting hardware would instead program
the compression accelerator registers.

The result_len output from the hardware (emulator: CSB bytes 12-19) must
be propagated through the dmaengine completion callback so that the char
device ioctl can return it to userspace in ioc.out_len.

---
Emulator ABI notes (rocm-sdxi)
-------------------------------
The emulator implements COMPRESS and DECOMPRESS using zlib compress2()
and uncompress() respectively.  The SUBTYPE values and descriptor layout
documented here match src/sdxi_regs.h and src/sdxi_engine.c in the
rocm-sdxi repository.

Out-of-tree driver notes (sdxi_char.c)
---------------------------------------
sdxi_char.c is intentionally a standalone PCI driver (not integrated
with sdxi.ko) so that it can be loaded without patching the mainline
driver.  It allocates its own DMA-coherent context-table memory, runs
the CXT_START admin sequence during probe, and tears everything down in
remove.  It uses a per-ioctl DMA-coherent bounce buffer; a production
driver would use get_user_pages() pin + scatter-gather for zero-copy.

Locking: a single per-device mutex serialises ioctls.  A production
driver would use a per-context spinlock to allow concurrent submissions.
