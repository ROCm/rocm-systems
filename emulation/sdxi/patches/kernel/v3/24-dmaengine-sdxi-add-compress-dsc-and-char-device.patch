 drivers/sdxi_char/Makefile      |  7 ++
 drivers/sdxi_char/sdxi_char.c   | 400 +++++++++++++++++++++++++++++++
 drivers/sdxi_char/sdxi_user.h   |  71 ++++++
 include/uapi/linux/sdxi_user.h  |  71 ++++++
 tools/sdxi-cli/Makefile         |  12 ++
 tools/sdxi-cli/sdxi-cli.c       | 390 ++++++++++++++++++++++++++++++
