--- a/hw/pci-bridge/gen_pcie_root_port.c
+++ b/hw/pci-bridge/gen_pcie_root_port.c
@@ -38,0 +39,2 @@ struct GenPCIERootPort {
+    bool atomic_comp32;
+    bool atomic_comp64;
@@ -88,0 +91,12 @@ static void gen_rp_realize(DeviceState *dev, Error **errp)
+    if (grp->atomic_comp32 || grp->atomic_comp64) {
+        uint32_t atomics = 0;
+
+        if (grp->atomic_comp32) {
+            atomics |= PCI_EXP_DEVCAP2_ATOMIC_COMP32;
+        }
+        if (grp->atomic_comp64) {
+            atomics |= PCI_EXP_DEVCAP2_ATOMIC_COMP64;
+        }
+        pci_long_test_and_set_mask(d->config + d->exp.exp_cap + PCI_EXP_DEVCAP2,
+                                   atomics);
+    }
@@ -131,0 +146,2 @@ static const Property gen_rp_props[] = {
+    DEFINE_PROP_BOOL("x-atomic-comp32", GenPCIERootPort, atomic_comp32, false),
+    DEFINE_PROP_BOOL("x-atomic-comp64", GenPCIERootPort, atomic_comp64, false),
