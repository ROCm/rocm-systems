{"version": 2, "width": 100, "height": 30, "timestamp": 1783633324, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "rocgdb-quickstart"}
[0.007753, "o", "\r\n\u001b[1;36m# A tiny HIP kernel that adds 1 to every element:\u001b[0m\r\n"]
[0.009159, "o", "__global__ void add_one(int *data, int n) {\r\n  int i = blockIdx.x * blockDim.x + threadIdx.x;\r\n  if (i < n)\r\n    data[i] += 1;\r\n}\r\n"]
[0.009359, "o", "\r\n\u001b[1;36m# Build it for gfx950 (MI350X) with device debug info:\u001b[0m\r\n"]
[0.012884, "o", "+ hipcc --offload-arch=gfx950 -g -O0 -o /tmp/tmp.2wVNUbw7gL/add_one /home/arosa/rocm-systems/emulation/rocjitsu/demos/../tests/rocgdb/add_one.hip\r\n"]
