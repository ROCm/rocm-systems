[1.218745, "o", "\r\n\u001b[1;36m# Debug the GPU kernel with one command — no GPU required:\u001b[0m\r\n"]
[1.219503, "o", "+ /home/arosa/rocm-systems/emulation/mirage/target/debug/mirage run --profile mi350x --gdb --gdb-ex 'break add_one' --gdb-ex run --gdb-ex 'info args' --gdb-ex 'print n' --gdb-ex 'print data[0]' --gdb-ex continue -- /tmp/tmp.s5wicjgC1O/add_one\r\n"]
