[1.220455, "o", "\r\n\u001b[1;36m# Debug the GPU kernel with one command — no GPU required:\u001b[0m\r\n"]
[1.22085, "o", "+ /home/arosa/rocm-systems/emulation/mirage/target/debug/mirage run --profile mi350x --gdb --gdb-ex 'break add_one' --gdb-ex run --gdb-ex 'info registers pc exec' --gdb-ex 'x/i $pc' --gdb-ex continue -- /tmp/tmp.2wVNUbw7gL/add_one\r\n"]
