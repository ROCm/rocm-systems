{"version": 2, "width": 100, "height": 30, "timestamp": 1783635550, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "rocgdb-watchpoint"}
[0.008605, "o", "\r\n\u001b[1;36m# A tiny HIP kernel that adds 1 to every element of a device buffer:\u001b[0m\r\n"]
[0.009877, "o", "__global__ void add_one(int *data, int n) {\r\n  int i = blockIdx.x * blockDim.x + threadIdx.x;\r\n  if (i < n)\r\n    data[i] += 1;\r\n}\r\n"]
[0.010079, "o", "\r\n\u001b[1;36m# Build it for gfx950 (MI350X) with device debug info:\u001b[0m\r\n"]
[0.011887, "o", "+ hipcc --offload-arch=gfx950 -g -O0 -o /tmp/tmp.aZNGXRzm1I/add_one /home/arosa/rocm-systems/emulation/rocjitsu/demos/../tests/rocgdb/add_one.hip\r\n"]
[0.528479, "o", "\u001b[1m/home/arosa/rocm-systems/emulation/rocjitsu/demos/../tests/rocgdb/add_one.hip:33:3: \u001b[0m\u001b[0;1;35mwarning: \u001b[0m\u001b[1mignoring return value of type 'hipError_t' declared with 'nodiscard' attribute [-Wunused-value]\u001b[0m\r\n   33 |   hipFree(d);\u001b[0m\r\n      | \u001b[0;1;32m  ^~~~~~~~~~\r\n\u001b[0m"]
[0.633036, "o", "1 warning generated when compiling for gfx950.\r\n"]
