[1.190908, "o", "1 warning generated when compiling for host.\r\n"]
[1.225168, "o", "\r\n\u001b[1;36m# Set a hardware watchpoint on the device buffer and catch the GPU store:\u001b[0m\r\n"]
[1.225987, "o", "+ /home/arosa/rocm-systems/emulation/mirage/target/debug/mirage run --profile mi350x --gdb --gdb-ex 'break add_one.hip:27' --gdb-ex 'break add_one' --gdb-ex run --gdb-ex 'set $waddr = (unsigned long)d' --gdb-ex continue --gdb-ex 'watch *(int*)$waddr' --gdb-ex continue --gdb-ex continue -- /tmp/tmp.aZNGXRzm1I/add_one\r\n"]
