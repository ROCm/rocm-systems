{"version": 2, "width": 100, "height": 30, "timestamp": 1783636824, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "rocgdb-multiwave"}
[0.010458, "o", "\r\n\u001b[1;36m# A HIP kernel launched as one workgroup of 128 threads = two 64-lane waves:\u001b[0m\r\n"]
[0.013315, "o", "__global__ void multi_wave(int *data, int n) {\r\n  int i = blockIdx.x * blockDim.x + threadIdx.x;\r\n  int local = i * 7 + 3;\r\n  if (i < n)\r\n    data[i] = local;\r\n}\r\n"]
[0.013508, "o", "\r\n\u001b[1;36m# Build it for gfx950 (MI350X) with device debug info:\u001b[0m\r\n"]
[0.015736, "o", "+ hipcc --offload-arch=gfx950 -g -O0 -o /tmp/tmp.RHDDLnRxDh/multi_wave /home/arosa/rocm-systems/emulation/rocjitsu/demos/../tests/rocgdb/multi_wave.hip\r\n"]
