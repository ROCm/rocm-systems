{"version": 2, "width": 100, "height": 30, "timestamp": 1783636162, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "rocgdb-fault"}
[0.009987, "o", "\r\n\u001b[1;36m# A HIP kernel that stores through a wild, never-mapped device pointer:\u001b[0m\r\n"]
[0.011269, "o", "__global__ void bad_access(int *data, int n) {\r\n  int i = blockIdx.x * blockDim.x + threadIdx.x;\r\n  // A wild, never-mapped device address. The store below faults.\r\n  int *wild = reinterpret_cast<int *>(0x0000dead0000ULL);\r\n  if (i < n)\r\n    wild[i] = data[i] + 1;\r\n}\r\n"]
[0.011443, "o", "\r\n\u001b[1;36m# Build it for gfx950 (MI350X) with device debug info:\u001b[0m\r\n"]
[0.014641, "o", "+ hipcc --offload-arch=gfx950 -g -O0 -o /tmp/tmp.wtWfqkbt4t/bad_access /home/arosa/rocm-systems/emulation/rocjitsu/demos/../tests/rocgdb/bad_access.hip\r\n"]
[0.531921, "o", "\u001b[1m/home/arosa/rocm-systems/emulation/rocjitsu/demos/../tests/rocgdb/bad_access.hip:29:3: \u001b[0m\u001b[0;1;35mwarning: \u001b[0m\u001b[1mignoring return value of type 'hipError_t' declared with 'nodiscard' attribute [-Wunused-value]\u001b[0m\r\n   29 |   hipFree(d);\u001b[0m\r\n      | \u001b[0;1;32m  ^~~~~~~~~~\r\n\u001b[0m"]
[0.635648, "o", "1 warning generated when compiling for gfx950.\r\n"]
[1.136021, "o", "\u001b[1m/home/arosa/rocm-systems/emulation/rocjitsu/demos/../tests/rocgdb/bad_access.hip:29:3: \u001b[0m\u001b[0;1;35mwarning: \u001b[0m\u001b[1mignoring return value of type 'hipError_t' declared with 'nodiscard' attribute [-Wunused-value]\u001b[0m\r\n   29 |   hipFree(d);\u001b[0m\r\n      | \u001b[0;1;32m  ^~~~~~~~~~\r\n\u001b[0m"]
[1.189941, "o", "1 warning generated when compiling for host.\r\n"]
[1.221753, "o", "\r\n\u001b[1;36m# Run it under ROCgdb — the emulator faults the wave on the wild store:\u001b[0m\r\n"]
[1.222347, "o", "+ /home/arosa/rocm-systems/emulation/mirage/target/debug/mirage run --profile mi350x --gdb --gdb-ex run --gdb-ex backtrace --gdb-ex 'info registers pc' -- /tmp/tmp.wtWfqkbt4t/bad_access\r\n"]
