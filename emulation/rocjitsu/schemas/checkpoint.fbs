//
// FlatBuffers schema for simulation checkpoint/restore.
// Captures the full state of a running AMDGPU simulation.

include "simulation_config.fbs";

namespace rocjitsu.fb;

// Older checkpoints omit the GFX10 tables and retain machine launch defaults.
struct Gfx10Apertures {
  shared_base: ulong;
  shared_limit: ulong;
  private_base: ulong;
  private_limit: ulong;
  ptr32: bool;
}

struct Gfx10WaitLimits {
  vm: ubyte;
  lgkm: ubyte;
  exp: ubyte;
  vs: ubyte;
}

table Gfx10WaveResources {
  apertures: Gfx10Apertures (required);
  override_launch: bool;
  wait_limits: Gfx10WaitLimits (required);
  trapsts: uint;
  scratch_base: ulong;
  scratch_lane_size: uint;
  lds_base: uint;
  lds_size: uint;
  dispatch_id: uint;
  wave_in_group: uint;
  queue_id: uint;
  queue_packet_id: uint;
  vgpr_count: uint;
  self_halted: bool;
}

table Gfx10CuResources {
  launch_apertures: Gfx10Apertures (required);
  next_lds_alloc: uint;
  lds: [ubyte];
}

/// Byte range owned by a workgroup within its CU's LDS.
struct LdsWindow {
  base: uint32;
  size: uint32;
}

/// Serialized state of a single wavefront.
// LaunchDefaults identifies a standalone writer that did not model frontend grants.
enum GraphicsWait: ubyte { None, Export, Parameters, LaunchDefaults }

struct WaveExceptionRegisters {
  trapsts: uint32;
  gfx12_user_extra: uint32;
  gfx12_trap_ctrl: uint32;
}

table WavefrontState {
  wf_id: uint32;
  wg_id: uint32;
  pc: uint64;
  exec: uint64;
  vcc: uint64;
  m0: uint32;
  halted: bool;
  status: uint32;
  sgprs: [uint32]; // RDNA2 stores its full physical block, including fixed SGPRs.
  vgprs: [ubyte];  // Vector register file (raw bytes).
  mode: uint32;     // MODE register.
  wave_sched_mode: uint32; // WAVE_SCHED_MODE register.
  // Trap-temporary registers (TTMP0-15). These are a separate register file,
  // not the tail of `sgprs`: the ISA decoder routes scalar selectors 108..123
  // here. Appended last so older checkpoints still load: the accessor returns
  // null, and restore then migrates the values out of `sgprs[108..123]`, which
  // is where the same selectors were stored before the split. Zeroing them
  // instead would not be safe -- RDNA4 and GFX1250 seed TTMP6/7/9 with
  // workgroup ids at dispatch, so a wave that was never in a trap handler still
  // holds meaningful TTMPs there.
  ttmps: [uint32];
  // Workgroup coordinate (x, y, z) this wave was dispatched with. Not derivable
  // from `wg_id`: recovering the coordinate from the flat id needs the grid
  // dimensions, which live in the dispatch packet and are not part of a
  // checkpoint. Trap entry publishes these three values in TTMP8/9/10 and the
  // CWSR codec serializes them, so a restored wave that lost them reports the
  // wrong workgroup identity to the trap handler and cannot be matched back to
  // its CWSR record. Appended last so older checkpoints still load; see
  // restore_checkpoint() for the fallback applied when the accessor is null.
  wg_coord: [uint32];
  kernel_wave_size: ubyte; // Architectural wave width.
  vgpr_lane_count: ubyte; // Per-register lane count in the VGPR payload.
  // Transient gfx1250 instruction-adjacency state. Appended last so older
  // checkpoints restore it as false.
  setreg_vgpr_msb_hazard: bool;
  gfx10_resources: Gfx10WaveResources;
  dispatch_id: uint32;
  // Active RDNA2 waves require an explicit owner, including the standalone process zero.
  rdna2_process_id: uint32 = null;
  rdna2_internal_address_space: bool;
  process_id: uint32;
  queue_id: uint32;
  wave_in_group: uint32;
  // CDNA3 may have additional addressable SGPRs in a partially requested physical block.
  requested_sgprs: uint32 = null;
  flat_scratch: uint64 = null;
  lds_window: LdsWindow;
  // Architectural VGPR allocation, distinct from the serialized physical register block.
  // Older records omit the total and restore the configured VGPR count.
  num_vgprs: uint32 = null;
  accum_vgpr_base: uint32; // CDNA descriptor boundary in VGPRs; zero for descriptor-less waves.
  // Requested SGPRs may differ from the physical SGPR payload on RDNA2,
  // CDNA1, CDNA2 and CDNA4. Older records can omit this count.
  num_sgprs: uint32 = null;
  // None, Export and Parameters preserve the readiness bits supplied by the frontend.
  graphics_wait: GraphicsWait = null;
  exceptions: WaveExceptionRegisters;
}

/// Serialized state of a compute unit.
table ComputeUnitState {
  name: string;
  wavefronts: [WavefrontState];
  next_wf: uint64; // Round-robin scheduling index.
  // Raw configured functional quantum for this CU (0 = unbounded). The
  // presence marker distinguishes an explicit zero from checkpoints written
  // before per-CU execution controls were serialized.
  functional_quantum: uint32;
  functional_quantum_present: bool;
  // Preserve each CU's effective diagnostic policies. Absent legacy fields
  // retain the native defaults; false explicitly disables the corresponding check.
  memory_wait_checks: bool = null;
  xcnt_checks: bool = null;
  // Unpaused CU steps without process instruction progress; zero disables the budget.
  // Absent legacy values keep the CU configuration default.
  gws_wait_limit: uint32 = null;
  // Omission inherits the CU template policy, which need not be Compatibility.
  arithmetic: ArithmeticPolicyConfig;
  gfx10_resources: Gfx10CuResources;
  // Shared SGPR/VGPR physical block ordinal for each RDNA2 record in wavefronts order.
  // Older files lack this vector and retain first-free register allocation on restore.
  rdna2_register_blocks: [uint32];
  // This CU-owned LDS prefix is shared by its resident waves. Earlier CDNA3
  // records used its length as the bump allocator reservation.
  lds: [ubyte];
  lds_cursor: uint32 = null;
}

/// Serialized state of a command processor.
table CommandProcessorState {
  name: string;
  dispatched: uint64; // Number of packets already processed.
  next_cu: uint64;    // Round-robin CU index.
  // Per-XCD dispatch ID sequences, shared by AQL and PM4 launches.
  next_dispatch_ids: [uint32];
}

/// A single 4KB memory page.
table MemoryPage {
  address: uint64; // Page-aligned base address.
  data: [ubyte];   // 4096 bytes of page data.
}

/// Serialized state of GPU memory.
table GpuMemoryState {
  pages: [MemoryPage];
}

/// Complete simulation checkpoint.
table SimulationCheckpoint {
  tick: uint64;
  config: SimulationConfig;
  compute_units: [ComputeUnitState];
  command_processor: CommandProcessorState;
  memory: GpuMemoryState;
}

root_type SimulationCheckpoint;
