{
  "name": "rocjitsu-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "dev:data": "node scripts/dev-with-data.mjs",
    "preview:data": "node scripts/dev-with-data.mjs --preview",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "validate:data": "node scripts/validate-dashboard-data.mjs",
    "test:unit": "vitest run",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.js",
    "test:e2e:chart-race": "playwright test --project=desktop tests/e2e/benchmarks.e2e.js --grep \"benchmark explorer switches among single, grid, and aggregate modes\" --repeat-each=10 --workers=1",
    "test": "npm run test:unit && npm run test:e2e && npm run test:e2e:chart-race",
    "verify": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
