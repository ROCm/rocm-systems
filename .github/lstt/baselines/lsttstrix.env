# Expected firmware and software versions for lsttstrix (Strix Halo, gfx1151).
# Bump a value here in its own PR once the machine has been updated: a mismatch
# fails CI, which is how an undocumented change gets noticed.
# An empty value is reported but not enforced, so a host can be onboarded
# before its target versions are agreed.

EXPECT_BIOS=
EXPECT_BMC=
EXPECT_AMDGPU=
