#!/bin/sh
# Copyright Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

# Unified post-installation entry point for amdcuid.
# Template processed by CMake to generate the installed 'amdcuid_postinst.sh'.
# Do not edit the generated script directly; edit this '.in' template instead.
#
# Always runs the library post-install (provisions the HMAC key).
# Automatically runs the daemon post-install when the daemon binary is present.

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
LIB_POSTINST="$SCRIPT_DIR/amdcuid_setup_hmac.sh"
DAEMON_POSTINST="$SCRIPT_DIR/amdcuid_daemon_postinst.sh"
DAEMON_BIN="$SCRIPT_DIR/../../bin/amdcuid_daemon"

echo "=== amdcuid post-installation ==="

# --- Library post-install (always required) ---
echo ""
echo "Step 1: Running library post-install (HMAC key provisioning)..."
if [ -x "$LIB_POSTINST" ]; then
    "$LIB_POSTINST"
    LIB_RC=$?
    if [ $LIB_RC -ne 0 ]; then
        echo "ERROR: Library post-install failed (exit code $LIB_RC)." >&2
        exit $LIB_RC
    fi
    echo "Library post-install complete."
else
    echo "ERROR: Library post-install script not found at $LIB_POSTINST." >&2
    exit 1
fi

# --- Daemon post-install (only when daemon is installed) ---
echo ""
if [ -x "$DAEMON_BIN" ]; then
    echo "Step 2: Daemon binary detected at $DAEMON_BIN."
    echo "        Running daemon post-install (udev rules / systemd service)..."
    if [ -x "$DAEMON_POSTINST" ]; then
        "$DAEMON_POSTINST"
        DAEMON_RC=$?
        if [ $DAEMON_RC -ne 0 ]; then
            echo "ERROR: Daemon post-install failed (exit code $DAEMON_RC)." >&2
            exit $DAEMON_RC
        fi
        echo "Daemon post-install complete."
    else
        echo "ERROR: Daemon post-install script not found at $DAEMON_POSTINST." >&2
        exit 1
    fi
else
    echo "Step 2: Daemon binary not found — skipping daemon post-install."
    echo "        To add daemon support later, install the daemon component and"
    echo "        re-run this script."
fi

echo ""
echo "=== amdcuid post-installation complete ==="
