#!/bin/sh
# Copyright Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

# Unified pre-removal entry point for amdcuid.
# Template processed by CMake to generate the installed 'amdcuid_prerm.sh'.
# Do not edit the generated script directly; edit this '.in' template instead.
#
# Automatically runs the daemon pre-removal steps when the daemon binary is
# present, then leaves the HMAC key and config in place (per the intentional
# policy of amdcuid_prerm.sh) so CUIDs remain stable across reinstalls.
#
# NOTE: /etc/amdcuid/ (the HMAC key and daemon config) is intentionally
# preserved so that reinstalls keep the same CUID values.
# To fully purge configuration run: sudo rm -rf @AMDCUID_SHARED_CONFIG_DIR@

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
DAEMON_PRERM="$SCRIPT_DIR/amdcuid_daemon_prerm.sh"
DAEMON_BIN="$SCRIPT_DIR/../../bin/amdcuid_daemon"

echo "=== amdcuid pre-removal ==="

# --- Daemon pre-removal (only when daemon is installed) ---
echo ""
if [ -x "$DAEMON_BIN" ]; then
    echo "Step 1: Daemon binary detected at $DAEMON_BIN."
    echo "        Running daemon pre-removal (stopping service, removing udev rules)..."
    if [ -x "$DAEMON_PRERM" ]; then
        "$DAEMON_PRERM"
        DAEMON_RC=$?
        if [ $DAEMON_RC -ne 0 ]; then
            echo "ERROR: Daemon pre-removal failed (exit code $DAEMON_RC)." >&2
            exit $DAEMON_RC
        fi
        echo "Daemon pre-removal complete."
    else
        echo "ERROR: Daemon pre-removal script not found at $DAEMON_PRERM." >&2
        exit 1
    fi
else
    echo "Step 1: Daemon binary not found — skipping daemon pre-removal."
fi

echo ""
echo "=== amdcuid pre-removal complete ==="
echo ""
echo "Note: /etc/amdcuid/ (HMAC key and config) has been preserved."
echo "      To fully purge configuration run: sudo rm -rf @AMDCUID_SHARED_CONFIG_DIR@"
