# Run the pre-removal script to stop daemon, remove udev rules, systemd service symlink, and cron job.
set(_prerm "$ENV{DESTDIR}@CMAKE_INSTALL_DATADIR@/@AMDCUID@/amdcuid_prerm.sh")

if(EXISTS "${_prerm}")
    message(STATUS "Running pre-removal script: ${_prerm}")
    execute_process(COMMAND sh "${_prerm}" RESULT_VARIABLE _prerm_result)
    if(NOT _prerm_result EQUAL 0)
        message(WARNING "Pre-removal script exited with code ${_prerm_result}. " "Continuing with file removal anyway.")
    endif()
else()
    message(STATUS "Pre-removal script not found (${_prerm}); skipping daemon teardown.")
endif()

# Remove all files tracked by cmake --install via install_manifest.txt
if(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")
    message(
        FATAL_ERROR
        "Cannot find install manifest: @CMAKE_BINARY_DIR@/install_manifest.txt\n"
        "Run 'cmake --install' before attempting to uninstall."
    )
endif()

file(READ "@CMAKE_BINARY_DIR@/install_manifest.txt" files)
string(REGEX REPLACE "\n" ";" files "${files}")

foreach(file ${files})
    message(STATUS "Uninstalling: $ENV{DESTDIR}${file}")
    if(IS_SYMLINK "$ENV{DESTDIR}${file}" OR EXISTS "$ENV{DESTDIR}${file}")
        execute_process(
            COMMAND "@CMAKE_COMMAND@" -E remove "$ENV{DESTDIR}${file}"
            OUTPUT_VARIABLE rm_out
            RESULT_VARIABLE rm_result
        )
        if(NOT rm_result EQUAL 0)
            message(FATAL_ERROR "Failed to remove: $ENV{DESTDIR}${file}")
        endif()
    else()
        message(STATUS "File not found, skipping: $ENV{DESTDIR}${file}")
    endif()
endforeach()

# ---------------------------------------------------------------------------
# Remove amdcuid-specific directories left behind after file removal.
# Only directories whose names are amdcuid-specific are listed here, so
# shared directories like bin/ and lib/ are never touched.
# Subdirectories are listed before parents so each rmdir call finds them empty.
# ---------------------------------------------------------------------------
set(_amdcuid_dirs
    "$ENV{DESTDIR}@CMAKE_INSTALL_DATADIR@/@AMDCUID@/config"
    "$ENV{DESTDIR}@CMAKE_INSTALL_DATADIR@/@AMDCUID@"
    "$ENV{DESTDIR}@CMAKE_INSTALL_LIBEXECDIR@/@AMDCUID@"
)

foreach(_dir ${_amdcuid_dirs})
    if(IS_DIRECTORY "${_dir}")
        file(GLOB _dir_contents "${_dir}/*")
        if(_dir_contents)
            message(STATUS "Directory not empty, skipping: ${_dir}")
        else()
            message(STATUS "Removing directory: ${_dir}")
            file(REMOVE_RECURSE "${_dir}")
        endif()
    endif()
endforeach()
