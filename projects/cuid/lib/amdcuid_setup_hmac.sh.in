#!/bin/sh
# Copyright Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

# Provisions the HMAC key used by libamdcuid to generate stable CUIDs.
# Template processed by CMake to substitute @AMDCUID_SHARED_CONFIG_DIR@.
# Do not edit the generated script directly; edit this .in template instead.
#
# Idempotent — safe to run on reinstalls and upgrades. An existing key is
# never overwritten so existing CUID files remain valid.

CONFIG_DIR="@AMDCUID_SHARED_CONFIG_DIR@"
HMAC_KEY_FILE="$CONFIG_DIR/hmac_key.bin"

mkdir -p "$CONFIG_DIR"
chmod 755 "$CONFIG_DIR"

if [ ! -f "$HMAC_KEY_FILE" ]; then
    echo "Generating HMAC key at $HMAC_KEY_FILE..."
    # Create the file with restrictive permissions *before* writing key material
    # to it, so the secret is never briefly world-readable. /dev/urandom is the
    # kernel CSPRNG and needs no package beyond coreutils.
    umask_old=$(umask)
    umask 077
    if ! dd if=/dev/urandom of="$HMAC_KEY_FILE" bs=32 count=1 status=none; then
        echo "ERROR: Failed to generate HMAC key from /dev/urandom." >&2
        rm -f "$HMAC_KEY_FILE"
        umask "$umask_old"
        exit 1
    fi
    umask "$umask_old"
    if [ "$(wc -c <"$HMAC_KEY_FILE")" -ne 32 ]; then
        echo "ERROR: Short read from /dev/urandom while generating HMAC key." >&2
        rm -f "$HMAC_KEY_FILE"
        exit 1
    fi
    chmod 600 "$HMAC_KEY_FILE"
    chown root:root "$HMAC_KEY_FILE"
else
    echo "HMAC key already exists at $HMAC_KEY_FILE; leaving it unchanged."
fi
