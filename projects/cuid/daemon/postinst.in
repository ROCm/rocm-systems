# Post-installation script for amdcuid daemon.
# Template processed by CMake to generate the installed 'postinst' script.
# Do not edit the generated 'postinst' script directly; edit this 'postinst.in' template instead.
# This script reads the daemon config file to decide whether to install udev
# rules (daemonize=true) or a cron job (daemonize=false) for the daemon.

CONFIG_DIR="@AMDCUID_SHARED_CONFIG_DIR@"
VERSIONED_CONFIG_FILE="@CMAKE_INSTALL_PREFIX@/@CONFIG_INSTALL_DIR@/amdcuid_daemon.conf"
CONFIG_FILE="$CONFIG_DIR/amdcuid_daemon.conf"
HMAC_KEY_FILE="$CONFIG_DIR/hmac_key.bin"
TOOL_BIN="@CMAKE_INSTALL_PREFIX@/bin/amdcuid_tool"
DAEMON_BIN="@CMAKE_INSTALL_PREFIX@/bin/amdcuid_daemon"
UDEV_RULES_FILE="/etc/udev/rules.d/90-amdcuid.rules"
CRON_FILE="/etc/cron.d/amdcuid"
SERVICE_NAME="amdcuid_daemon"

if [ ! -f "$CONFIG_FILE" ]; then
    # First install: seed the shared config dir from the versioned defaults.
    mkdir -p "$CONFIG_DIR"
    chmod 755 "$CONFIG_DIR"
    if [ -f "$VERSIONED_CONFIG_FILE" ]; then
        cp "$VERSIONED_CONFIG_FILE" "$CONFIG_FILE"
    else
        echo "Warning: amdcuid config not found at $VERSIONED_CONFIG_FILE; skipping daemon setup."
        exit 0
    fi
fi

# Generate the HMAC key only if one does not already exist, so reinstalls and
# upgrades preserve the existing key (and therefore existing CUID files remain
# valid).
if [ ! -f "$HMAC_KEY_FILE" ]; then
    echo "Generating HMAC key at $HMAC_KEY_FILE..."
    # openssl is already a hard dependency (libssl); use it to produce 32 bytes
    # of cryptographically-random key material and immediately restrict access.
    openssl rand -out "$HMAC_KEY_FILE" 32
    chmod 600 "$HMAC_KEY_FILE"
    chown root:root "$HMAC_KEY_FILE"
else
    echo "HMAC key already exists at $HMAC_KEY_FILE; leaving it unchanged."
fi

DAEMONIZE=$(grep "^daemonize=" "$CONFIG_FILE" | cut -d'=' -f2 | tr -d '[:space:]')

if [ "$DAEMONIZE" = "true" ]; then
    # The daemon runs as a persistent service that wakes on udev device events.
    # Install the udev rules first so the daemon is triggered on device changes,
    # then register and start the service so it is ready to receive those events.
    echo "Setting up udev rules for amdcuid daemon..."
    cat > "$UDEV_RULES_FILE" << EOF
# AMD CUID daemon udev rules
SUBSYSTEM=="drm", ACTION=="add|remove|change", RUN+="$TOOL_BIN --notify-daemon"
SUBSYSTEM=="net", ACTION=="add|remove|change", RUN+="$TOOL_BIN --notify-daemon"
EOF
    udevadm control --reload-rules
    udevadm trigger

    echo "Registering amdcuid_daemon as a systemd service..."
    systemctl daemon-reload
    systemctl enable "$SERVICE_NAME"
    systemctl start "$SERVICE_NAME"
    # remove any existing cron job in case we're upgrading from a resource-constrained mode install
    if [ -f "$CRON_FILE" ]; then
        echo "Removing existing cron job for amdcuid daemon..."
        rm -f "$CRON_FILE"
    fi
else
    # Resource-constrained mode: skip the persistent service and udev rules.
    # Instead, install a cron job so the daemon runs once at boot to generate
    # CUIDs and then exits.
    echo "Daemon mode not enabled; installing boot-time cron job for amdcuid daemon..."
    echo "@reboot root $DAEMON_BIN" > "$CRON_FILE"

    # remove any existing systemd service and udev rules in case we're upgrading from a full-service install
    if systemctl is-enabled "$SERVICE_NAME" >/dev/null 2>&1; then
        echo "Removing existing systemd service for amdcuid daemon..."
        systemctl stop "$SERVICE_NAME" 2>/dev/null || true
        systemctl disable "$SERVICE_NAME" 2>/dev/null || true

        rm -f "$UDEV_RULES_FILE"
        udevadm control --reload-rules
        udevadm trigger
    fi
fi
