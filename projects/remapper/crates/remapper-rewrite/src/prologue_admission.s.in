// Admission-control variant of the binary workgroup remap prologue for gfx1250 (wave32). The replayer launches the
// captured workgroups plus slack. A location's k-th arrival runs table[loc][k] (the recorded schedule) through the
// reserved SGPRs; an arrival past the location's quota parks: it stays resident, which keeps that WGP full so the
// dispatcher places later workgroups on WGPs that still owe tiles, and ends (before the body) once every tile of its
// shader engine has been claimed, or after ${STALL_POLLS} polls without a claim in its engine (slack exhausted:
// tiles are missing and golden verification fails). Only user SGPRs, v0 and the ttmp registers are live at entry.
//
// Control block (64 bytes, address appended to the kernarg segment at ${CTL_KERNARG_OFFSET}):
//   0 mode, 4 max_k, 8 arrival*, 16 table*, 24 counters* (overflow, log count), 32 log*, 40 admission*
// Admission buffer, dwords per shader engine (sharded to avoid one contended address): [0, 32) tiles still to
// claim, [32, 64) parked arrivals, [64, 96) parked arrivals that found tiles still unclaimed (held a WGP).
// Modes: 0 off, 1 record, 3 mark natural (captured grid, hardware ids); 2 table, 4 mark table (padded launch).
// Single-wave workgroups key by SIMD as well (location * 4 + SIMD): the hardware picks the SIMD per workgroup.
	.text
	.p2align 8
aegis_prologue:
	// The descriptor's INST_PREF_SIZE now covers only this prologue; these restore the original body prefetch.
${PREFETCH}
	s_load_b64 ${CTL}, ${KERNARG}, ${CTL_KERNARG_OFFSET}
	s_wait_kmcnt 0x0
	s_load_b64 ${MODE_MAXK}, ${CTL}, 0x0
	s_load_b256 ${PTRS}, ${CTL}, 0x8
	s_load_b64 ${ADM}, ${CTL}, 0x28
	s_bfe_u32 ${WAVE}, ttmp8, 0x50019
	s_mov_b32 ${T9}, ttmp9
	s_mov_b32 ${T7}, ttmp7
	s_wait_kmcnt 0x0
	s_cmp_eq_u32 ${MODE}, 0
	s_cbranch_scc1 .Lhave_tile
	s_cmp_eq_u32 ${MODE}, 3
	s_cbranch_scc1 .Lmark
	s_cmp_lg_u32 ${WAVE}, 0
	s_cbranch_scc1 .Lsync
	// Wave 0: location = (SE*2 + SA)*16 + WGP.
	s_getreg_b32 ${HWID1}, hwreg(HW_REG_HW_ID1)
	s_sendmsg_rtn_b32 ${SEAID}, 0x87
	s_wait_kmcnt 0x0
	s_lshr_b32 ${LOC}, ${SEAID}, 16
	s_lshl_b32 ${LOC}, ${LOC}, 1
	s_and_b32 ${TMP}, ${SEAID}, 15
	s_add_co_i32 ${LOC}, ${LOC}, ${TMP}
	s_lshl_b32 ${LOC}, ${LOC}, 1
	s_bfe_u32 ${TMP}, ${HWID1}, 0x10010
	s_add_co_i32 ${LOC}, ${LOC}, ${TMP}
	s_lshl_b32 ${LOC}, ${LOC}, 4
	s_bfe_u32 ${TMP}, ${HWID1}, 0x4000a
	s_add_co_i32 ${LOC}, ${LOC}, ${TMP}
${SIMD_KEY}
	s_lshr_b32 ${SE}, ${LOC}, ${SE_SHIFT}
	s_mov_b32 ${SAVE_EXEC}, exec_lo
	s_mov_b32 exec_lo, 1
	// Turn: k = atomic_add(arrival[loc], 1).
	s_lshl_b32 ${TMP}, ${LOC}, 2
	v_mov_b32_e32 v1, ${TMP}
	v_mov_b32_e32 v2, 1
	s_wait_alu 0x0
	global_atomic_add_u32 v3, v1, v2, ${ARRIVAL} th:TH_ATOMIC_RETURN scope:SCOPE_DEV
	s_wait_loadcnt 0x0
	s_wait_xcnt 0x0
	v_readfirstlane_b32 ${K}, v3
	s_wait_alu 0x0
	s_cmp_eq_u32 ${MODE}, 1
	s_cbranch_scc1 .Llog
	// Schedule: entry = table[loc*max_k + k] = (ttmp9, ttmp7); past the quota (k >= max_k or no entry) the arrival parks.
	s_cmp_ge_u32 ${K}, ${MAXK}
	s_cbranch_scc1 .Lpark_mark
	s_mul_i32 ${TMP}, ${LOC}, ${MAXK}
	s_add_co_i32 ${TMP}, ${TMP}, ${K}
	s_lshl_b32 ${TMP}, ${TMP}, 3
	s_load_b64 ${ENTRY}, ${TABLE}, ${TMP} offset:0x0
	s_wait_kmcnt 0x0
	s_cmp_eq_u32 ${ENTRY_LO}, -1
	s_cbranch_scc1 .Lpark_mark
	s_mov_b32 ${T9}, ${ENTRY_LO}
	s_mov_b32 ${T7}, ${ENTRY_HI}
	// Claim: one tile fewer for this shader engine.
	s_lshl_b32 ${TMP}, ${SE}, 2
	v_mov_b32_e32 v1, ${TMP}
	s_wait_alu 0x0
	global_atomic_sub_u32 v1, v2, ${ADM} scope:SCOPE_DEV
	s_wait_xcnt 0x0
	s_branch .Lchosen
.Lpark_mark:
	// Park: count it for this engine, and again if its tiles are still unclaimed (the arrival holds a WGP).
	s_mov_b32 ${T9}, -2
	s_lshl_b32 ${TMP}, ${SE}, 2
	s_add_co_i32 ${TMP2}, ${TMP}, 0x80
	v_mov_b32_e32 v1, ${TMP2}
	s_wait_alu 0x0
	global_atomic_add_u32 v1, v2, ${ADM} scope:SCOPE_DEV
	s_wait_xcnt 0x0
	s_load_b32 ${POLL}, ${ADM}, ${TMP} offset:0x0 scope:SCOPE_DEV
	s_wait_kmcnt 0x0
	s_cmp_eq_u32 ${POLL}, 0
	s_cbranch_scc1 .Lpublish
	s_add_co_i32 ${TMP2}, ${TMP}, 0x100
	v_mov_b32_e32 v1, ${TMP2}
	s_wait_alu 0x0
	global_atomic_add_u32 v1, v2, ${ADM} scope:SCOPE_DEV
	s_wait_xcnt 0x0
	s_branch .Lpublish
.Lchosen:
	s_cmp_eq_u32 ${MODE}, 4
	s_cbranch_scc1 .Lpublish
.Llog:
	// Log record (8 dwords) at an index taken from counters[1]: loc, k, ttmp9 and ttmp7 used, HW_ID1, SE/AID,
	// hardware ttmp9 and ttmp7. Parked arrivals are not logged.
	v_mov_b32_e32 v1, 4
	v_mov_b32_e32 v2, 1
	s_wait_alu 0x0
	global_atomic_add_u32 v3, v1, v2, ${COUNTERS} th:TH_ATOMIC_RETURN scope:SCOPE_DEV
	s_wait_loadcnt 0x0
	s_wait_xcnt 0x0
	v_lshlrev_b32_e32 v1, 5, v3
	v_mov_b32_e32 v2, ${LOC}
	v_mov_b32_e32 v3, ${K}
	v_mov_b32_e32 v4, ${T9}
	v_mov_b32_e32 v5, ${T7}
	s_wait_alu 0x0
	global_store_b128 v1, v[2:5], ${LOG}
	s_wait_xcnt 0x0
	s_wait_alu 0x0
	v_mov_b32_e32 v2, ${HWID1}
	v_mov_b32_e32 v3, ${SEAID}
	v_mov_b32_e32 v4, ttmp9
	v_mov_b32_e32 v5, ttmp7
	s_wait_alu 0x0
	global_store_b128 v1, v[2:5], ${LOG} offset:16
	s_wait_xcnt 0x0
.Lpublish:
${PUBLISH}
	s_wait_storecnt 0x0
	s_mov_b32 exec_lo, ${SAVE_EXEC}
.Lsync:
${SYNC}
	s_cmp_eq_u32 ${T9}, -2
	s_cbranch_scc0 .Lreal
	// Parked: wave 0 polls with scalar loads (no VMEM/LDS records in the partner-SIMD stream); the others wait.
	s_cmp_lg_u32 ${WAVE}, 0
	s_cbranch_scc1 .Lpark_done
	// Ending early is always safe: a later arrival at this WGP parks again; only slack is spent.
	s_lshl_b32 ${TMP}, ${SE}, 2
	s_mov_b32 ${K}, 0
	s_mov_b32 ${TMP2}, -1
.Lpark_poll:
	s_load_b32 ${POLL}, ${ADM}, ${TMP} offset:0x0 scope:SCOPE_DEV
	s_wait_kmcnt 0x0
	s_cmp_eq_u32 ${POLL}, 0
	s_cbranch_scc1 .Lpark_done
	s_cmp_eq_u32 ${POLL}, ${TMP2}
	s_cselect_b32 ${K}, ${K}, 0
	s_add_co_i32 ${K}, ${K}, 1
	s_mov_b32 ${TMP2}, ${POLL}
	s_cmp_ge_u32 ${K}, ${STALL_POLLS}
	s_cbranch_scc1 .Lpark_done
	s_sleep 127
	s_branch .Lpark_poll
.Lpark_done:
${PARK_SYNC}
	s_cmp_lg_u32 ${MODE}, 4
	s_cbranch_scc1 .Lend
	// A2 marker: this wave's workgroup ended in the prologue. Thread trace can report the marker up to ~100
	// clocks after a wave that ends right away, outside its residency, so stay resident a little longer.
	s_or_b32 ${TMP}, ${WAVE}, 0xa2000000
	s_mov_b32 m0, ${TMP}
	s_ttracedata
	s_sleep 4
.Lend:
	s_endpgm
.Lreal:
	s_cmp_lg_u32 ${MODE}, 4
	s_cbranch_scc1 .Lhave_tile
.Lmark:
	// A1 identity marker: 0xA1000000 | (linear workgroup * waves + wave).
${UID}
	s_mul_i32 ${TMP}, ${TMP}, ${NUM_WAVES}
	s_add_co_i32 ${TMP}, ${TMP}, ${WAVE}
	s_or_b32 ${TMP}, ${TMP}, 0xa1000000
	s_mov_b32 m0, ${TMP}
	s_ttracedata
.Lhave_tile:
	s_mov_b32 ${R9}, ${T9}
	s_mov_b32 ${R7}, ${T7}
${PRELOAD}
	s_wait_alu 0x0
	s_branch 0
