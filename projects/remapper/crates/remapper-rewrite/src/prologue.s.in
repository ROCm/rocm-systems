// Binary workgroup remap prologue for gfx1250 (wave32). remap/prologue.rs fills the template fields and appends this code
// after the kernel; the kernel descriptor's entry points here and the last instruction branches to the original
// entry. Only user SGPRs, v0 and the ttmp registers are live at entry, so the prologue may use any other SGPR and
// v1..v5. It leaves the workgroup-id values for the body in ${R9} (replaces ttmp9) and ${R7} (replaces ttmp7).
//
// Control block (64 bytes). detr appends its address to the kernarg segment at ${CTL_KERNARG_OFFSET}, so the code bytes
// are the same in every replay process (statistical ATT requires identical instruction text across samples):
//   0 mode, 4 max_k, 8 arrival*, 16 table*, 24 counters* (overflow, log count), 32 log*
// Modes: 0 off, 1 record, 2 table, 3 mark natural, 4 mark table. No stealing: a turn without a table entry runs the
// hardware id and increments the overflow counter, which marks the run as invalid.
	.text
	.p2align 8
aegis_prologue:
	// The descriptor's INST_PREF_SIZE now covers only this prologue; these restore the original body prefetch.
${PREFETCH}
	s_load_b64 ${CTL}, ${KERNARG}, ${CTL_KERNARG_OFFSET}
	s_wait_kmcnt 0x0
	s_load_b64 ${MODE_MAXK}, ${CTL}, 0x0
	s_load_b256 ${PTRS}, ${CTL}, 0x8
	s_bfe_u32 ${WAVE}, ttmp8, 0x50019
	s_mov_b32 ${T9}, ttmp9
	s_mov_b32 ${T7}, ttmp7
	s_wait_kmcnt 0x0
	s_cmp_eq_u32 ${MODE}, 0
	s_cbranch_scc1 .Lhave_tile
	s_cmp_eq_u32 ${MODE}, 3
	s_cbranch_scc1 .Lmark
	s_cmp_lg_u32 ${WAVE}, 0
	s_cbranch_scc1 .Lsync
	// Wave 0: location = (SE*2 + SA)*16 + WGP.
	s_getreg_b32 ${HWID1}, hwreg(HW_REG_HW_ID1)
	s_sendmsg_rtn_b32 ${SEAID}, 0x87
	s_wait_kmcnt 0x0
	s_lshr_b32 ${LOC}, ${SEAID}, 16
	s_lshl_b32 ${LOC}, ${LOC}, 1
	s_and_b32 ${TMP}, ${SEAID}, 15
	s_add_co_i32 ${LOC}, ${LOC}, ${TMP}
	s_lshl_b32 ${LOC}, ${LOC}, 1
	s_bfe_u32 ${TMP}, ${HWID1}, 0x10010
	s_add_co_i32 ${LOC}, ${LOC}, ${TMP}
	s_lshl_b32 ${LOC}, ${LOC}, 4
	s_bfe_u32 ${TMP}, ${HWID1}, 0x4000a
	s_add_co_i32 ${LOC}, ${LOC}, ${TMP}${SIMD_KEY_LINES}
	s_mov_b32 ${SAVE_EXEC}, exec_lo
	s_mov_b32 exec_lo, 1
	// Turn: k = atomic_add(arrival[loc], 1).
	s_lshl_b32 ${TMP}, ${LOC}, 2
	v_mov_b32_e32 v1, ${TMP}
	v_mov_b32_e32 v2, 1
	s_wait_alu 0x0
	global_atomic_add_u32 v3, v1, v2, ${ARRIVAL} th:TH_ATOMIC_RETURN scope:SCOPE_DEV
	s_wait_loadcnt 0x0
	s_wait_xcnt 0x0
	v_readfirstlane_b32 ${K}, v3
	s_wait_alu 0x0
	s_cmp_eq_u32 ${MODE}, 1
	s_cbranch_scc1 .Llog
	// Table: entry = table[loc*max_k + k] = (ttmp9, ttmp7) of the recorded workgroup; ttmp9 == -1 is no entry.
	s_cmp_ge_u32 ${K}, ${MAXK}
	s_cbranch_scc1 .Loverflow
	s_mul_i32 ${TMP}, ${LOC}, ${MAXK}
	s_add_co_i32 ${TMP}, ${TMP}, ${K}
	s_lshl_b32 ${TMP}, ${TMP}, 3
	s_load_b64 ${ENTRY}, ${TABLE}, ${TMP} offset:0x0
	s_wait_kmcnt 0x0
	s_cmp_eq_u32 ${ENTRY_LO}, -1
	s_cbranch_scc1 .Loverflow
	s_mov_b32 ${T9}, ${ENTRY_LO}
	s_mov_b32 ${T7}, ${ENTRY_HI}
	s_branch .Lchosen
.Loverflow:
	v_mov_b32_e32 v1, 0
	v_mov_b32_e32 v2, 1
	s_wait_alu 0x0
	global_atomic_add_u32 v1, v2, ${COUNTERS} scope:SCOPE_DEV
.Lchosen:
	s_cmp_eq_u32 ${MODE}, 4
	s_cbranch_scc1 .Lpublish
.Llog:
	// Log record (8 dwords) at an index taken from counters[1]: loc, k, ttmp9 and ttmp7 used, HW_ID1, SE/AID,
	// hardware ttmp9 and ttmp7.
	v_mov_b32_e32 v1, 4
	v_mov_b32_e32 v2, 1
	s_wait_alu 0x0
	global_atomic_add_u32 v3, v1, v2, ${COUNTERS} th:TH_ATOMIC_RETURN scope:SCOPE_DEV
	s_wait_loadcnt 0x0
	s_wait_xcnt 0x0
	v_lshlrev_b32_e32 v1, 5, v3
	v_mov_b32_e32 v2, ${LOC}
	v_mov_b32_e32 v3, ${K}
	v_mov_b32_e32 v4, ${T9}
	v_mov_b32_e32 v5, ${T7}
	s_wait_alu 0x0
	global_store_b128 v1, v[2:5], ${LOG}
	s_wait_xcnt 0x0
	s_wait_alu 0x0
	v_mov_b32_e32 v2, ${HWID1}
	v_mov_b32_e32 v3, ${SEAID}
	v_mov_b32_e32 v4, ttmp9
	v_mov_b32_e32 v5, ttmp7
	s_wait_alu 0x0
	global_store_b128 v1, v[2:5], ${LOG} offset:16
	s_wait_xcnt 0x0
.Lpublish:
${PUBLISH}
	s_wait_storecnt 0x0
	s_mov_b32 exec_lo, ${SAVE_EXEC}
.Lsync:
${SYNC}
	s_cmp_lg_u32 ${MODE}, 4
	s_cbranch_scc1 .Lhave_tile
.Lmark:
	// A1 identity marker: 0xA1000000 | (linear workgroup * waves + wave).
${UID}
	s_mul_i32 ${TMP}, ${TMP}, ${NUM_WAVES}
	s_add_co_i32 ${TMP}, ${TMP}, ${WAVE}
	s_or_b32 ${TMP}, ${TMP}, 0xa1000000
	s_mov_b32 m0, ${TMP}
	s_ttracedata
.Lhave_tile:
	s_mov_b32 ${R9}, ${T9}
	s_mov_b32 ${R7}, ${T7}
${PRELOAD}
	s_wait_alu 0x0
	s_branch 0
