# Prefer the SDK compiler while respecting explicit compiler selections.
if(NOT ROCM_PATH)
  if(NOT "$ENV{ROCM_PATH}" STREQUAL "")
    set(ROCM_PATH "$ENV{ROCM_PATH}" CACHE PATH "ROCm SDK root")
  elseif(NOT "$ENV{HIP_PATH}" STREQUAL "")
    set(ROCM_PATH "$ENV{HIP_PATH}" CACHE PATH "ROCm SDK root")
  endif()
endif()
if(ROCM_PATH)
  file(TO_CMAKE_PATH "${ROCM_PATH}" ROCM_PATH)
  list(PREPEND CMAKE_PREFIX_PATH "${ROCM_PATH}")
endif()
if(NOT CMAKE_CXX_COMPILER AND "$ENV{CXX}" STREQUAL "")
  find_program(_rccl_tests_cxx NAMES clang++ amdclang++
    HINTS "${ROCM_PATH}/lib/llvm/bin" "${ROCM_PATH}/llvm/bin" "${ROCM_PATH}/bin")
  if(NOT _rccl_tests_cxx)
    message(FATAL_ERROR "Set ROCM_PATH/HIP_PATH or select the ROCm compiler with CMAKE_CXX_COMPILER or CXX.")
  endif()
  set(CMAKE_CXX_COMPILER "${_rccl_tests_cxx}" CACHE FILEPATH "ROCm C++ compiler")
endif()
