set(RCCL_ROOT "" CACHE PATH "RCCL installation or build directory")
if(NOT TARGET roc::rccl)
  if(RCCL_ROOT AND EXISTS "${RCCL_ROOT}/CMakeCache.txt")
    set(_rccl_root_only NO_DEFAULT_PATH)
  elseif(RCCL_ROOT)
    find_package(RCCL CONFIG QUIET PATHS "${RCCL_ROOT}" NO_DEFAULT_PATH)
    set(_rccl_root_only NO_DEFAULT_PATH)
  else()
    find_package(RCCL CONFIG QUIET HINTS "${ROCM_PATH}")
  endif()
endif()
if(NOT TARGET roc::rccl)
  # Native development builds may not yet provide an installed package config.
  find_path(RCCL_INCLUDE_DIR rccl/rccl.h HINTS "${RCCL_ROOT}/include" ${_rccl_root_only})
  find_path(RCCL_DEVICE_INCLUDE_DIR nccl_device.h
    HINTS "${RCCL_INCLUDE_DIR}" "${RCCL_ROOT}/hipify/src/include" ${_rccl_root_only})
  find_library(RCCL_LIBRARY NAMES rccl HINTS "${RCCL_ROOT}" "${RCCL_ROOT}/lib" ${_rccl_root_only})
  if(NOT RCCL_INCLUDE_DIR OR NOT RCCL_DEVICE_INCLUDE_DIR OR NOT RCCL_LIBRARY)
    message(FATAL_ERROR "Set RCCL_ROOT to an RCCL installation/build tree containing its library, rccl/rccl.h, and nccl_device.h; or provide the RCCL_* paths explicitly.")
  endif()
  if(WIN32)
    find_file(RCCL_RUNTIME_LIBRARY rccl.dll HINTS "${RCCL_ROOT}" "${RCCL_ROOT}/bin" ${_rccl_root_only})
    if(NOT RCCL_RUNTIME_LIBRARY)
      message(FATAL_ERROR "Set RCCL_RUNTIME_LIBRARY to the rccl.dll matching RCCL_LIBRARY.")
    endif()
    add_library(roc::rccl SHARED IMPORTED)
    set_target_properties(roc::rccl PROPERTIES IMPORTED_IMPLIB "${RCCL_LIBRARY}"
      IMPORTED_LOCATION "${RCCL_RUNTIME_LIBRARY}")
  else()
    if(RCCL_LIBRARY MATCHES "\\.a$")
      add_library(roc::rccl STATIC IMPORTED)
    else()
      add_library(roc::rccl SHARED IMPORTED)
    endif()
    set_target_properties(roc::rccl PROPERTIES IMPORTED_LOCATION "${RCCL_LIBRARY}")
  endif()
  set_target_properties(roc::rccl PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${RCCL_INCLUDE_DIR};${RCCL_DEVICE_INCLUDE_DIR}")
endif()
