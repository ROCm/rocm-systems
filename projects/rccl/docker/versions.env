# Shared-dependency versions for the multi-node RCCL container stack.
#
# This file is the SINGLE SOURCE OF TRUTH for the UCX and OpenMPI versions
# built into /opt/shared by `mnctl --setup-deps` and consumed at runtime
# by the entrypoint and post-setup scripts.
#
# Consumers:
#   * Python:   mnctl/versions.py parses this file and exposes the values
#               to mnctl/deps.py for the throwaway-container build scripts.
#   * Docker:   Dockerfile.ubuntu (legacy single-node image) keeps its
#               ARG defaults in sync with the values below.
#
# To bump a version, edit ONE line here and rebuild.  Do NOT duplicate
# version literals elsewhere in the tree.

UCX_VERSION=1.16.0
OMPI_VERSION=4.1.6
