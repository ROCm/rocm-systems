# ============================================================================
# Shared configuration for the NCCL M2N root Makefile and tests/Makefile.
# ============================================================================
#
# Both Makefiles include this file; it auto-detects its own absolute location
# so all paths (sources, headers, build dir) resolve from the project root
# regardless of where `make` was invoked.
#
# Optional env: NCCL_HOME, CUDA_HOME, MPI_HOME, NVCC_GENCODE, DEBUG, BUILDDIR.
# ============================================================================

# Project root = directory containing this Makefile.common.
NCCL_RESHARD_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
NCCL_EXTENSIONS_ROOT := $(abspath $(NCCL_RESHARD_ROOT)/..)
CXXSTD := -std=c++17
NVCC_GENCODE ?= -gencode=arch=compute_80,code=sm_80 \
                  -gencode=arch=compute_90,code=sm_90 \
                  -gencode=arch=compute_100,code=sm_100
include $(NCCL_RESHARD_ROOT)/../makefiles/common.mk

# If the caller hasn't set NCCL_HOME, default to the vendored NCCL
# submodule's build output. Callers pointing at their own from-source NCCL
# build should still set NCCL_HOME explicitly; this ?= will not override it.
NCCL_HOME ?= $(abspath $(NCCL_RESHARD_ROOT)/../third_party/nccl/build)

# ── Required dependency checks (skipped for `clean` / `help`) ──────────────
NO_DEPS_GOALS := clean help tests-clean
SKIP_DEP_CHECK := $(if $(MAKECMDGOALS),$(if $(filter-out $(NO_DEPS_GOALS),$(MAKECMDGOALS)),,1))

ifeq ($(SKIP_DEP_CHECK),)
ifeq ($(wildcard $(NCCL_HOME)/include/nccl_device.h),)
$(error NCCL_HOME=$(NCCL_HOME) does not contain include/nccl_device.h. Point NCCL_HOME to an NCCL build or installation that includes the Device API headers, or build the vendored NCCL with: make -C $(NCCL_EXTENSIONS_ROOT) nccl-submodule)
endif
ifeq ($(wildcard $(NVCC)),)
$(error NVCC not found at $(NVCC). Set CUDA_HOME correctly.)
endif
# NCCL_HOME may have only a versioned SONAME, not the libnccl.so that
# -lnccl needs. Resolve the real file so both layouts link.
NCCL_LIB_FILE := $(firstword $(wildcard $(NCCL_HOME)/lib/libnccl.so) \
                             $(wildcard $(NCCL_HOME)/lib64/libnccl.so) \
                             $(wildcard $(NCCL_HOME)/lib/libnccl.so.*) \
                             $(wildcard $(NCCL_HOME)/lib64/libnccl.so.*))
ifeq ($(NCCL_LIB_FILE),)
$(error NCCL_HOME=$(NCCL_HOME) does not contain libnccl.so or a versioned libnccl.so.<N> under lib/ or lib64/)
endif
endif

# ── MPI (benchmarks + MPI test only — library itself does not link MPI) ────
ifdef MPI_HOME
MPI_CFLAGS = -I$(MPI_HOME)/include
MPI_LDFLAGS = -L$(MPI_HOME)/lib -lmpi
else
MPI_CFLAGS =
MPI_LDFLAGS = -lmpi
endif

# ── Output directories (shared build/ at the repository root) ─────────────
BUILDDIR ?= $(NCCL_EXTENSIONS_ROOT)/build
LIBDIR := $(BUILDDIR)/lib
BINDIR := $(BUILDDIR)/bin
OBJDIR := $(BUILDDIR)/obj/nccl_m2n
INCDIR := $(BUILDDIR)/include
M2N_LIBNAME := libnccl_m2n.so
M2N_LIBTARGET := $(LIBDIR)/$(M2N_LIBNAME)
M2N_HEADER_TARGET := $(INCDIR)/nccl_m2n.h

SRCDIR := $(NCCL_RESHARD_ROOT)/src
BENCHDIR := $(NCCL_RESHARD_ROOT)/benchmarks
TESTSDIR := $(NCCL_RESHARD_ROOT)/tests

# ── Compiler flags ─────────────────────────────────────────────────────────
INCLUDES := -isystem $(NCCL_HOME)/include \
            -isystem $(NCCL_HOME)/include/nccl_device \
            -isystem $(CUDA_HOME)/include \
            -I$(SRCDIR) \
            -isystem $(NCCL_RESHARD_ROOT)/third_party

NVCUFLAGS := -ccbin $(CXX) \
             $(CXXSTD) \
             --expt-extended-lambda \
             --expt-relaxed-constexpr \
             -Xcompiler -fPIC \
             -Xcompiler -Wall \
             -DNCCL_OS_LINUX \
             $(INCLUDES)

# Test-only instrumentation. Off by default, so a normal build carries none of
# it. The CMake test targets set the same macro; this is the Make equivalent,
# and it must reach the library too -- the instrumentation lives there, and the
# Make tests link the library rather than compiling its sources.
ifdef NCCL_M2N_TESTING
NVCUFLAGS += -DNCCL_M2N_TESTING
endif

ifdef NCCL_M2N_PIPE_SYNC_TIMEOUT_DEBUG
NVCUFLAGS += -DSTAGING_PIPE_SYNC_TIMEOUT_DEBUG
endif

NVCUFLAGS += $(NVCC_GENCODE)

NVCUFLAGS += -O3
NVCUFLAGS += --ptxas-options=-v

ifeq ($(DEBUG),full)
    NVCUFLAGS += -G -g -O0
    $(info [DEBUG] Full device debugging enabled (-G -g))
else ifeq ($(DEBUG),1)
    NVCUFLAGS += -lineinfo -g
    $(info [DEBUG] Line info enabled (-lineinfo -g))
endif

# ── Linker flags ───────────────────────────────────────────────────────────
# Link NCCL_LIB_FILE by path rather than -lnccl (needs an unversioned .so
# we may not have). -Xlinker skips nvcc's own file-type sniffing, which
# rejects a versioned libnccl.so.<N> outright.
LIB_LDFLAGS := -Xlinker $(NCCL_LIB_FILE) \
               $(CUDA_DRIVER_LDFLAGS) -lcuda
M2N_LIB_LDFLAGS := -cudart=static $(LIB_LDFLAGS) -Xlinker -rpath -Xlinker '$$ORIGIN'

# Benchmarks and tests link against libnccl_m2n.so + MPI (for bootstrap).
# rpath '$ORIGIN/../lib' lets the binary find the .so relative to its own
# location (build/bin → build/lib), so callers don't need to set
# LD_LIBRARY_PATH for in-tree runs.  Notes:
#   - We use `-Xlinker -rpath -Xlinker <path>` (not `-Xcompiler -Wl,…`)
#     because nvcc rewrites comma-separated `-Wl,…` arguments and ends up
#     dropping the `-Wl,` prefix on the second comma-separated piece, which
#     g++ then sees as a bare `-Wl` flag and rejects.
#   - $$  escapes Make → shell ($$ → $)
#   - '…' protects $ORIGIN from shell expansion so it reaches the linker
M2N_CLIENT_LDFLAGS := -L$(LIBDIR) -lnccl_m2n \
                       -Xlinker -rpath -Xlinker '$$ORIGIN/../lib'
BENCH_LDFLAGS := $(LIB_LDFLAGS) $(MPI_LDFLAGS)

# ── Library sources / headers (modular) ────────────────────────────────────
# Library sources split by translation-unit kind:
#   LIB_CC_SRCS — host-only C++ TUs. Forwarded to the host compiler by nvcc
#                 (extension-driven), skipping the device pipeline. No
#                 __global__/__device__ code, no kernel launches.
#   LIB_CU_SRCS — CUDA TUs. Contain device code (kernels, launches) and
#                 require the full nvcc compilation pipeline.
LIB_CC_SRCS := $(SRCDIR)/m2n_config.cc \
               $(SRCDIR)/m2n_group.cc \
               $(SRCDIR)/reshard_call_setup.cc \
               $(SRCDIR)/reshard_cache.cc \
               $(SRCDIR)/reshard_mesh.cc \
               $(SRCDIR)/reshard_loadbalance.cc \
               $(SRCDIR)/reshard_prepare.cc \
               $(SRCDIR)/reshard_split_prepare.cc \
               $(SRCDIR)/pack_staging.cc \
               $(SRCDIR)/m2n_init.cc \
               $(SRCDIR)/staging_buffer.cc \
               $(SRCDIR)/staging_profile.cc \
               $(SRCDIR)/staging_prepare.cc

LIB_CU_SRCS := $(SRCDIR)/reshard_user_window.cu \
               $(SRCDIR)/reshard_split_comm.cu \
               $(SRCDIR)/reshard_split_user_window.cu \
               $(SRCDIR)/reshard_staging.cu \
               $(SRCDIR)/staging_kernel.cu

LIB_SRCS := $(LIB_CC_SRCS) $(LIB_CU_SRCS)

LIB_HDRS := $(SRCDIR)/nccl_m2n.h \
            $(SRCDIR)/reshard_types.h \
            $(SRCDIR)/reshard_limits.h \
            $(SRCDIR)/reshard_split.h \
            $(SRCDIR)/reshard_pipe_resources.h \
            $(SRCDIR)/m2n_checks.h \
            $(SRCDIR)/m2n_env_parse.h \
            $(SRCDIR)/m2n_checked_math.h \
            $(SRCDIR)/m2n_handle.h \
            $(SRCDIR)/m2n_log.h \
            $(SRCDIR)/reshard_call_setup.h \
            $(SRCDIR)/staging_buffer.h \
            $(SRCDIR)/staging_primitives.cuh \
            $(SRCDIR)/staging_types.h \
            $(SRCDIR)/reshard_internal.h \
            $(SRCDIR)/reshard_kernels.cuh
