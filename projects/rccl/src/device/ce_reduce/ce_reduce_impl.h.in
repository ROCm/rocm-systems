
// CE AllReduce local-reduction kernel -- persistent, pipelined, vectorized 16B
// load/store edition.
//
// Auto-generated by src/device/ce_reduce/generate.py. Shared by every
// ce_reduce_<type>_<redop>.cpp instantiation TU under gensrc/ce_reduce/.
// Do not edit by hand -- edit this file (generate.py copies it verbatim,
// prepending only the copyright header).
#pragma once

#include <hip/hip_runtime.h>
#include <hip/hip_fp16.h>
#include <hip/hip_bfloat16.h>
#include <hip/hip_cooperative_groups.h>
#include <stdint.h>
#include <algorithm>

// Kept in sync with src/include/ce_coll.h, which the host side (ce_coll.cc)
// uses to size the signal buffer and slot strides. The guards let a build
// override both consistently from the command line.
#ifndef NCCL_CE_REDUCE_MAX_BLOCKS
#define NCCL_CE_REDUCE_MAX_BLOCKS 46
#endif

#ifndef NCCL_CE_NUM_SLOTS
#define NCCL_CE_NUM_SLOTS 2
#endif

namespace cg = cooperative_groups;

// Global atomic-counter barrier for regular launch (avoids CTA scheduling deadlock).
__device__ __forceinline__ void ncclCeGlobalBlockBarrier(uint32_t* d_barrierSync, int numBlocks, uint32_t gen) {
  if (numBlocks <= 1) {
    __syncthreads();
    return;
  }
  uint32_t* arrival = d_barrierSync + 0;
  uint32_t* doneGen = d_barrierSync + 1;
  __syncthreads();
  if (threadIdx.x == 0) {
    uint32_t prev = __hip_atomic_fetch_add(arrival, 1, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
    if (prev + 1 == (uint32_t)numBlocks) {
      __hip_atomic_store(arrival, 0, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
      __hip_atomic_store(doneGen, gen, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
    } else {
      while (__hip_atomic_load(doneGen, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) != gen) {
        __builtin_amdgcn_s_sleep(1);
      }
    }
  }
  __syncthreads();
}

// One barrier generation: thread 0 bumps s_gen, all threads enter the barrier with s_val.
__device__ __forceinline__ void ncclCeBlockBarrier(int blockId, uint64_t* s_gen, uint32_t* d_barrierSync) {
  __shared__ uint64_t s_val;
  __syncthreads();
  if (threadIdx.x == 0) { 
    s_val = (*s_gen)++;
  }
  __syncthreads();
  ncclCeGlobalBlockBarrier(d_barrierSync, gridDim.x, (uint32_t)s_val);
}

// *********************************************************************************
// VecTrait<T>
//   LoadT     : 16-byte HIP vector used for a single memory transaction
//   W         : number of T elements packed into one 16-byte load/store
//   GpuUnroll : compile-time unroll factor (U) to balance ILP vs VGPRs
// *********************************************************************************
template <typename T>
struct VecTrait {
  using LoadT = uint4;
  static constexpr int W = (int)(16 / sizeof(T));
  static constexpr int GpuUnroll = 4;
};

template <>
struct VecTrait<float> {
  using LoadT = float4;
  static constexpr int W = 4;
  static constexpr int GpuUnroll = 4;
};
template <>
struct VecTrait<int32_t> {
  using LoadT = int4;
  static constexpr int W = 4;
  static constexpr int GpuUnroll = 4;
};
template <>
struct VecTrait<uint32_t> {
  using LoadT = uint4;
  static constexpr int W = 4;
  static constexpr int GpuUnroll = 4;
};

template <>
struct VecTrait<double> {
  using LoadT = double2;
  static constexpr int W = 2;
  static constexpr int GpuUnroll = 2;
};
template <>
struct VecTrait<int64_t> {
  using LoadT = longlong2;
  static constexpr int W = 2;
  static constexpr int GpuUnroll = 2;
};
template <>
struct VecTrait<uint64_t> {
  using LoadT = ulonglong2;
  static constexpr int W = 2;
  static constexpr int GpuUnroll = 2;
};

template <>
struct VecTrait<__half> {
  using LoadT = uint4;
  static constexpr int W = 8;
  static constexpr int GpuUnroll = 4;
};
template <>
struct VecTrait<hip_bfloat16> {
  using LoadT = uint4;
  static constexpr int W = 8;
  static constexpr int GpuUnroll = 4;
};

template <>
struct VecTrait<int8_t> {
  using LoadT = uint4;
  static constexpr int W = 16;
  static constexpr int GpuUnroll = 4;
};
template <>
struct VecTrait<uint8_t> {
  using LoadT = uint4;
  static constexpr int W = 16;
  static constexpr int GpuUnroll = 4;
};

// *********************************************************************************
// ncclCeLocalReduceBlocksT<T> -- launch block count for the reduce kernel.
// Single source of the geometry: 1-D grid over the vectorized element space,
// clamped to [1, NCCL_CE_REDUCE_MAX_BLOCKS] for CE DMA headroom. Redop-independent
// (depends only on the per-type VecTrait W/GpuUnroll). Used by both the generated
// launcher and the host-side reporting wrapper so live dispatch and reporting
// never drift.
// *********************************************************************************
template <typename T>
static inline int ncclCeLocalReduceBlocksT(size_t chunkElems) {
  constexpr int threads = 256;
  constexpr int UnrollFactor = VecTrait<T>::GpuUnroll;
  return (int)std::clamp<size_t>((chunkElems / VecTrait<T>::W + (size_t)threads * UnrollFactor - 1) /
                                   ((size_t)threads * UnrollFactor),
                                 (size_t)1, (size_t)NCCL_CE_REDUCE_MAX_BLOCKS);
}

// *********************************************************************************
// ReduceOp<T, RedOp> -- compile-time reduction functor
// 0=Sum  1=Prod  2=Min  3=Max
// *********************************************************************************
template <typename T, int RedOp>
struct ReduceOp;
template <typename T>
struct ReduceOp<T, 0> {
  __device__ __forceinline__ static T apply(T a, T b) {
    return a + b;
  }
};
template <typename T>
struct ReduceOp<T, 1> {
  __device__ __forceinline__ static T apply(T a, T b) {
    return a * b;
  }
};
template <typename T>
struct ReduceOp<T, 2> {
  __device__ __forceinline__ static T apply(T a, T b) {
    return a < b ? a : b;
  }
};
template <typename T>
struct ReduceOp<T, 3> {
  __device__ __forceinline__ static T apply(T a, T b) {
    return a > b ? a : b;
  }
};

// *********************************************************************************
// ncclCeLocalReduceKernelVec<T, RedOp, U>
//
// scatterBuf layout after CE scatter phase:
//   in[slot * slotChunkElems * nRanks + r * slotChunkElems + i] = element i from rank r
//
// NOTE on the rank loops below: nRanks is a runtime value, so LLVM's runtime
// unroller will happily unroll them by up to 64x on top of the manual
// unroll/vectorization already expressed here, producing hundreds of PHI
// nodes and shufflevector ops per kernel. That dominated llc codegen time
// (int8_t/uint8_t Min/Max were the worst offenders) and was also a large
// runtime regression for int32_t/uint32_t Sum/Prod, so the unroller is
// disabled on every rank loop.
//
// The loop vectorizer is a separate decision: disabling it alongside the
// unroller helps most kernels but hurts a few, so generate.py defines
// CE_REDUCE_VECTORIZE_OK per (type, redop) for the ones measured faster with
// it left on. See the VECTORIZE_OK table there.
//
// The innermost loops over W are deliberately left bare: W is a small
// compile-time constant, and pragmas there regress runtime performance.
// *********************************************************************************
template <typename T, int RedOp, int U>
__global__ __launch_bounds__(256) void ncclCeLocalReduceKernelVec(
  const T* __restrict__ in,
  T* __restrict__ out, // recvbuff + rank*shardBytes (final AllReduce shard region)
  int nRanks, size_t baseChunkElems, size_t tailChunkElems, size_t chunksPerShard, size_t slotChunkElems,
  volatile uint32_t* signalBuffer, size_t totalSteps, uint32_t* d_barrierSync, bool coopLaunch) {
  if (blockIdx.x >= NCCL_CE_REDUCE_MAX_BLOCKS) { 
    return;
  }
  __shared__ uint64_t s_gen;
  if (!coopLaunch) {
    if (threadIdx.x == 0) {
      s_gen = 1;
    }
    __syncthreads();
  }

  using LT = typename VecTrait<T>::LoadT;
  constexpr int W = VecTrait<T>::W;
  union alignas(16) Pack {
    LT vec;
    T v[W];
  };

  const size_t tid = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
  const size_t stride = (size_t)blockDim.x * gridDim.x;
  uint32_t step = 0;

  while (step < totalSteps) {
    const int slot = (int)(step % NCCL_CE_NUM_SLOTS);
    const size_t chunkInShard = step % chunksPerShard;

    const bool isTailChunk = (chunkInShard == chunksPerShard - 1) && (tailChunkElems > 0);
    const size_t currentChunkElems = isTailChunk ? tailChunkElems : baseChunkElems;
    const size_t nVec = currentChunkElems / W;
    if (totalSteps > 1) {
      if (blockIdx.x == 0 && threadIdx.x == 0) {
        while (true) {
          int ready = 0;
          for (int r = 0; r < nRanks; r++) {
            uint32_t sv = __hip_atomic_load((uint32_t*)&signalBuffer[(size_t)slot * nRanks + r], __ATOMIC_ACQUIRE,
                                            __HIP_MEMORY_SCOPE_SYSTEM);
            if (sv == 1) {
              ready++;
            }
          }
          if (ready == nRanks) {
            break;
          }
          __builtin_amdgcn_s_sleep(1);
        }
      }
      if (!coopLaunch) {
        ncclCeBlockBarrier(blockIdx.x, &s_gen, d_barrierSync);
      } else {
        cg::this_grid().sync();
      }
    }
    const size_t slotStrideElems = slotChunkElems * (size_t)nRanks;
    const T* __restrict__ slotIn = in + ((size_t)slot * slotStrideElems);
    T* __restrict__ chunkOut = out + ((size_t)chunkInShard * baseChunkElems);

    size_t vi = tid;
    for (; vi + (U - 1) * stride < nVec; vi += stride * U) {
      Pack acc[U];
#pragma unroll
      for (int i = 0; i < U; i++) {
        size_t elementOffset = (vi + (size_t)i * stride) * W;
        acc[i].vec = *reinterpret_cast<const LT*>(slotIn + elementOffset);
      }
#ifdef CE_REDUCE_VECTORIZE_OK
#pragma clang loop unroll(disable)
#else
#pragma clang loop unroll(disable) vectorize(disable)
#endif
      for (int r = 1; r < nRanks; r++) {
        Pack tmp[U];
#pragma unroll
        for (int i = 0; i < U; i++) {
          size_t rankOffset = (size_t)r * slotChunkElems + (vi + (size_t)i * stride) * W;
          tmp[i].vec = *reinterpret_cast<const LT*>(slotIn + rankOffset);
        }
#pragma unroll
        for (int i = 0; i < U; i++) {
          // Intentionally no unroll/vectorize pragma:
          // W is small and a compile-time constant, and any
          // pragma here regresses runtime performance.
          for (int k = 0; k < W; k++) {
            acc[i].v[k] = ReduceOp<T, RedOp>::apply(acc[i].v[k], tmp[i].v[k]);
          }
        }
      }
#pragma unroll
      for (int i = 0; i < U; i++) {
        size_t outOffset = (vi + (size_t)i * stride) * W;
        *reinterpret_cast<LT*>(chunkOut + outOffset) = acc[i].vec;
      }
    }
    // Drain remaining vectorized elements (one vector per thread per step).
    // Intentionally no unroll pragma on this outer loop -- see #9797 note
    // above the kernel; same as the strided-unroll loop's own outer loop.
    size_t vectorTailStart = nVec - (nVec % (stride * U));
    if (nVec > 0 && nVec % (stride * U) != 0) {
      for (size_t vIdx = vectorTailStart + tid; vIdx < nVec; vIdx += stride) {
        Pack acc;
        acc.vec = *reinterpret_cast<const LT*>(slotIn + vIdx * W);
#ifdef CE_REDUCE_VECTORIZE_OK
#pragma clang loop unroll(disable)
#else
#pragma clang loop unroll(disable) vectorize(disable)
#endif
        for (int r = 1; r < nRanks; r++) {
          Pack tmp;
          size_t rankOffset = (size_t)r * slotChunkElems + vIdx * W;
          tmp.vec = *reinterpret_cast<const LT*>(slotIn + rankOffset);
          // no pragma here, same rationale as the twin loop in the strided-unroll section above.
          for (int k = 0; k < W; k++) {
            acc.v[k] = ReduceOp<T, RedOp>::apply(acc.v[k], tmp.v[k]);
          }
        }
        *reinterpret_cast<LT*>(chunkOut + vIdx * W) = acc.vec;
      }
    }

    const size_t tailBase = nVec * W;
    if (tailBase < currentChunkElems) {
      for (size_t i = tid; tailBase + i < currentChunkElems; i += stride) {
        size_t globalIdx = tailBase + i;
        T a = slotIn[globalIdx];
        // No pragma here, unneeded
        for (int r = 1; r < nRanks; r++) {
          T v = slotIn[(size_t)r * slotChunkElems + globalIdx];
          a = ReduceOp<T, RedOp>::apply(a, v);
        }
        chunkOut[globalIdx] = a;
      }
    }
    if (totalSteps > 1) {
      if (!coopLaunch) {
        ncclCeBlockBarrier(blockIdx.x, &s_gen, d_barrierSync);
      } else {
        cg::this_grid().sync();
      }
      if (blockIdx.x == 0) {
        for (int r = (int)threadIdx.x; r < nRanks; r += (int)blockDim.x) {
          __hip_atomic_store((uint32_t*)&signalBuffer[(size_t)slot * nRanks + r], 0, __ATOMIC_RELEASE,
                             __HIP_MEMORY_SCOPE_SYSTEM);
        }
      }
    }
    step++;
  }
}
