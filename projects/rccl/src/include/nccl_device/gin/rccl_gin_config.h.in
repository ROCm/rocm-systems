/*
 * rccl-owned, build-time GIN backend availability config. Generated by
 * configure_file from projects/rccl/src/CMakeLists.txt and installed with the
 * rest of the nccl_device/ header tree, so every consumer (rccl-tests, external
 * apps) reads THIS build's answer -- not a header-presence guess.
 *
 * gin_device_common.h uses these to seed NCCL_GIN_{ROCSHMEM_GDA,ANVIL_SDMA}_ENABLE.
 * Unlike an __has_include probe, a concrete #define cannot be flipped on by a
 * stray backend header on the include path (e.g. an unrelated /opt/rocm rccl).
 *
 * Both backends are gated by ENABLE_ROCSHMEM_GIN: a non-GIN librccl ships this
 * header with 0, a GIN librccl with 1.
 */

#ifndef RCCL_GIN_CONFIG_H_
#define RCCL_GIN_CONFIG_H_

#cmakedefine01 NCCL_GIN_ROCSHMEM_GDA_AVAILABLE
#cmakedefine01 NCCL_GIN_ANVIL_SDMA_AVAILABLE

#endif  // RCCL_GIN_CONFIG_H_
