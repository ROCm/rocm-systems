# Usage: cmake -DINPUT=<file.ll> -DREQUIRED=<comma-separated names> -P verify_exports.cmake
# Every entry of @llvm.used (i.e. every NCCL_IR_EXPORT thunk) must be defined,
# not just declared, with external linkage, and each REQUIRED name must be one.
if(NOT DEFINED INPUT)
  message(FATAL_ERROR "INPUT is required")
endif()
file(READ "${INPUT}" _ir)
string(REGEX MATCH "@llvm\\.used = [^\n]*" _used_line "${_ir}")
if(NOT _used_line)
  message(FATAL_ERROR "No @llvm.used in ${INPUT}: no thunk was exported (missing NCCL_IR_EXPORT 'used'?)")
endif()
string(REGEX MATCHALL "@[A-Za-z0-9_.$]+" _refs "${_used_line}")
list(REMOVE_ITEM _refs "@llvm.used")
set(_exports)
foreach(_ref ${_refs})
  string(SUBSTRING "${_ref}" 1 -1 _sym)
  list(APPEND _exports "${_sym}")
  string(REGEX MATCH "define[^\n]*@${_sym}\\(" _def "${_ir}")
  if(NOT _def)
    message(FATAL_ERROR "RCCL device bitcode does not define exported symbol ${_sym}: ${INPUT}")
  endif()
  if(_def MATCHES "(internal|private) ")
    message(FATAL_ERROR "RCCL device bitcode symbol ${_sym} lost external linkage: ${_def}")
  endif()
endforeach()
string(REPLACE "," ";" _required "${REQUIRED}")
foreach(_sym ${_required})
  list(FIND _exports "${_sym}" _idx)
  if(_idx EQUAL -1)
    message(FATAL_ERROR "Required export ${_sym} is not in @llvm.used: ${INPUT}")
  endif()
endforeach()
list(LENGTH _exports _n)
message(STATUS "verified ${_n} exported symbols")
