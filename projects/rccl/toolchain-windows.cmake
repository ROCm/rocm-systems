# Native Windows ROCm compiler discovery. Explicit compiler selections win.
if(NOT ROCM_PATH)
  if(DEFINED ENV{ROCM_PATH} AND NOT "$ENV{ROCM_PATH}" STREQUAL "")
    set(ROCM_PATH "$ENV{ROCM_PATH}")
  elseif(DEFINED ENV{HIP_PATH} AND NOT "$ENV{HIP_PATH}" STREQUAL "")
    set(ROCM_PATH "$ENV{HIP_PATH}")
  endif()
endif()
if(ROCM_PATH)
  file(TO_CMAKE_PATH "${ROCM_PATH}" ROCM_PATH)
  set(ROCM_PATH "${ROCM_PATH}" CACHE PATH "ROCm SDK root")
  list(PREPEND CMAKE_PREFIX_PATH "${ROCM_PATH}")
endif()
set(_rccl_compiler_hints "${ROCM_PATH}/lib/llvm/bin" "${ROCM_PATH}/llvm/bin"
  "${ROCM_PATH}/bin" "${ROCM_PATH}/../lc/bin")
if(NOT CMAKE_CXX_COMPILER AND (NOT DEFINED ENV{CXX} OR "$ENV{CXX}" STREQUAL ""))
  # Prefer the real Clang driver. The amdclang launcher in some Windows SDKs
  # rejects the 8.3 executable name CMake uses for paths containing spaces.
  find_program(_rccl_cxx NAMES clang++ amdclang++ HINTS ${_rccl_compiler_hints})
  if(NOT _rccl_cxx)
    message(FATAL_ERROR "Cannot find a ROCm C++ compiler. Set ROCM_PATH/HIP_PATH or CMAKE_CXX_COMPILER (or CXX) to the desired compiler.")
  endif()
  set(CMAKE_CXX_COMPILER "${_rccl_cxx}" CACHE FILEPATH "AMD C++ compiler")
endif()
if(NOT CMAKE_C_COMPILER AND (NOT DEFINED ENV{CC} OR "$ENV{CC}" STREQUAL ""))
  find_program(_rccl_cc NAMES clang amdclang HINTS ${_rccl_compiler_hints})
  if(_rccl_cc)
    set(CMAKE_C_COMPILER "${_rccl_cc}" CACHE FILEPATH "AMD C compiler")
  endif()
endif()
