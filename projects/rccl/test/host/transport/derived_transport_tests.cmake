# Compiles a base transport's host tests and fakes against a derived transport (a renamed copy of one or more
# bases), through a generated alias header and header shims per base, under the binary dir's derived_transport/.
include_guard(GLOBAL)

# Rewrite a generated file only when its content changes, so a reconfigure does not rebuild what includes it.
function(_rccl_derived_write _path _content)
  if(EXISTS "${_path}")
    file(READ "${_path}" _old)
    if(_old STREQUAL _content)
      return()
    endif()
  endif()
  file(WRITE "${_path}" "${_content}")
endfunction()

# names.h: every "<base name> <derived name>" rename map entry except those a SEAM_DIR/*.cc unit aliases back, which
# the base test defines inside its seam window; KEEP_ALIASES names stay because the test also uses them outside it.
function(_rccl_derived_gen_names _out _map _seam_dir _keep)
  file(GLOB _seams CONFIGURE_DEPENDS "${_seam_dir}/*.cc")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_map}" ${_seams})
  file(STRINGS "${_map}" _entries REGEX "^[^#]")
  file(RELATIVE_PATH _rel "${CMAKE_CURRENT_SOURCE_DIR}" "${_map}")
  set(_pairs)
  foreach(_entry ${_entries})
    if(NOT _entry MATCHES "^([A-Za-z_][A-Za-z_0-9]*)[ \t]+([A-Za-z_][A-Za-z_0-9]*)[ \t]*$")
      if(_entry MATCHES "[^ \t]")
        message(FATAL_ERROR "${_rel}: malformed entry '${_entry}'")
      endif()
      continue()
    endif()
    list(APPEND _pairs "${CMAKE_MATCH_1} ${CMAKE_MATCH_2}")
  endforeach()
  # A seam alias that names a map entry on either side must be that entry reversed; others alias test hooks.
  set(_window)
  foreach(_seam ${_seams})
    file(STRINGS "${_seam}" _defs REGEX "^#define [A-Za-z_0-9]+ [A-Za-z_0-9]+$")
    foreach(_def ${_defs})
      string(REGEX REPLACE "^#define ([A-Za-z_0-9]+) ([A-Za-z_0-9]+)$" "\\1;\\2" _def "${_def}")
      list(GET _def 0 _derived_name)
      list(GET _def 1 _base_name)
      foreach(_pair ${_pairs})
        if(_pair MATCHES "^${_base_name} " OR _pair MATCHES " ${_derived_name}$")
          if(NOT _pair STREQUAL "${_base_name} ${_derived_name}")
            message(FATAL_ERROR "${_seam}: '#define ${_derived_name} ${_base_name}' does not reverse ${_rel} entry '${_pair}'")
          endif()
        endif()
      endforeach()
      list(APPEND _window ${_base_name})
    endforeach()
  endforeach()
  if(_keep)
    list(REMOVE_ITEM _window ${_keep})
  endif()
  set(_h "// Generated by test/host/transport/derived_transport_tests.cmake from ${_rel}.\n#pragma once\n")
  foreach(_pair ${_pairs})
    string(REPLACE " " ";" _pair "${_pair}")
    list(GET _pair 0 _base_name)
    list(GET _pair 1 _derived_name)
    if(NOT _base_name IN_LIST _window)
      string(APPEND _h "#define ${_base_name} ${_derived_name}\n")
    endif()
  endforeach()
  _rccl_derived_write("${_out}" "${_h}")
endfunction()

# shim/: <base>/<x><base suffix>.h and transport/<base>/<x><base suffix>.h include the derived <x><HEADER_SUFFIX>.h.
function(_rccl_derived_gen_shims _dir _derived _suffix _base _base_suffix)
  file(GLOB _headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/../../src/transport/${_derived}/*${_suffix}.h")
  set(_want)
  foreach(_hdr ${_headers})
    get_filename_component(_derived_hdr "${_hdr}" NAME)
    string(REGEX REPLACE "${_suffix}\\.h$" "${_base_suffix}.h" _base_hdr "${_derived_hdr}")
    foreach(_inc ${_base} transport/${_base})
      set(_path "${_dir}/${_inc}/${_base_hdr}")
      list(APPEND _want "${_path}")
      set(_shim "// Generated by test/host/transport/derived_transport_tests.cmake.\n")
      string(APPEND _shim "#include \"transport/${_derived}/${_derived_hdr}\"\n")
      _rccl_derived_write("${_path}" "${_shim}")
    endforeach()
  endforeach()
  file(GLOB_RECURSE _have "${_dir}/*.h")
  foreach(_path ${_have})
    if(NOT _path IN_LIST _want)
      file(REMOVE "${_path}")
    endif()
  endforeach()
endfunction()

# Declares a derived transport and generates names.h and shim/ for each base; one block per base:
# BASE <base> RENAME_MAP <file> SEAM_DIR <dir> [BASE_HEADER_SUFFIX <suffix>] [KEEP_ALIASES <name>...].
function(rccl_derived_transport_tests)
  cmake_parse_arguments(_rdt "" "DERIVED;HEADER_SUFFIX;SELF_CHECK_SUITE" "" ${ARGN})
  if(NOT _rdt_DERIVED OR NOT _rdt_HEADER_SUFFIX OR NOT _rdt_SELF_CHECK_SUITE)
    message(FATAL_ERROR "rccl_derived_transport_tests: needs DERIVED, HEADER_SUFFIX and SELF_CHECK_SUITE")
  endif()
  set(_gen "${CMAKE_CURRENT_BINARY_DIR}/derived_transport/${_rdt_DERIVED}")
  set_property(GLOBAL PROPERTY RCCL_DERIVED_${_rdt_DERIVED}_GEN "${_gen}")
  set_property(GLOBAL PROPERTY RCCL_DERIVED_${_rdt_DERIVED}_SUITE "${_rdt_SELF_CHECK_SUITE}")
  # Split the rest into one argument list per BASE block.
  set(_blocks)
  set(_block)
  foreach(_arg ${_rdt_UNPARSED_ARGUMENTS})
    if(_arg STREQUAL "BASE" AND _block)
      list(APPEND _blocks "${_block}")
      set(_block)
    endif()
    string(APPEND _block "${_arg},")
  endforeach()
  if(NOT _block)
    message(FATAL_ERROR "rccl_derived_transport_tests(${_rdt_DERIVED}): needs at least one BASE block")
  endif()
  list(APPEND _blocks "${_block}")
  set(_bases)
  foreach(_b ${_blocks})
    string(REPLACE "," ";" _b "${_b}")
    cmake_parse_arguments(_rdb "" "BASE;RENAME_MAP;SEAM_DIR;BASE_HEADER_SUFFIX" "KEEP_ALIASES" ${_b})
    if(NOT _rdb_BASE OR NOT _rdb_RENAME_MAP OR NOT _rdb_SEAM_DIR OR _rdb_UNPARSED_ARGUMENTS)
      message(FATAL_ERROR "rccl_derived_transport_tests(${_rdt_DERIVED}): bad BASE block '${_b}'")
    endif()
    list(APPEND _bases ${_rdb_BASE})
    _rccl_derived_gen_names("${_gen}/${_rdb_BASE}/names.h" "${_rdb_RENAME_MAP}" "${_rdb_SEAM_DIR}"
      "${_rdb_KEEP_ALIASES}")
    _rccl_derived_gen_shims("${_gen}/${_rdb_BASE}/shim" ${_rdt_DERIVED} ${_rdt_HEADER_SUFFIX} ${_rdb_BASE}
      "${_rdb_BASE_HEADER_SUFFIX}")
  endforeach()
  set_property(GLOBAL PROPERTY RCCL_DERIVED_${_rdt_DERIVED}_BASES "${_bases}")
endfunction()

# Writes the binary's exclusion lists for derived_transport_tests.h.
function(_rccl_derived_gen_lists _dir _name _exclude _enable)
  set(_gen "// Generated by test/host/transport/derived_transport_tests.cmake for ${_name}.\n")
  set(_excluded "${_gen}")
  set(_enabled "${_gen}")
  list(LENGTH _exclude _len)
  math(EXPR _odd "${_len} % 2")
  if(_odd)
    message(FATAL_ERROR "${_name}: EXCLUDE_BASE_TESTS takes <Suite.Name> <replaced|lagging|diverged> pairs")
  endif()
  while(_exclude)
    list(GET _exclude 0 _test)
    list(GET _exclude 1 _tag)
    list(REMOVE_AT _exclude 0 1)
    if(NOT _test MATCHES "^([A-Za-z_0-9]+)\\.([A-Za-z_0-9]+)$" OR NOT _tag MATCHES "^(replaced|lagging|diverged)$")
      message(FATAL_ERROR
        "${_name}: EXCLUDE_BASE_TESTS entry '${_test} ${_tag}' is not <Suite.Name> <replaced|lagging|diverged>")
    endif()
    string(REGEX MATCH "^([A-Za-z_0-9]+)\\.([A-Za-z_0-9]+)$" _m "${_test}")
    string(APPEND _excluded "RCCL_DERIVED_EXCLUDED_TEST(\"${CMAKE_MATCH_1}\", \"${CMAKE_MATCH_2}\", ${_tag})\n")
  endwhile()
  foreach(_test ${_enable})
    if(NOT _test MATCHES "^([A-Za-z_0-9]+)\\.DISABLED_([A-Za-z_0-9]+)$")
      message(FATAL_ERROR "${_name}: ENABLE_BASE_TESTS entry '${_test}' is not <Suite.DISABLED_Name>")
    endif()
    string(APPEND _enabled "RCCL_DERIVED_ENABLED_TEST(\"${CMAKE_MATCH_1}\", \"${CMAKE_MATCH_2}\")\n")
  endforeach()
  _rccl_derived_write("${_dir}/derived_tests_excluded.inc" "${_excluded}")
  _rccl_derived_write("${_dir}/derived_tests_enabled.inc" "${_enabled}")
endfunction()

# EXCLUDE_BASE_TESTS <Suite.Name> replaced (the derived file has a same-named test), lagging (a base change not yet
# taken) or diverged (the derived code differs by design; the reason names the derived test that covers it). When a
# base change breaks a derived test, add it as lagging with a reason; the derived owner ports it.
macro(rccl_add_derived_transport_binary _name _test)
  cmake_parse_arguments(_rdtb "" "DERIVED;BASE" "EXCLUDE_BASE_TESTS;ENABLE_BASE_TESTS;SOURCES;EXTRA_DEFS" ${ARGN})
  get_property(_rdtb_gen GLOBAL PROPERTY RCCL_DERIVED_${_rdtb_DERIVED}_GEN)
  get_property(_rdtb_bases GLOBAL PROPERTY RCCL_DERIVED_${_rdtb_DERIVED}_BASES)
  get_property(_rdtb_suite GLOBAL PROPERTY RCCL_DERIVED_${_rdtb_DERIVED}_SUITE)
  if(NOT _rdtb_BASE OR NOT _rdtb_BASE IN_LIST _rdtb_bases)
    message(FATAL_ERROR
      "${_name}: BASE '${_rdtb_BASE}' is not a base of rccl_derived_transport_tests(${_rdtb_DERIVED})")
  endif()
  _rccl_derived_gen_lists("${_rdtb_gen}/bin/${_name}" ${_name} "${_rdtb_EXCLUDE_BASE_TESTS}"
    "${_rdtb_ENABLE_BASE_TESTS}")
  rccl_add_transport_micro_binary(${_name} ${_test} ${_rdtb_UNPARSED_ARGUMENTS}
    SOURCES ${_rdtb_SOURCES} transport/derived_transport_tests_check.cc
    EXTRA_DEFS ${_rdtb_EXTRA_DEFS} RCCL_DERIVED_SELF_CHECK_SUITE=${_rdtb_suite})
  target_compile_definitions(${_name} PRIVATE RCCL_DERIVED_BASE_DIR="transport/${_rdtb_BASE}/")
  target_compile_options(${_name} PRIVATE
    "SHELL:-iquote ${_rdtb_gen}/${_rdtb_BASE}/shim"
    "SHELL:-iquote ${_rdtb_gen}/bin/${_name}"
    "SHELL:-include ${_rdtb_gen}/${_rdtb_BASE}/names.h")
endmacro()
