# clang-tidy configuration for RCCL.

Checks: >
  -*,
  readability-function-cognitive-complexity

CheckOptions:
  readability-function-cognitive-complexity.Threshold: 300
  # IgnoreMacros stays at its default of false: RCCL's control flow runs
  # through NCCLCHECK and friends, and those branches are real.

# RCCL's own sources only, not the ROCm headers they pull in.
HeaderFilterRegex: '.*/(src|plugins|tools)/.*'
