          "description": "AllReduce performance: LL + IPC + Ring with NCCL_MIN_NCHANNELS=NCCL_MAX_NCHANNELS=32",
          "env_variables": {
            "NCCL_PROTO": "LL",
            "NCCL_ALGO": "Ring",
            "NCCL_MIN_NCHANNELS": "32",
