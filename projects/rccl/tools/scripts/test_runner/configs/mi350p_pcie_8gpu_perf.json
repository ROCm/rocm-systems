          }
        },
        {
          "name": "AllReduce_LL_IPC_Tree_ch4",
          "description": "AllReduce performance: LL + IPC + Tree with NCCL_MIN_NCHANNELS=NCCL_MAX_NCHANNELS=4",
          "env_variables": {
            "NCCL_PROTO": "LL",
            "NCCL_ALGO": "Tree",
            "NCCL_MIN_NCHANNELS": "4",
            "NCCL_MAX_NCHANNELS": "4",
            "NCCL_SHM_DISABLE": "1",
            "NCCL_P2P_DISABLE": "0"
          }
        },
        {
          "name": "AllReduce_LL_IPC_Tree_ch32",
          "description": "AllReduce performance: LL + IPC + Tree with NCCL_MIN_NCHANNELS=NCCL_MAX_NCHANNELS=32",
          "env_variables": {
            "NCCL_PROTO": "LL",
            "NCCL_ALGO": "Tree",
            "NCCL_MIN_NCHANNELS": "32",
            "NCCL_MAX_NCHANNELS": "32",
            "NCCL_SHM_DISABLE": "1",
            "NCCL_P2P_DISABLE": "0"
          }
        }
      ]
    },
    "all_gather_perf": {
      "is_gtest": false,
      "binary": "all_gather_perf",
      "num_ranks": 8,
      "num_nodes": 1,
      "num_gpus": 8,
      "timeout": 1800,
      "command_args": "-b 1M -e 1G -f 2 -g 1 -n 20 -w 5",
      "tests": [
        {
          "name": "AllGather_auto",
          "description": "AllGather with RCCL defaults",
          "env_variables": {}
        }
      ]
    },
    "reduce_scatter_perf": {
      "is_gtest": false,
      "binary": "reduce_scatter_perf",
      "num_ranks": 8,
      "num_nodes": 1,
      "num_gpus": 8,
      "timeout": 1800,
      "command_args": "-b 1M -e 1G -f 2 -g 1 -n 20 -w 5",
      "tests": [
        {
          "name": "ReduceScatter_auto",
          "description": "ReduceScatter with RCCL defaults",
          "env_variables": {}
        }
      ]
    }
  },
  "test_suites": [
    {
      "name": "MI350P AllReduce performance",
      "description": "Auto plus the sweep at 4 and 32 channels",
      "config": "allreduce_perf",
      "enabled": true
    },
    {
      "name": "MI350P AllGather performance",
      "description": "Default AllGather bandwidth",
      "config": "all_gather_perf",
      "enabled": true
    },
    {
      "name": "MI350P ReduceScatter performance",
      "description": "Default ReduceScatter bandwidth",
      "config": "reduce_scatter_perf",
      "enabled": true
    }
  ]
