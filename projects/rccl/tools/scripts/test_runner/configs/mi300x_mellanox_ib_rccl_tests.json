      "tests": [
        {
          "name": "Init_KernelCollTrace",
          "description": "RCCL_KERNEL_COLL_TRACE_ENABLE + thread variant",
          "env_variables": {
            "RCCL_KERNEL_COLL_TRACE_ENABLE": "1",
            "RCCL_KERNEL_COLL_TRACE_THREAD_ENABLE": "1"
          }
        },
        {
          "name": "Init_CtaBounds",
          "description": "NCCL_MIN_CTAS / NCCL_MAX_CTAS",
          "env_variables": {
            "NCCL_MIN_CTAS": "1",
            "NCCL_MAX_CTAS": "16"
          }
        },
        {
          "name": "Init_FineGrainPcie",
          "description": "HSA_FORCE_FINE_GRAIN_PCIE",
          "env_variables": {
            "HSA_FORCE_FINE_GRAIN_PCIE": "1"
          }
        },
        {
          "name": "Init_BuffSize_Channels",
          "description": "NCCL_BUFFSIZE + NCCL_NCHANNELS_PER_NET_PEER",
          "env_variables": {
            "NCCL_BUFFSIZE": "8388608",
            "NCCL_NCHANNELS_PER_NET_PEER": "2"
          }
        },
        {
          "name": "Init_LaunchMode_Group",
          "description": "NCCL_LAUNCH_MODE group launch path",
          "env_variables": {
