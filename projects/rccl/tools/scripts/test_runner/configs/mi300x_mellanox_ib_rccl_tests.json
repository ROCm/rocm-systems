          "description": "NCCL_UID_STAGGER_RATE + NCCL_UID_STAGGER_THRESHOLD",
          "env_variables": {
            "NCCL_UID_STAGGER_RATE": "5000",
            "NCCL_UID_STAGGER_THRESHOLD": "128"
          }
        }
      ]
    },
    "debug_observability": {
      "extends": "perf_base",
      "command_args": "-b 8 -e 64M -f 4 -g 1 -n 3 -w 1 -c 1",
      "tests": [
        {
          "name": "Debug_Info_Subsys",
          "description": "NCCL_DEBUG=INFO + NCCL_DEBUG_SUBSYS subsystem filter",
          "env_variables": {
            "NCCL_DEBUG": "INFO",
            "NCCL_DEBUG_SUBSYS": "INIT,COLL,NET,TUNING"
          }
        },
        {
          "name": "Debug_File_ThreadName",
          "description": "NCCL_DEBUG_FILE + NCCL_SET_THREAD_NAME",
          "env_variables": {
            "NCCL_DEBUG": "INFO",
            "NCCL_DEBUG_FILE": "rccl_debug.%h.%p.log",
            "NCCL_SET_THREAD_NAME": "1"
          }
        },
        {
          "name": "Debug_LogRoctx",
          "description": "RCCL_LOG_ROCTX",
          "env_variables": {
            "RCCL_LOG_ROCTX": "1"
          }
        },
        {
          "name": "Debug_GraphMixing",
          "description": "NCCL_GRAPH_MIXING_SUPPORT",
