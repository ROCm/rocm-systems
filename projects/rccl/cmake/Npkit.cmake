    ENABLE_NPKIT_EVENT_PRIM_LL_DATA_PROCESS_ENTRY
    ENABLE_NPKIT_EVENT_PRIM_LL_DATA_PROCESS_EXIT
    ENABLE_NPKIT_EVENT_PRIM_LL128_WAIT_SEND_ENTRY
    ENABLE_NPKIT_EVENT_PRIM_LL128_WAIT_SEND_EXIT
    ENABLE_NPKIT_EVENT_PRIM_LL128_DATA_PROCESS_ENTRY
    ENABLE_NPKIT_EVENT_PRIM_LL128_DATA_PROCESS_EXIT
    ENABLE_NPKIT_EVENT_NET_SEND_ENTRY
    ENABLE_NPKIT_EVENT_NET_SEND_EXIT
    ENABLE_NPKIT_EVENT_NET_TEST_ENTRY
    ENABLE_NPKIT_EVENT_NET_TEST_EXIT
