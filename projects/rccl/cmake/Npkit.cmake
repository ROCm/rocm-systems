    ENABLE_NPKIT_PRIM_COLLECT_DATA_PROCESS_TIME
  )

  foreach(_def IN LISTS _npkit_defs)
    target_compile_definitions(${TARGET} PRIVATE ${_def})
  endforeach()
endfunction()
