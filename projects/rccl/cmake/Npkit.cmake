    ENABLE_NPKIT_EVENT_BROADCAST_RING_ENTRY
    ENABLE_NPKIT_EVENT_BROADCAST_RING_EXIT
    ENABLE_NPKIT_EVENT_REDUCE_SCATTER_RING_ENTRY
