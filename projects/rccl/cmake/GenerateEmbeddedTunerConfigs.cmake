#
# Embeds tuner/*.csv into a header so librccl.so ships the built-in CSV tuner
# configs without the files being staged on disk.
#
# cmake -DTUNER_DIR=<dir> -DOUT_FILE=<header> -P GenerateEmbeddedTunerConfigs.cmake

if(NOT DEFINED TUNER_DIR OR NOT DEFINED OUT_FILE)
  message(FATAL_ERROR "GenerateEmbeddedTunerConfigs.cmake requires -DTUNER_DIR and -DOUT_FILE")
endif()

set(RAW_DELIM "RCCLCSV")

file(GLOB CSV_FILES "${TUNER_DIR}/*.csv")
list(SORT CSV_FILES)

set(ENTRIES "")
foreach(CSV_FILE ${CSV_FILES})
  get_filename_component(CSV_NAME ${CSV_FILE} NAME)
  file(READ ${CSV_FILE} CSV_CONTENT)

  string(FIND "${CSV_CONTENT}" ")${RAW_DELIM}\"" BAD_IDX)
  if(NOT BAD_IDX EQUAL -1)
    message(FATAL_ERROR "${CSV_FILE} contains the raw string terminator )${RAW_DELIM}\" and cannot be embedded")
  endif()

  string(APPEND ENTRIES "  {\"${CSV_NAME}\", R\"${RAW_DELIM}(${CSV_CONTENT})${RAW_DELIM}\"},\n")
  message(STATUS "Embedding tuner config: ${CSV_NAME}")
endforeach()

list(LENGTH CSV_FILES CSV_COUNT)

set(HEADER "/* Generated by cmake/GenerateEmbeddedTunerConfigs.cmake -- do not edit, do not commit. */
#ifndef RCCL_TUNER_EMBEDDED_CONFIGS_H_
#define RCCL_TUNER_EMBEDDED_CONFIGS_H_

/* ${CSV_COUNT} config(s) embedded from the source tree's tuner/ directory. */
struct RcclEmbeddedTunerConfig {
  const char* name;
  const char* content;
};

static const RcclEmbeddedTunerConfig kRcclEmbeddedTunerConfigs[] = {
${ENTRIES}  {nullptr, nullptr}, /* sentinel: array is never zero-length */
};

#endif /* RCCL_TUNER_EMBEDDED_CONFIGS_H_ */
")

# Rewrite only on change so regeneration does not force a rebuild.
set(OLD_HEADER "")
if(EXISTS ${OUT_FILE})
  file(READ ${OUT_FILE} OLD_HEADER)
endif()
if(NOT OLD_HEADER STREQUAL HEADER)
  file(WRITE ${OUT_FILE} "${HEADER}")
endif()
