# Dockerfile for rocprofiler-sdk CI dependencies - Ubuntu 24.04
FROM ubuntu:24.04
SHELL ["/bin/bash","-lc"]

# Set environment variables for non-interactive installs
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Update package lists and install core dependencies
RUN apt-get update && apt-get install -y \
    # Core build tools
    build-essential \
    cmake \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    wget \
    xxd \
    # Compiler toolchains (Ubuntu 24.04 default is gcc-13)
    gcc-13 \
    g++-13 \
    clang-16 \
    # System libraries and development headers
    libdw-dev \
    libsqlite3-dev \
    libdrm-dev \
    libelf-dev \
    libnuma1 \
    libnuma-dev \
    pkg-config \
    autoconf \
    file \
    rpm \
    libzstd-dev \
    # Sanitizer libraries
    libasan8 \
    libtsan2 \
    # Documentation tools
    doxygen \
    graphviz \
    # Coverage and formatting tools
    gcovr \
    # Font and rendering libraries (for coverage reports)
    libfontconfig \
    wkhtmltopdf \
    xvfb \
    xfonts-base \
    xfonts-75dpi \
    xfonts-100dpi \
    xfonts-utils \
    xfonts-encodings \
    # Repository management
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Install latest Git PPA for Github Checkout Action Support
RUN add-apt-repository ppa:git-core/ppa && \
    apt-get update && \
    apt-get install -y git

# Add GCC toolchain PPA for additional compiler versions
RUN add-apt-repository ppa:ubuntu-toolchain-r/test && \
    apt-get update && \
    apt-get install -y gcc-13 g++-13 && \
    rm -rf /var/lib/apt/lists/*

# Configure compiler alternatives (only for versions present)
RUN set -e; \
    if [ -x /usr/bin/gcc-11 ]; then \
      update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 10 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-11 \
        --slave /usr/bin/gcov gcov /usr/bin/gcov-11; \
    fi; \
    if [ -x /usr/bin/gcc-12 ]; then \
      update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 20 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-12 \
        --slave /usr/bin/gcov gcov /usr/bin/gcov-12; \
    fi; \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 \
      --slave /usr/bin/g++ g++ /usr/bin/g++-13 \
      --slave /usr/bin/gcov gcov /usr/bin/gcov-13

# Install ccache for build acceleration
RUN apt-get update && apt-get install -y ccache && \
    rm -rf /var/lib/apt/lists/*

# Set up ccache in PATH
ENV PATH="/usr/lib/ccache:${PATH}"

# Install AWS CLI for later stages (use pip on noble to avoid apt candidate issues)
RUN python3 -m pip install awscli --break-system-packages

# Configure git for container builds (kept for compatibility)
RUN git config --global --add safe.directory '*'

# Clone the rocm-systems repository at a specific ref/rev to enable Docker cache busting
ARG ROCM_SYSTEMS_REF=develop
ARG ROCM_SYSTEMS_REV
WORKDIR /workspace
RUN git init . && \
    git remote add origin https://github.com/ROCm/rocm-systems.git && \
    git config --global --add safe.directory /workspace && \
    git fetch --depth 1 origin ${ROCM_SYSTEMS_REF} && \
    git checkout ${ROCM_SYSTEMS_REV:-FETCH_HEAD}

# Initialize submodules (matching CI workflow)
RUN git submodule update --init --recursive --jobs 16

# Create a compressed submodule cache and a restore helper
RUN set -euo pipefail; \
    git config --file .gitmodules --get-regexp path | awk '{print $2}' > .git-submodule-paths || true; \
    tar -czf /opt/rocprofiler-submodules-cache.tar.gz .git/modules $(cat .git-submodule-paths || true) .gitmodules || true; \
    cat > /usr/local/bin/restore-submodules-cache.sh <<'EOS'
#!/usr/bin/env bash
set -euo pipefail
TARGET_DIR="${1:-/github/workspace}"
ARCHIVE="/opt/rocprofiler-submodules-cache.tar.gz"
if [ -f "$ARCHIVE" ]; then
  mkdir -p "$TARGET_DIR"
  tar -xzf "$ARCHIVE" -C "$TARGET_DIR"
fi
EOS
RUN chmod +x /usr/local/bin/restore-submodules-cache.sh

# Install Python requirements for rocprofiler-sdk
RUN python3 -m pip install --break-system-packages -r projects/rocprofiler-sdk/requirements.txt
RUN python3 -m pip install --break-system-packages ninja

# Set environment variables used by CI
ENV GIT_DISCOVERY_ACROSS_FILESYSTEM=1
ENV ROCM_PATH="/opt/rocm"
ENV GPU_TARGETS="gfx900 gfx906 gfx908 gfx90a gfx940 gfx941 gfx942 gfx950 gfx1030 gfx1100 gfx1101 gfx1102 gfx1201"
ENV PATH="/usr/bin:$PATH"

# Set environment variables required for building and testing across multiple ROCm projects
ENV CMAKE_HIP_PLATFORM=amd
ENV HIP_PLATFORM=amd
ENV HIP_RUNTIME=rocclr
ENV HIP_COMPILER=amdclang++
ENV LLVM_PATH=/opt/rocm/llvm
ENV CMAKE_PREFIX_PATH=/opt/rocm

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]

