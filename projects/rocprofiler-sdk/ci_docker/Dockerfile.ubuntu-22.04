# Dockerfile for rocprofiler-sdk CI dependencies - Ubuntu 22.04
FROM docker.io/rocm/rocprofiler-private:ubuntu-22.04-gfx94X-latest

# Set environment variables for non-interactive installs
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Update package lists and install core dependencies
RUN apt-get update && apt-get install -y \
    # Core build tools
    build-essential \
    cmake \
    python3 \
    python3-pip \
    python3-venv \
    git \
    curl \
    wget \
    # Compiler toolchains
    gcc-11 \
    g++-11 \
    gcc-12 \
    g++-12 \
    clang-15 \
    # System libraries and development headers
    libdw-dev \
    libsqlite3-dev \
    libdrm-dev \
    libelf-dev \
    pkg-config \
    autoconf \
    file \
    rpm \
    libzstd-dev \
    # Sanitizer libraries
    libasan8 \
    libtsan2 \
    # Documentation tools
    doxygen \
    graphviz \
    # Coverage and formatting tools
    gcovr \
    # Font and rendering libraries (for coverage reports)
    libfontconfig \
    wkhtmltopdf \
    xvfb \
    xfonts-base \
    xfonts-75dpi \
    xfonts-100dpi \
    xfonts-utils \
    xfonts-encodings \
    # Repository management
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Add GCC toolchain PPA for additional compiler versions
RUN add-apt-repository ppa:ubuntu-toolchain-r/test && \
    apt-get update && \
    apt-get install -y gcc-13 g++-13 && \
    rm -rf /var/lib/apt/lists/*

# Configure compiler alternatives (matching CI setup)
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 10 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-11 \
        --slave /usr/bin/gcov gcov /usr/bin/gcov-11 && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 20 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-12 \
        --slave /usr/bin/gcov gcov /usr/bin/gcov-12 && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-13 \
        --slave /usr/bin/gcov gcov /usr/bin/gcov-13

# Install ccache for build acceleration
RUN apt-get update && apt-get install -y ccache && \
    rm -rf /var/lib/apt/lists/*

# Set up ccache in PATH
ENV PATH="/usr/lib/ccache:${PATH}"

# Configure git for container builds
RUN git config --global --add safe.directory '*'

# Clone the full rocm-systems repository
WORKDIR /workspace
RUN git clone https://github.com/ROCm/rocm-systems.git . && \
    git config --global --add safe.directory /workspace

# Initialize submodules (matching CI workflow)
RUN git submodule update --init --recursive --jobs 16

# Install Python requirements for rocprofiler-sdk
RUN cd projects/rocprofiler-sdk && \
    python3 -m pip install --upgrade pip && \
    python3 -m pip install -r requirements.txt

# Set environment variables used by CI
ENV GIT_DISCOVERY_ACROSS_FILESYSTEM=1
ENV ROCM_PATH="/opt/rocm"
ENV GPU_TARGETS="gfx900 gfx906 gfx908 gfx90a gfx940 gfx941 gfx942 gfx950 gfx1030 gfx1100 gfx1101 gfx1102 gfx1201"
ENV PATH="/usr/bin:$PATH"

# Set working directory to match CI expectations
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]