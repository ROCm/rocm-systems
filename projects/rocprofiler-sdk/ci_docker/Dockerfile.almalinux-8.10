# Dockerfile for rocprofiler-sdk CI dependencies - AlmaLinux 8.10
FROM almalinux:8.10

# Install core dependencies using dnf
RUN dnf update -y && dnf install -y \
    # Core build tools
    gcc \
    gcc-c++ \
    cmake \
    python3 \
    python3-pip \
    python3.11-pip \
    python3-devel \
    git \
    wget \
    make \
    vim-common \
    # Development tools and libraries
    elfutils-libelf-devel \
    sqlite-devel \
    libdrm-devel \
    numactl-devel \
    pkgconfig \
    autoconf \
    file \
    rpm-build \
    libzstd-devel \
    zlib-devel \
    openssl-devel \
    sqlite-devel \
    elfutils-devel \
    # Additional development tools
    curl-devel \
    expat-devel \
    diffutils \
    patch \
    which \
    findutils \
    tar \
    gzip \
    bzip2 \
    xz \
    gettext \
    # Documentation tools (if available in RHEL repos)
    graphviz \
    && dnf clean all

# Enable GCC toolset 11 (RHEL development toolset)
RUN dnf install -y gcc-toolset-11-gcc gcc-toolset-11-gcc-c++ && \
    dnf clean all

# Enable PowerTools repository for additional packages
RUN dnf install -y dnf-plugins-core; \
    dnf config-manager --set-enabled powertools

# Create symbolic links for GCC toolset 11 (matching CI setup)
RUN ln -sf /opt/rh/gcc-toolset-11/root/usr/bin/gcc /usr/local/bin/gcc-11 && \
    ln -sf /opt/rh/gcc-toolset-11/root/usr/bin/g++ /usr/local/bin/g++-11 && \
    ln -sf /opt/rh/gcc-toolset-11/root/usr/bin/gcov /usr/local/bin/gcov-11

# Install sccache (used in RHEL CI builds)
RUN curl -L https://github.com/mozilla/sccache/releases/download/v0.7.4/sccache-v0.7.4-x86_64-unknown-linux-musl.tar.gz \
    | tar -xzf - -C /tmp && \
    mv /tmp/sccache-v0.7.4-x86_64-unknown-linux-musl/sccache /usr/local/bin/ && \
    chmod +x /usr/local/bin/sccache && \
    rm -rf /tmp/sccache-*

# Install additional Python tools
RUN python3 -m pip install --upgrade pip setuptools wheel cppheaderparser

# Install AWS CLI for later stages
RUN python3 -m pip install -U awscli

# Set environment variables for GCC toolset
ENV PATH="/opt/rh/gcc-toolset-11/root/usr/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/rh/gcc-toolset-11/root/usr/lib64:/opt/rh/gcc-toolset-11/root/usr/lib:${LD_LIBRARY_PATH}"

# Build newer Git from source (align with Dockerfile.ci approach)
RUN set -euo pipefail; \
    export PATH=/opt/rh/gcc-toolset-11/root/usr/bin:$PATH; \
    cd /tmp; \
    wget https://www.kernel.org/pub/software/scm/git/git-2.51.0.tar.xz; \
    tar -xf git-2.51.0.tar.xz; \
    cd git-2.51.0; \
    make prefix=/usr all -j 32; \
    make prefix=/usr install; \
    cd /tmp; \
    ln -s -f /usr/bin/git /usr/local/bin/git || true; \
    rm -rf /tmp/git-2.51.0*

# Configure git for container builds (kept for compatibility)
RUN git config --global --add safe.directory '*'

# Clone the full rocm-systems repository and initialize submodules
WORKDIR /workspace
RUN git clone https://github.com/ROCm/rocm-systems.git . && \
    git config --global --add safe.directory /workspace

# Initialize submodules (matching CI workflow)
RUN git submodule update --init --recursive --jobs 16

# Install Python requirements for rocprofiler-sdk (using venv as in CI)
RUN python3 -m venv rocprofiler-sdk && \
    source rocprofiler-sdk/bin/activate && \
    python3 -m pip install --upgrade pip && \
    python3 -m pip install --upgrade -r projects/rocprofiler-sdk/requirements.txt

# Create a compressed submodule cache and a restore helper
RUN set -euo pipefail; \
    git config --file .gitmodules --get-regexp path | awk '{print $2}' > .git-submodule-paths || true; \
    tar -czf /opt/rocprofiler-submodules-cache.tar.gz .git/modules $(cat .git-submodule-paths || true) .gitmodules || true; \
    cat > /usr/local/bin/restore-submodules-cache.sh <<'EOS' && chmod +x /usr/local/bin/restore-submodules-cache.sh
#!/usr/bin/env bash
set -euo pipefail
TARGET_DIR="${1:-/github/workspace}"
ARCHIVE="/opt/rocprofiler-submodules-cache.tar.gz"
if [ -f "$ARCHIVE" ]; then
    mkdir -p "$TARGET_DIR"
    tar -xzf "$ARCHIVE" -C "$TARGET_DIR"
fi
EOS

# Set environment variables used by CI
ENV GIT_DISCOVERY_ACROSS_FILESYSTEM=1
ENV ROCM_PATH="/opt/rocm"
ENV GPU_TARGETS="gfx900 gfx906 gfx908 gfx90a gfx940 gfx941 gfx942 gfx950 gfx1030 gfx1100 gfx1101 gfx1102 gfx1201"
ENV PATH="/usr/bin:$PATH"

# Set environment variables required for building and testing across multiple ROCm projects
ENV CMAKE_HIP_PLATFORM=amd
ENV HIP_PLATFORM=amd
ENV HIP_RUNTIME=rocclr
ENV HIP_COMPILER=amdclang++
ENV LLVM_PATH=/opt/rocm/llvm
ENV CMAKE_PREFIX_PATH=/opt/rocm

# Set working directory to match CI expectations
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]