# Dockerfile for rocprofiler-sdk CI dependencies - SLES 15.6
FROM docker.io/rocm/rocprofiler-private:sles-15.6-gfx94X-latest

# Install core dependencies using zypper
RUN zypper refresh && zypper install -y \
    # Core build tools
    gcc \
    gcc-c++ \
    cmake \
    python3 \
    python3-pip \
    git \
    curl \
    wget \
    make \
    # Development libraries and headers
    libelf-devel \
    sqlite3-devel \
    libdrm-devel \
    pkg-config \
    autoconf \
    file \
    rpm-build \
    libzstd-devel \
    zlib-devel \
    # Additional development tools
    patch \
    which \
    findutils \
    tar \
    gzip \
    bzip2 \
    xz \
    # Documentation tools
    doxygen \
    graphviz \
    && zypper clean --all

# Install GCC 11 if available in SLES repos
RUN zypper install -y gcc11 gcc11-c++ || echo "GCC 11 not available, using system default"

# Install sccache (used in SLES CI builds)
RUN curl -L https://github.com/mozilla/sccache/releases/download/v0.7.4/sccache-v0.7.4-x86_64-unknown-linux-musl.tar.gz \
    | tar -xzf - -C /tmp && \
    mv /tmp/sccache-v0.7.4-x86_64-unknown-linux-musl/sccache /usr/local/bin/ && \
    chmod +x /usr/local/bin/sccache && \
    rm -rf /tmp/sccache-*

# Install additional Python tools
RUN python3 -m pip install --upgrade pip setuptools wheel

# Configure git for container builds
RUN git config --global --add safe.directory '*'

# Clone the full rocm-systems repository
WORKDIR /workspace
RUN git clone https://github.com/ROCm/rocm-systems.git . && \
    git config --global --add safe.directory /workspace

# Initialize submodules (matching CI workflow)
RUN git submodule update --init --recursive --jobs 16

# Install Python requirements for rocprofiler-sdk (using venv as in CI)
RUN cd projects/rocprofiler-sdk && \
    python3 -m venv rocprofiler-sdk && \
    source rocprofiler-sdk/bin/activate && \
    python3 -m pip install --upgrade pip && \
    python3 -m pip install --upgrade -r requirements.txt

# Set environment variables used by CI
ENV GIT_DISCOVERY_ACROSS_FILESYSTEM=1
ENV ROCM_PATH="/opt/rocm"
ENV GPU_TARGETS="gfx900 gfx906 gfx908 gfx90a gfx940 gfx941 gfx942 gfx950 gfx1030 gfx1100 gfx1101 gfx1102 gfx1201"
ENV PATH="/usr/bin:$PATH"

# Set working directory to match CI expectations
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]