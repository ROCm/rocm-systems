# - Config file for @PACKAGE_NAME@ and its component libraries
# It defines the following variables:
#
# @PACKAGE_NAME_UNDERSCORED@_VERSION
# @PACKAGE_NAME_UNDERSCORED@_BIN_DIR
# @PACKAGE_NAME_UNDERSCORED@_TEST_ROOT
# @PACKAGE_NAME_UNDERSCORED@_HAS_TEST_BINARIES
# @PACKAGE_NAME_UNDERSCORED@_LD_LIBRARY_PATH_HINT
#

# prevent "target already exists" error
include_guard(DIRECTORY)

# compute paths
get_filename_component(@PACKAGE_NAME_UNDERSCORED@_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}"
                       PATH)

@PACKAGE_INIT@

set(@PACKAGE_NAME_UNDERSCORED@_VERSION "@PROJECT_VERSION@")

set(@PACKAGE_NAME_UNDERSCORED@_HAS_TEST_BINARIES @PROJECT_HAS_TEST_TARGETS@)
set(@PACKAGE_NAME_UNDERSCORED@_TEST_ROOT "@PACKAGE_TEST_ROOT_DIR@")
set(@PACKAGE_NAME_UNDERSCORED@_LD_LIBRARY_PATH_HINT "@PACKAGE_TEST_LD_LIBRARY_PATH@")
set_and_check(@PACKAGE_NAME_UNDERSCORED@_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")
get_filename_component(@PACKAGE_NAME_UNDERSCORED@_ROOT_DIR
                       ${@PACKAGE_NAME_UNDERSCORED@_INCLUDE_DIR} PATH)
set_and_check(@PACKAGE_NAME_UNDERSCORED@_ROOT "${@PACKAGE_NAME_UNDERSCORED@_ROOT_DIR}")

# extra validation
foreach(_FILE @PROJECT_INCLUDE_FILES@)
    set_and_check(_@PACKAGE_NAME_UNDERSCORED@_INCLUDE_FILE_CHECK
                  "${@PACKAGE_NAME_UNDERSCORED@_INCLUDE_DIR}/${_FILE}")
    unset(_@PACKAGE_NAME_UNDERSCORED@_INCLUDE_FILE_CHECK)
endforeach()

set(_@PACKAGE_NAME_UNDERSCORED@_targets
    "${@PACKAGE_NAME_UNDERSCORED@_CMAKE_DIR}/@PACKAGE_NAME@-targets.cmake")

if(EXISTS "${_@PACKAGE_NAME_UNDERSCORED@_targets}")
    include("${_@PACKAGE_NAME_UNDERSCORED@_targets}")
else()
    set(@PACKAGE_NAME_UNDERSCORED@_HAS_TEST_BINARIES OFF)
endif()

set(@PACKAGE_NAME_UNDERSCORED@_TEST_FILES)

if(@PACKAGE_NAME_UNDERSCORED@_HAS_TEST_BINARIES)
    foreach(_FILE @PROJECT_INCLUDE_FILES@)
        list(APPEND @PACKAGE_NAME_UNDERSCORED@_TEST_FILES
             "${@PACKAGE_NAME_UNDERSCORED@_INCLUDE_DIR}/${_FILE}")
    endforeach()
endif()

function(@PACKAGE_NAME_UNDERSCORED@_add_tests)
    if(NOT @PACKAGE_NAME_UNDERSCORED@_HAS_TEST_BINARIES)
        return()
    endif()

    foreach(_FILE ${@PACKAGE_NAME_UNDERSCORED@_TEST_FILES})
        include("${_FILE}")
    endforeach()
endfunction()

set("@PACKAGE_NAME@_FOUND" ${@PACKAGE_NAME_UNDERSCORED@_FOUND})
set("@PACKAGE_NAME@_VERSION" ${@PACKAGE_NAME_UNDERSCORED@_VERSION})
set("@PACKAGE_NAME@_ROOT" ${@PACKAGE_NAME_UNDERSCORED@_ROOT})
set("@PACKAGE_NAME@_TEST_ROOT" ${@PACKAGE_NAME_UNDERSCORED@_TEST_ROOT})
set("@PACKAGE_NAME@_HAS_TEST_BINARIES" ${@PACKAGE_NAME_UNDERSCORED@_HAS_TEST_BINARIES})
set("@PACKAGE_NAME@_LD_LIBRARY_PATH_HINT" ${@PACKAGE_NAME_UNDERSCORED@_LD_LIBRARY_PATH_HINT})

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(
    @PACKAGE_NAME@
    FOUND_VAR @PACKAGE_NAME@_FOUND
    VERSION_VAR @PACKAGE_NAME@_VERSION
    REQUIRED_VARS @PACKAGE_NAME@_ROOT @PACKAGE_NAME@_VERSION
    HANDLE_COMPONENTS HANDLE_VERSION_RANGE)
