#
# Unit Test for @RAUT_TARGET@
#

project(rocprofiler-sdk-tests-unit-tests-@RAUT_TARGET@ LANGUAGES C CXX)

include(GoogleTest)

set(_NAME @RAUT_TARGET@)
set(_SOURCES @RAUT_SOURCES@)
set(_LABELS @RAUT_LABELS@)
set(_FAIL_REGEX "@RAUT_FAIL_REGULAR_EXPRESSION@")
set(_PASS_REGEX "@RAUT_PASS_REGULAR_EXPRESSION@")
set(_SKIP_REGEX "@RAUT_SKIP_REGULAR_EXPRESSION@")
set(_DISABLED "@RAUT_DISABLED@")
set(_ENVIRONMENT "@RAUT_ENVIRONMENT@")
set(_PREFIX "@RAUT_TEST_PREFIX@")

# Helper to merge/append environment overrides.
set(_ENV_LIST ${_ENVIRONMENT})
set(_NEW_ENV_LIST "")
set(_LDLP_FOUND OFF)
set(_METRICS_FOUND OFF)

if(DEFINED ENV{ROCPROFILER_SDK_TEST_METRICS_PATH})
    set(_METRICS_OVERRIDE "$ENV{ROCPROFILER_SDK_TEST_METRICS_PATH}")
    if(NOT _METRICS_OVERRIDE MATCHES "^/")
        set(_METRICS_OVERRIDE "/${_METRICS_OVERRIDE}")
    endif()
endif()

foreach(_KV IN LISTS _ENV_LIST)
    if(DEFINED ENV{ROCPROFILER_SDK_TEST_LD_LIBRARY_PATH} AND _KV MATCHES "^LD_LIBRARY_PATH=(.*)")
        set(_LDLP_FOUND ON)
        set(_KV "LD_LIBRARY_PATH=${CMAKE_MATCH_1}:$ENV{ROCPROFILER_SDK_TEST_LD_LIBRARY_PATH}")
    endif()
    if(DEFINED _METRICS_OVERRIDE AND _KV MATCHES "^ROCPROFILER_METRICS_PATH=(.*)")
        set(_METRICS_FOUND ON)
        set(_KV "ROCPROFILER_METRICS_PATH=${_METRICS_OVERRIDE}")
    endif()
    list(APPEND _NEW_ENV_LIST "${_KV}")
endforeach()

if(DEFINED ENV{ROCPROFILER_SDK_TEST_LD_LIBRARY_PATH} AND NOT _LDLP_FOUND)
    list(APPEND _NEW_ENV_LIST "LD_LIBRARY_PATH=$ENV{ROCPROFILER_SDK_TEST_LD_LIBRARY_PATH}")
endif()

if(DEFINED ENV{ROCPROFILER_SDK_TEST_METRICS_PATH} AND NOT _METRICS_FOUND)
    list(APPEND _NEW_ENV_LIST "ROCPROFILER_METRICS_PATH=${_METRICS_OVERRIDE}")
endif()

set(_ENVIRONMENT "${_NEW_ENV_LIST}")

# test sources are in a subfolder
set(_TEST_SOURCES)
foreach(_FILE ${_SOURCES})
    list(APPEND _TEST_SOURCES "${CMAKE_CURRENT_LIST_DIR}/${_NAME}/${_FILE}")
endforeach()

# If the test target is not already defined (installed tree), create an IMPORTED
# executable pointing at the installed binary.
if(NOT TARGET ${_NAME})
    add_executable(${_NAME} IMPORTED GLOBAL)
    set_target_properties(${_NAME}
                          PROPERTIES IMPORTED_LOCATION "${CMAKE_CURRENT_LIST_DIR}/bin/${_NAME}")
endif()

gtest_add_tests(
    TARGET @RAUT_TARGET@
    SOURCES ${_TEST_SOURCES}
    TEST_LIST @RAUT_TARGET@_TESTS
    TEST_PREFIX ${_PREFIX}
    WORKING_DIRECTORY ${CMAKE_CURRENT_LIST_DIR})

set_tests_properties(
    ${@RAUT_TARGET@_TESTS}
    PROPERTIES TIMEOUT
               @RAUT_TIMEOUT@
               LABELS
               "${_LABELS}"
               FAIL_REGULAR_EXPRESSION
               "${_FAIL_REGEX}"
               PASS_REGULAR_EXPRESSION
               "${_PASS_REGEX}"
               SKIP_REGULAR_EXPRESSION
               "${_SKIP_REGEX}"
               ENVIRONMENT
               "${_ENVIRONMENT}"
               DISABLED
               "${_DISABLED}")

# Disable specific tests
set(_DISABLE_TESTS "@RAUT_DISABLE_TESTS@")
if(_DISABLE_TESTS)
    set_tests_properties(
        ${_DISABLE_TESTS}
        PROPERTIES DISABLED ON)
endif()
