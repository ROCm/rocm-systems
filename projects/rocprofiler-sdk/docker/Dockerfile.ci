# Build a thin "base with deps" image atop the private runner image
ARG BASE_TAG=ubuntu-22.04
FROM rocm/rocprofiler-private:${BASE_TAG}
ARG GPU_TYPE=gfx94X
ARG GPU_TARBALL

SHELL ["/bin/bash","-lc"]
COPY projects/rocprofiler-sdk/requirements*.txt /root/

ENV DEBIAN_FRONTEND=noninteractive
ENV CMAKE_HIP_PLATFORM=amd
ENV HIP_PLATFORM=amd
ENV HIP_RUNTIME=rocclr
ENV HIP_COMPILER=amdclang++
# TheRock is installed to /opt/rocm on every OS variant. This is the only place that sets the
# location. ROCM_HOME must be defined by its own ENV instruction before it is used below, because
# Docker expands variables with the values from before the current instruction.
ENV ROCM_HOME=/opt/rocm
ENV ROCM_PATH=${ROCM_HOME}
ENV LLVM_PATH=${ROCM_HOME}/llvm
ENV CMAKE_PREFIX_PATH=${ROCM_HOME}:${ROCM_HOME}/lib/rocm_sysdeps
ENV PATH=/opt/rh/gcc-toolset-11/root/usr/bin:/usr/lib64/openmpi/bin:${ROCM_HOME}/bin:${ROCM_HOME}/llvm/bin:/usr/local/bin:~/.local/bin:${PATH}
ENV LD_LIBRARY_PATH=${ROCM_HOME}/lib:${ROCM_HOME}/llvm/lib:${LD_LIBRARY_PATH:-}
# GitHub Actions runs steps with "bash --noprofile --norc", so /etc/profile.d is not read there.
# Set PKG_CONFIG_PATH with ENV so that non-login shells also find the TheRock pkg-config files.
ENV PKG_CONFIG_PATH=${ROCM_HOME}/lib/pkgconfig:${ROCM_HOME}/lib/llvm/lib/pkgconfig:${ROCM_HOME}/lib/rocprofiler-systems/pkgconfig:${ROCM_HOME}/lib/rdc/grpc/lib/pkgconfig:${ROCM_HOME}/lib/rdc/grpc/lib/rocm_sysdeps/lib/pkgconfig:${ROCM_HOME}/lib/rocm_sysdeps/lib/pkgconfig:${ROCM_HOME}/lib/host-math/lib/pkgconfig:${ROCM_HOME}/share/pkgconfig:${PKG_CONFIG_PATH:-}

# Debian/Ubuntu
RUN set -euo pipefail; \
    if [ -f /etc/debian_version ]; then \
        apt-get update && \
        apt-get install -y curl wget gpg python3 python3-pip build-essential coreutils software-properties-common cmake g++-11 g++-12 libdw-dev libsqlite3-dev libdrm-dev libva-dev libx11-dev libxext-dev libxfixes-dev libxcb1-dev libwayland-dev libnuma-dev file autoconf pkg-config rpm libzstd-dev && \
        add-apt-repository ppa:git-core/ppa && \
        apt-get update && \
        # Remove git 2.17.1 from base image before installing new version.
        # The old git at /usr/local/bin/git lacks 'git switch' support.
        ls -la /usr/local/bin/ && \
        rm -f /usr/local/bin/git* && \
        rm -rf /usr/local/libexec/git-core && \
        rm -rf /git-2.17.1 && \
        apt-get install -y git && \
        python3 -m pip install -U awscli pipx && \
        python3 -m pip install -U --user -r /root/requirements.txt; \
    fi;

# RHEL
RUN set -euo pipefail; \
    if [ $(grep -i "ID=.*rhel" /etc/os-release | wc -l) -gt 0 ]; then \
        dnf clean all || true; \
        dnf install -y perl-ExtUtils-MakeMaker python3-pip || true; \
        if [ $(grep -i "VERSION_ID=\"8.8\"" /etc/os-release | wc -l) -gt 0 ]; then \
            wget https://www.kernel.org/pub/software/scm/git/git-2.52.0.tar.xz; \
            tar -xf git-2.52.0.tar.xz; \
            cd git-2.52.0; \
            rm -rf /etc/yum.repos.d/redhat-partner.repo || true; \
            dnf clean all; \
            dnf install -y perl-ExtUtils-MakeMaker || true; \
            export PATH=/opt/rh/gcc-toolset-11/root/usr/bin:$PATH; \
            make prefix=/usr all -j 32; \
            make prefix=/usr install; \
            cd ..; rm -rf git-2.52.0*; \
        else \
            rm -rf /etc/yum.repos.d/RHEL-partners.repo; \
            dnf clean all; \
        fi; \
        dnf clean all; \
        dnf install -y libsqlite3x-devel openmpi-devel elfutils-devel; \
        python3 -m pip install -U awscli pipx; \
        python3 -m venv rocprofiler-sdk; \
        source rocprofiler-sdk/bin/activate; \
        export PATH=/opt/rh/gcc-toolset-11/root/usr/bin:${PATH}; \
        python3 -m pip install --upgrade pip; \
        python3 -m pip install --upgrade -r /root/requirements.txt; \
    fi;

# SLES
RUN set -euo pipefail; \
    if [ $(grep -i "sles" /etc/os-release | wc -l) -gt 0 ]; then \
        rpm -q sqlite3-devel python3-pip; \
        python3 -m venv rocprofiler-sdk; \
        source rocprofiler-sdk/bin/activate; \
        python3 -m pip install --upgrade pip pipx; \
        python3 -m pipx install awscli; \
        python3 -m pipx ensurepath; \
        source ~/.bashrc; \
        python3 -m pip install --upgrade pip || true; \
        python3 -m pip install --upgrade -r /root/requirements.txt || true; \
        cd /tmp; wget https://www.kernel.org/pub/software/scm/git/git-2.52.0.tar.xz; \
        tar -xf git-2.52.0.tar.xz; cd git-2.52.0; make prefix=/usr all -j 32; make prefix=/usr install; \
        cd /tmp; ln -s -f /usr/bin/git /usr/local/bin/git; rm -rf git-2.52.0*; \
    fi;

# Configure PKG_CONFIG_PATH for all ROCm libraries
RUN set -euo pipefail; \
    echo -e "PKG_CONFIG_PATH=\"${ROCM_HOME}/lib/pkgconfig:${ROCM_HOME}/lib/llvm/lib/pkgconfig:${ROCM_HOME}/lib/rocprofiler-systems/pkgconfig:${ROCM_HOME}/lib/rdc/grpc/lib/pkgconfig:${ROCM_HOME}/lib/rdc/grpc/lib/rocm_sysdeps/lib/pkgconfig:${ROCM_HOME}/lib/rocm_sysdeps/lib/pkgconfig:${ROCM_HOME}/lib/host-math/lib/pkgconfig:${ROCM_HOME}/share/pkgconfig:\${PKG_CONFIG_PATH}\"\nexport PKG_CONFIG_PATH" > /etc/profile.d/rocm-pkg-config.sh

# Nightly Tarball
# The TheRock tarball ships the OpenMP runtime (libomp.so), LLVM, and bundled system deps under
# lib/llvm/lib and lib/rocm_sysdeps/lib. These directories are not on the default dynamic-linker
# search path, so register them via ldconfig.
#
# TheRock nightly tarballs also ship some bundled rocm_sysdeps pkg-config (.pc) files with
# non-relocatable, absolute build-stage prefixes (e.g. zlib.pc has
# prefix=/__w/.../stage/lib/rocm_sysdeps). elfutils' libdw.pc/libelf.pc pull zlib in via
# "Requires.private: zlib", so that dead path leaks through pkg_check_modules into the imported
# rocprofiler-sdk target and breaks configure with "includes non-existent path
# .../rocm_sysdeps/include in its INTERFACE_INCLUDE_DIRECTORIES". Rewrite those build-stage paths
# to the relocatable ${pcfiledir} form so they resolve relative to the installed location.
# Idempotent: only lines containing a build-stage rocm_sysdeps path are touched, so this is a
# no-op once ROCm/TheRock#6906 is fixed.
#
# The amdgpu-install package and its /opt/amdgpu installation are no longer used. The TheRock
# tarball provides all required components including libdrm_amdgpu. Both /opt/rocm* and /opt/amdgpu*
# are removed before tarball extraction to ensure a clean installation and prevent conflicts between
# old amdgpu-install artifacts and TheRock-provided libraries.
RUN set -euo pipefail; \
    if [ $(grep -i "sles" /etc/os-release | wc -l) -gt 0 ]; then \
        source rocprofiler-sdk/bin/activate; \
        python3 -m pipx ensurepath; \
        source ~/.bashrc; \
    fi; \
    aws s3 cp "s3://therock-nightly-tarball/${GPU_TARBALL}" /tmp/rocm-${GPU_TYPE}.tar.gz --no-sign-request && \
    rm -rf ${ROCM_HOME}* /opt/amdgpu* && \
    rm -f /etc/ld.so.conf.d/20-amdgpu.conf /etc/profile.d/amdgpu-pkg-config.sh && \
    mkdir -p ${ROCM_HOME} && \
    tar -xf /tmp/rocm-${GPU_TYPE}.tar.gz -C ${ROCM_HOME} && \
    rm -f /tmp/rocm-${GPU_TYPE}.tar.gz && \
    find ${ROCM_HOME} -name '*.pc' -path '*rocm_sysdeps*' -print0 \
        | xargs -0 --no-run-if-empty sed -i -E 's#/[^ =]*/stage/lib/rocm_sysdeps#${pcfiledir}/../..#g' && \
    printf "${ROCM_HOME}/lib\n${ROCM_HOME}/lib/llvm/lib\n${ROCM_HOME}/lib/llvm/lib/%s\n${ROCM_HOME}/lib/rocm_sysdeps/lib\n" \
       "$(${ROCM_HOME}/lib/llvm/bin/amdclang --print-target-triple)" > /etc/ld.so.conf.d/rocm.conf && \
    ldconfig
