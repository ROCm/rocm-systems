#!/bin/bash

set -e

INSTALL_PATH=@CPACK_PACKAGING_INSTALL_PREFIX@
ICD_INSTALL_PATH=@OPENCL_ICD_INSTALL_PATH@
ICD_SYSTEM_PATH=/@CMAKE_INSTALL_SYSCONFDIR@/OpenCL/vendors/@OPENCL_ICD_SYSTEM_FILE@

do_ldconfig() {
  echo ${INSTALL_PATH}/@CMAKE_INSTALL_LIBDIR@/@AMDOCL_INSTALL_LIBDIR@ > /@CMAKE_INSTALL_SYSCONFDIR@/ld.so.conf.d/10-rocm-opencl.conf && ldconfig

  mkdir -p "$(dirname "${ICD_SYSTEM_PATH}")"
  ln -sfn "${ICD_INSTALL_PATH}" "${ICD_SYSTEM_PATH}"

}

case "$1" in
  abort-deconfigure|abort-remove|abort-upgrade)
    echo "$1"
  ;;
  configure)
    do_ldconfig
  ;;
  *)
    exit 0
  ;;
esac
