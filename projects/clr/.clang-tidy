# Incremental clang-tidy adoption.
#
# Coverage is opt-in per file: only paths listed in clang-tidy-files.txt are
# linted (see the `clang-tidy` target in the top-level CMakeLists.txt). This
# file controls *which checks* run on those files.
#
# HeaderFilterRegex is set to a pattern that matches no header path, so only
# the main translation unit is diagnosed. This keeps third-party headers
# (Khronos OpenCL, etc.) and shared first-party headers silent while coverage
# is still being rolled out file by file.
---
Checks: >
  -*,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  cppcoreguidelines-init-variables,
  misc-const-correctness,
  misc-unused-using-decls,
  misc-redundant-expression,
  misc-unused-parameters,
  misc-static-assert,
  misc-redundant-expression,
  misc-override-with-different-visibility,
  misc-include-cleaner,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  readability-identifier-naming,
  readability-misleading-indentation,
  performance-for-range-copy,
  performance-implicit-conversion-in-loop,
  performance-move-const-arg,
  performance-faster-string-find,
  performance-trivially-destructible,
  performance-inefficient-vector-operation,
  performance-unnecessary-copy-initialization,
  performance-noexcept-move-constructor,
  performance-type-promotion-in-math-fn,
  modernize-use-override,
  modernize-use-equals-default,
  modernize-use-nullptr,
WarningsAsErrors: '*'
HeaderFilterRegex: '^$'
FormatStyle: file

# readability-identifier-naming, configured to the Google C++ Style Guide:
#   https://google.github.io/styleguide/cppguide.html#Naming
#
# Kinds that are deliberately left unconfigured fall through to a more general
# kind, which is how a few Google rules get expressed:
#   - LocalConstant/Constant/ConstantParameter are unset so a local `const T x`
#     falls through to LocalVariable/Parameter (lower_case). Only constants with
#     program lifetime (global/static/class/constexpr) take the `k` prefix.
#   - PublicMemberSuffix is empty so struct data members stay suffix-free, while
#     private/protected class members keep the trailing underscore.
CheckOptions:
  # Types
  readability-identifier-naming.AbstractClassCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase

  # Template parameters
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.TemplateTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterPrefix: k

  # Functions
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.GlobalFunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.ConstexprFunctionCase: CamelCase
  readability-identifier-naming.ConstexprMethodCase: CamelCase

  # Variables and parameters
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.StaticVariableCase: lower_case
  readability-identifier-naming.GlobalVariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.ParameterPackCase: lower_case

  # Data members: trailing underscore on class members, none on struct members
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.ClassMemberCase: lower_case
  readability-identifier-naming.ClassMemberSuffix: _
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.PublicMemberCase: lower_case
  readability-identifier-naming.PublicMemberSuffix: ''

  # Constants with program lifetime
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.ScopedEnumConstantCase: CamelCase
  readability-identifier-naming.ScopedEnumConstantPrefix: k

  # Namespaces and macros
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.InlineNamespaceCase: lower_case
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE

  readability-identifier-naming.IgnoreMainLikeFunctions: true
