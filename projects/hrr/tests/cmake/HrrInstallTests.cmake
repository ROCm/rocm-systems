# Install the CPU-only HRR test binaries as a relocatable ctest tree, so a
# packaged SDK (a TheRock test artifact) can run them without the build tree:
#
#   ctest --test-dir <prefix>/share/hrr/test -L cpu-only
#
# The tree holds the test binaries and one CTestTestfile.cmake that locates
# itself and, when <prefix>/bin/hrr-playback exists, points the tests at it
# through HRR_PLAYBACK_BIN (read by hrr_playback_bin() in
# tests/include/hrr_test_common.hh).
# The GPU integration suite and the Python generator-rules test are not
# installed: they need a GPU or the source tree.

include_guard(GLOBAL)

set(HRR_TEST_INSTALL_DIR "share/hrr/test")

set(_hrr_installed_targets)
string(CONCAT _hrr_testfile_text
  "# HRR CPU-only tests, relocatable. Generated by HrrInstallTests.cmake.\n"
  "get_filename_component(_hrr_test_dir \"\${CMAKE_CURRENT_LIST_FILE}\" REALPATH)\n"
  "get_filename_component(_hrr_test_dir \"\${_hrr_test_dir}\" DIRECTORY)\n"
  "get_filename_component(_hrr_prefix \"\${_hrr_test_dir}/../../..\" REALPATH)\n")

foreach(_t hrr-unit-tests hrr-handler-tests)
  if(TARGET ${_t})
    list(APPEND _hrr_installed_targets ${_t})
    # Point the tests at <prefix>/bin/hrr-playback only when the install has one.
    # Without it (HRR_BUILD_PLAYBACK=OFF) the tests keep their lookup of
    # hrr-playback on PATH, as in the build tree.
    string(APPEND _hrr_testfile_text
      "add_test(${_t} \"\${_hrr_test_dir}/${_t}\")\n"
      "set(_hrr_env)\n"
      "if(EXISTS \"\${_hrr_prefix}/bin/hrr-playback\")\n"
      "  list(APPEND _hrr_env \"HRR_PLAYBACK_BIN=\${_hrr_prefix}/bin/hrr-playback\")\n"
      "endif()\n"
      "set_tests_properties(${_t} PROPERTIES LABELS \"cpu-only\"\n"
      "  ENVIRONMENT \"\${_hrr_env}\")\n")
  endif()
endforeach()

if(NOT _hrr_installed_targets)
  return()
endif()

install(TARGETS ${_hrr_installed_targets}
  RUNTIME DESTINATION "${HRR_TEST_INSTALL_DIR}" COMPONENT tests)

file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/hrr_install_CTestTestfile.cmake"
  CONTENT "${_hrr_testfile_text}")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/hrr_install_CTestTestfile.cmake"
  DESTINATION "${HRR_TEST_INSTALL_DIR}" COMPONENT tests
  RENAME "CTestTestfile.cmake")
