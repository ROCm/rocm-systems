# Site config template for scripts/run_metric_health_test_report_local_driver.sh.
# Copy to scripts/.metric_health_sites.env (gitignored) and fill in the values
# for the sites you use. Variables already exported in the environment win
# over the file. Never put REMOTE_PASS here; export it in the shell instead.

# gfx1151: ssh with a password.
GFX1151_HOST=
GFX1151_PROXY=
GFX1151_REMOTE_USER=
GFX1151_REMOTE_ROOT=
GFX1151_THEROCK=
GFX1151_REMOTE_LOG_DIR=

# gfx942: ssh with a key. GFX942_REMOTE_USER defaults to the local user.
GFX942_HOST=
GFX942_PROXY=
GFX942_REMOTE_USER=
GFX942_REMOTE_ROOT=
GFX942_THEROCK=
GFX942_REMOTE_LOG_DIR=
GFX942_ROCR_VISIBLE_DEVICES=

# Slurm sites (gfx908, gfx950, gfx90a) behind one login host.
# SLURM_REMOTE_ROOT defaults to ${SLURM_REMOTE_HOME}/rocprofiler-compute.
SLURM_HOST_LOGIN=
SLURM_PARTITION=
SLURM_REMOTE_HOME=
SLURM_REMOTE_ROOT=
GFX908_NODE=
GFX908_GRES=
GFX950_NODE=
GFX950_GRES=
GFX90A_NODE=
GFX90A_GRES=
