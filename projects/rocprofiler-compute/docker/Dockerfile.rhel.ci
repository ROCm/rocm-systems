ARG DISTRO=rockylinux
ARG VERSION=8
FROM ${DISTRO}:${VERSION}

# Re-declare so VERSION is accessible in RUN commands (ARGs before FROM go out of scope after FROM)
ARG VERSION

ENV HOME=/root
ENV SHELL=/bin/bash
ENV BASH_ENV=/etc/bash.bashrc
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /tmp
SHELL [ "/bin/bash", "-c" ]

ENV PATH=/usr/local/bin:${PATH}

ARG EXTRA_PACKAGES=""

RUN yum groupinstall -y "Development Tools" && \
    yum install -y epel-release && \
    yum install -y --allowerasing curl dpkg-devel python3-pyyaml python3.11 python3.11-pip wget zlib-devel which git && \
    yum clean all && \
    alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 2 && \
    alternatives --set python3 /usr/bin/python3.11 && \
    python3.11 -m pip install --upgrade pip && \
    python3.11 -m pip install 'cmake==3.21' && \
    MAJOR_VERSION=$(echo ${VERSION} | cut -d. -f1) && \
    if [ "$MAJOR_VERSION" = "8" ]; then \
        yum install -y gcc-toolset-12-gcc gcc-toolset-12-gcc-c++ && \
        ln -sf /opt/rh/gcc-toolset-12/root/usr/bin/gcc /usr/local/bin/gcc && \
        ln -sf /opt/rh/gcc-toolset-12/root/usr/bin/g++ /usr/local/bin/g++; \
    fi

# The Rock Tarball
ARG GPU_TYPE=""
RUN if [ -n "${GPU_TYPE}" ]; then \
        TARBALL=$(curl -fsSL "https://nightly.repo.amd.com/rocm/core/tarball/" | \
            grep -oE "\"name\": \"therock-dist-linux-${GPU_TYPE}-[^\"]+\", \"mtime\": [0-9.]+" | \
            sort -t' ' -k4 -g | \
            tail -1 | \
            sed 's/.*"name": "\([^"]*\)".*/\1/'); \
        test -n "${TARBALL}" || { echo "Error: no therock-dist-linux-${GPU_TYPE}-* tarball found" >&2; exit 1; }; \
        VERSION=$(echo "${TARBALL}" | sed -nE 's/.*([0-9]+\.[0-9]+\.[0-9]+).*/\1/p'); \
        test -n "${VERSION}" || { echo "Error: could not extract version from '${TARBALL}'" >&2; exit 1; }; \
        curl -fSL "https://nightly.repo.amd.com/rocm/core/tarball/${TARBALL}" \
            -o "/opt/rocm-${VERSION}-${GPU_TYPE}.tar.gz"; \
    fi

WORKDIR /home
SHELL [ "/bin/bash", "--login", "-c" ]
