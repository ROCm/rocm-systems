ARG DISTRO=opensuse/leap
ARG VERSION=15.5
FROM ${DISTRO}:${VERSION}

ENV HOME=/root
ENV SHELL=/bin/bash
ENV BASH_ENV=/etc/bash.bashrc
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /tmp
SHELL [ "/bin/bash", "-c" ]

ENV PATH=/usr/local/bin:${PATH}

ARG EXTRA_PACKAGES=""
ARG ELFUTILS_DOWNLOAD_VERSION="0.188"
ARG NJOBS="8"

ARG LIBIBERTY_STAGING_DIR="/opt/rocprofiler-systems-deps"

RUN set +e; \
    zypper --non-interactive -i --gpg-auto-import-keys refresh; \
    zypper --non-interactive -i patch; \
    zypper --non-interactive -i patch; \
    zypper --non-interactive -i --gpg-auto-import-keys refresh; \
    exit 0

RUN zypper --non-interactive update -y && \
    zypper --non-interactive dist-upgrade -y && \
    zypper --non-interactive install -y -t pattern devel_basis && \
    zypper --non-interactive install -y ccache chrpath cmake curl dpkg-devel \
        gcc-c++ gcc-fortran git gmock gtest iproute2 ninja nlohmann_json-devel \
        openmpi3-devel papi-devel python3-devel python3-pip rpm-build \
        sqlite3-devel vim wget libucp-devel libuct-devel && \
    zypper --non-interactive clean --all && \
    python3 -m pip install --upgrade pip && \
    python3 -m pip install 'cmake==3.25' perfetto

# Pre-stage the binutils source tarball so ROCPROFSYS_BUILD_LIBIBERTY=ON builds
# libiberty from a local copy at CI job time instead of hitting the GNU mirrors
# on every run (see cmake/DyninstLibIberty.cmake's DYNINST_BINUTILS_DOWNLOAD_URL).
# openSUSE's binutils-devel doesn't reliably ship libiberty.a, so this project
# builds libiberty from source on this distro rather than relying on a package.
# The version comes from cmake/binutils_version.txt — the single source of
# truth also read by DyninstLibIberty.cmake — so the two never drift apart.
COPY cmake/binutils_version.txt /tmp/binutils_version.txt
RUN BINUTILS_VERSION="$(cat /tmp/binutils_version.txt)" && \
    mkdir -p "${LIBIBERTY_STAGING_DIR}" && \
    (curl -fSL "https://ftpmirror.gnu.org/gnu/binutils/binutils-${BINUTILS_VERSION}.tar.gz" \
        -o "${LIBIBERTY_STAGING_DIR}/binutils-libiberty-src.tar.gz" || \
     curl -fSL "https://mirrors.kernel.org/sourceware/binutils/releases/binutils-${BINUTILS_VERSION}.tar.gz" \
        -o "${LIBIBERTY_STAGING_DIR}/binutils-libiberty-src.tar.gz")

ARG PYTHON_VERSIONS="8 9 10 11 12 13"

# Install pytest test dependencies into each conda env
COPY requirements.txt /tmp/requirements.txt
RUN wget https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O miniforge.sh && \
    bash miniforge.sh -b -p /opt/conda && \
    export PATH="/opt/conda/bin:${PATH}" && \
    conda config --set always_yes yes --set changeps1 no --set solver classic && \
    conda update -c conda-forge -n base conda && \
    for i in ${PYTHON_VERSIONS}; do \
        conda create -n py3.${i} -c conda-forge python=3.${i} pip && \
        /opt/conda/envs/py3.${i}/bin/python -m pip install -r /tmp/requirements.txt; \
    done && \
    conda clean -a -y

# Install pytest test dependencies for system python
RUN if python3 -c "import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)"; then \
        python3 -m pip install -r /tmp/requirements.txt; \
    else \
        echo "Skipping system Python install: $(python3 --version 2>&1) is too old (rocprofiler-systems test suite requires >=3.8)"; \
    fi && \
    rm -f /tmp/requirements.txt

# The Rock Tarball
ARG GPU_TYPE=""
RUN if [ -n "${GPU_TYPE}" ]; then \
        TARBALL=$(curl -fsSL "https://nightly.repo.amd.com/rocm/core/tarball/" | \
            grep -oE "\"name\": \"therock-dist-linux-${GPU_TYPE}-[^\"]+\", \"mtime\": [0-9.]+" | \
            sort -t' ' -k4 -g | \
            tail -1 | \
            sed 's/.*"name": "\([^"]*\)".*/\1/'); \
        test -n "${TARBALL}" || { echo "Error: no therock-dist-linux-${GPU_TYPE}-* tarball found" >&2; exit 1; }; \
        VERSION=$(echo "${TARBALL}" | sed -nE 's/.*([0-9]+\.[0-9]+\.[0-9]+).*/\1/p'); \
        test -n "${VERSION}" || { echo "Error: could not extract version from '${TARBALL}'" >&2; exit 1; }; \
        curl -fSL "https://nightly.repo.amd.com/rocm/core/tarball/${TARBALL}" \
            -o "/opt/rocm-${VERSION}-${GPU_TYPE}.tar.gz"; \
    fi

WORKDIR /home
SHELL [ "/bin/bash", "--login", "-c" ]
