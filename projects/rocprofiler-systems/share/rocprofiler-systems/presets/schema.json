{
    "advanced": {
        "collapse_threads": {
            "description": "Collapse thread data into process-level view",
            "enabled": false
        },
        "cpu_affinity": {
            "description": "Enable CPU affinity tracking",
            "enabled": false
        },
        "cpu_freq": {
            "description": "Enable CPU frequency monitoring",
            "enabled": false
        },
        "debug": {
            "description": "Enable debug output",
            "enabled": false
        },
        "description": "Advanced configuration options",
        "max_depth": {
            "description": "Maximum call stack depth to record",
            "value": 65535
        },
        "network_interface": {
            "description": "Network interface for distributed profiling",
            "examples": [
                "eth0",
                "ib0"
            ],
            "value": ""
        },
        "signal_handler": {
            "description": "Enable signal handler for graceful termination",
            "enabled": true
        },
        "timemory_components": {
            "description": "Timemory components to enable",
            "examples": [
                "wall_clock",
                "cpu_clock",
                "peak_rss",
                "page_rss"
            ],
            "value": [
                "wall_clock"
            ]
        },
        "trace_delay_sec": {
            "description": "Delay before starting trace collection",
            "unit": "seconds",
            "value": 0
        },
        "trace_duration_sec": {
            "description": "Duration of trace collection (0 = until end)",
            "unit": "seconds",
            "value": 0
        },
        "trace_periods": {
            "description": "Periodic trace collection intervals",
            "examples": [
                "1:5",
                "0:10,20:30"
            ],
            "note": "Format: start:stop or start1:stop1,start2:stop2,...",
            "value": ""
        },
        "verbose": {
            "description": "Verbosity level (0=quiet, 1=info, 2=debug)",
            "typical_range": [
                0,
                3
            ],
            "value": 0
        }
    },
    "causal": {
        "backend": {
            "description": "Causal profiling backend",
            "options": {
                "auto": {
                    "description": "Automatically select best available backend"
                },
                "perf": {
                    "description": "Use Linux perf events"
                },
                "timer": {
                    "description": "Use timer-based sampling"
                }
            },
            "value": "auto"
        },
        "binary_scope": {
            "description": "Binary scope for causal profiling",
            "examples": [
                "%MAIN%",
                "libfoo.so",
                "myapp"
            ],
            "value": "%MAIN%"
        },
        "delay_sec": {
            "description": "Delay before starting causal profiling",
            "unit": "seconds",
            "value": 0
        },
        "description": "Causal profiling for identifying optimization opportunities",
        "duration_sec": {
            "description": "Duration of causal profiling (0 = until end)",
            "unit": "seconds",
            "value": 0
        },
        "enabled": false,
        "end_to_end": {
            "description": "Enable end-to-end causal profiling",
            "enabled": false
        },
        "function_scope": {
            "description": "Function scope regex for causal profiling",
            "examples": [
                "compute_*",
                "kernel_*"
            ],
            "value": ""
        },
        "mode": {
            "description": "Causal profiling mode",
            "options": {
                "function": {
                    "description": "Profile at function granularity"
                },
                "line": {
                    "description": "Profile at source line granularity"
                }
            },
            "value": "function"
        },
        "source_scope": {
            "description": "Source file scope regex for causal profiling",
            "examples": [
                "*.cpp",
                "src/*.c"
            ],
            "value": ""
        }
    },
    "domains": {
        "cpu": {
            "description": "CPU profiling domain",
            "enabled": false,
            "metrics": {
                "freq": {
                    "category": "performance",
                    "description": "CPU frequency monitoring",
                    "enabled": false,
                    "per_core": true,
                    "unit": "MHz"
                },
                "utilization": {
                    "category": "utilization",
                    "description": "CPU utilization percentage",
                    "enabled": false,
                    "per_core": true,
                    "typical_range": [
                        0,
                        100
                    ],
                    "unit": "%"
                }
            }
        },
        "gpu": {
            "description": "AMD GPU profiling domain",
            "enabled": false,
            "metrics": {
                "busy": {
                    "category": "utilization",
                    "description": "GPU utilization percentage",
                    "enabled": false,
                    "typical_range": [
                        0,
                        100
                    ],
                    "unit": "%"
                },
                "fan_speed": {
                    "category": "thermal",
                    "description": "GPU fan speed",
                    "enabled": false,
                    "unit": "RPM"
                },
                "mem_usage": {
                    "category": "memory",
                    "description": "GPU memory usage",
                    "enabled": false,
                    "unit": "bytes"
                },
                "pcie_throughput": {
                    "category": "bandwidth",
                    "description": "PCIe data transfer rates",
                    "enabled": false,
                    "unit": "bytes/sec"
                },
                "power": {
                    "category": "power",
                    "description": "GPU power consumption in Watts",
                    "enabled": false,
                    "unit": "W"
                },
                "temp": {
                    "category": "thermal",
                    "critical_threshold": 105,
                    "description": "GPU temperature in Celsius",
                    "enabled": false,
                    "typical_range": [
                        20,
                        110
                    ],
                    "unit": "C",
                    "warning_threshold": 95
                }
            },
            "sampling_rate_hz": {
                "description": "Metric sampling frequency",
                "typical_range": [
                    1,
                    100
                ],
                "unit": "Hz",
                "value": 1
            }
        },
        "parallel": {
            "description": "Parallel runtime tracing",
            "enabled": false,
            "runtimes": {
                "kokkos": {
                    "category": "performance_portability",
                    "description": "Kokkos performance portability tracing",
                    "enabled": false,
                    "requires": "Kokkos with profiling hooks"
                },
                "mpi": {
                    "category": "distributed",
                    "description": "MPI communication tracing",
                    "enabled": false,
                    "requires": "MPI library",
                    "traced_ops": [
                        "MPI_Send",
                        "MPI_Recv",
                        "MPI_Allreduce",
                        "MPI_Barrier"
                    ]
                },
                "openmp": {
                    "category": "threading",
                    "description": "OpenMP runtime tracing via OMPT",
                    "enabled": false,
                    "requires": "OpenMP 5.0+ runtime with OMPT support",
                    "traced_constructs": [
                        "parallel",
                        "for",
                        "task",
                        "target"
                    ]
                },
                "rccl": {
                    "category": "distributed",
                    "description": "RCCL collective communication tracing",
                    "enabled": false,
                    "requires": "RCCL library"
                },
                "shmem": {
                    "category": "distributed",
                    "description": "OpenSHMEM communication tracing",
                    "enabled": false,
                    "requires": "ROC-SHMEM library"
                }
            }
        },
        "rocm": {
            "api_domains": {
                "hip_compiler_api": {
                    "category": "compiler_api",
                    "description": "HIP compiler API calls",
                    "enabled": false,
                    "examples": [
                        "hiprtcCompileProgram",
                        "hiprtcGetCode"
                    ]
                },
                "hip_runtime_api": {
                    "category": "runtime_api",
                    "description": "HIP runtime API calls",
                    "enabled": false,
                    "examples": [
                        "hipMalloc",
                        "hipMemcpy",
                        "hipLaunchKernel"
                    ]
                },
                "hsa_amd_ext_api": {
                    "category": "runtime_api",
                    "description": "HSA AMD extension API calls",
                    "enabled": false
                },
                "hsa_api": {
                    "category": "runtime_api",
                    "description": "HSA runtime API calls",
                    "enabled": false,
                    "examples": [
                        "hsa_init",
                        "hsa_signal_create",
                        "hsa_queue_create"
                    ]
                },
                "hsa_core_api": {
                    "category": "runtime_api",
                    "description": "HSA core API calls",
                    "enabled": false
                },
                "hsa_finalize_ext_api": {
                    "category": "runtime_api",
                    "description": "HSA finalize extension API calls",
                    "enabled": false
                },
                "hsa_image_ext_api": {
                    "category": "runtime_api",
                    "description": "HSA image extension API calls",
                    "enabled": false
                },
                "kernel_dispatch": {
                    "category": "execution",
                    "description": "GPU kernel dispatches",
                    "enabled": false,
                    "provides": [
                        "kernel_name",
                        "duration",
                        "grid_size",
                        "workgroup_size"
                    ]
                },
                "kfd_page_fault": {
                    "category": "memory",
                    "description": "KFD page fault events",
                    "enabled": false
                },
                "kfd_page_migrate": {
                    "category": "memory",
                    "description": "KFD page migration events",
                    "enabled": false
                },
                "kfd_queue": {
                    "category": "execution",
                    "description": "KFD queue events",
                    "enabled": false
                },
                "marker_api": {
                    "category": "annotation",
                    "description": "ROCTx user annotation markers",
                    "enabled": false,
                    "examples": [
                        "roctxRangePush",
                        "roctxRangePop",
                        "roctxMark"
                    ]
                },
                "memory_allocation": {
                    "category": "memory",
                    "description": "Memory allocation tracking",
                    "enabled": false
                },
                "memory_copy": {
                    "category": "memory",
                    "description": "Memory copy operations",
                    "enabled": false,
                    "provides": [
                        "src",
                        "dst",
                        "size",
                        "duration"
                    ]
                },
                "rccl_api": {
                    "category": "runtime_api",
                    "description": "RCCL collective communication API",
                    "enabled": false,
                    "examples": [
                        "ncclAllReduce",
                        "ncclBroadcast"
                    ],
                    "requires": "RCCL library"
                },
                "scratch_memory": {
                    "category": "memory",
                    "description": "Scratch memory allocations",
                    "enabled": false
                }
            },
            "description": "ROCm API tracing domain",
            "enabled": false,
            "group_by_queue": {
                "description": "Group GPU operations by hardware queue",
                "enabled": false
            }
        }
    },
    "hardware_counters": {
        "description": "Hardware performance counter collection",
        "enabled": false,
        "overflow_sampling": {
            "description": "Sample on hardware counter overflow",
            "enabled": false,
            "overflow_count": {
                "description": "Counter value at which to trigger overflow (0 = disabled)",
                "value": 0
            },
            "overflow_event": {
                "description": "Event to use for overflow-based sampling",
                "value": "perf::PERF_COUNT_HW_CACHE_REFERENCES"
            }
        },
        "papi_events": {
            "description": "PAPI/CPU hardware performance counters to collect",
            "examples": [
                "PAPI_TOT_CYC",
                "PAPI_TOT_INS",
                "PAPI_L1_DCM",
                "PAPI_L2_DCM"
            ],
            "note": "Use 'rocprof-sys-avail --hw-counters' to list available counters",
            "requires": "PAPI library and perf_event_paranoid <= 2",
            "value": []
        },
        "papi_multiplexing": {
            "description": "Enable PAPI counter multiplexing for more counters than hardware supports",
            "enabled": false
        },
        "rocm_events": {
            "description": "ROCm/GPU hardware performance counters to collect",
            "examples": [
                "VALUUtilization",
                "Occupancy",
                "MemUnitBusy",
                "L2CacheHit"
            ],
            "note": "Use 'rocprof-sys-avail --hw-counters' to list available counters",
            "value": []
        }
    },
    "metadata": {
        "description": "ROCProfiler-Systems configuration schema",
        "name": "rocprofsys-config-schema",
        "schema_version": "1.0",
        "tool_version": "2.0.0"
    },
    "output": {
        "description": "Output configuration",
        "file_output": {
            "description": "Write output to files",
            "enabled": true
        },
        "format": {
            "description": "Trace format",
            "options": {
                "json": {
                    "benefits": [
                        "Human-readable",
                        "Easy to parse"
                    ],
                    "description": "JSON trace format",
                    "file_extension": ".json"
                },
                "perfetto": {
                    "benefits": [
                        "Timeline visualization",
                        "SQL querying",
                        "Industry standard"
                    ],
                    "description": "Perfetto protobuf trace format",
                    "file_extension": ".proto",
                    "viewer": "https://ui.perfetto.dev"
                }
            },
            "value": "perfetto"
        },
        "path": {
            "default": "rocprof-sys-output",
            "description": "Output directory",
            "value": "rocprof-sys-output"
        },
        "rocpd_output": {
            "description": "Generate RocPD SQLite3 database output format",
            "enabled": false
        },
        "time_output": {
            "description": "Include timestamps in output filenames",
            "enabled": true
        }
    },
    "profiling": {
        "description": "Call-stack profile output configuration",
        "enabled": false,
        "flat_profile": {
            "description": "Generate flat profile (no call hierarchy)",
            "enabled": false
        }
    },
    "sampling": {
        "cpus": {
            "description": "CPUs to sample",
            "examples": [
                "all",
                "0-3",
                "0,2,4",
                "none"
            ],
            "value": "all"
        },
        "delay_sec": {
            "description": "Delay before starting sampling",
            "unit": "seconds",
            "value": 0.0
        },
        "description": "Call-stack sampling configuration",
        "duration_sec": {
            "description": "Sampling duration (0 = until end)",
            "unit": "seconds",
            "value": 0.0
        },
        "enabled": false,
        "frequency_hz": {
            "description": "Sampling frequency",
            "note": "Higher values increase overhead but improve resolution",
            "recommended_range": [
                10,
                100
            ],
            "typical_range": [
                1,
                1000
            ],
            "unit": "Hz",
            "value": 100
        },
        "gpus": {
            "description": "GPUs to sample (inherits from HIP_VISIBLE_DEVICES if empty)",
            "examples": [
                "0",
                "0-1",
                "0,2"
            ],
            "value": ""
        },
        "timer": {
            "description": "Timer type for sampling",
            "options": {
                "cputime": {
                    "description": "Sample based on CPU time consumed",
                    "recommended_for": "CPU-bound workloads"
                },
                "realtime": {
                    "description": "Sample based on wall-clock time",
                    "recommended_for": "I/O-bound or mixed workloads"
                }
            },
            "value": "cputime"
        }
    },
    "tracing": {
        "buffer_size_kb": {
            "description": "Trace buffer size",
            "typical_range": [
                1024,
                4194304
            ],
            "unit": "KB",
            "value": 1048576
        },
        "description": "Perfetto trace output configuration",
        "enabled": true,
        "fill_policy": {
            "description": "Buffer fill policy when full",
            "options": {
                "discard": {
                    "description": "Discard new events when buffer is full"
                },
                "ring_buffer": {
                    "description": "Overwrite oldest events when buffer is full"
                }
            },
            "value": "discard"
        }
    }
}
