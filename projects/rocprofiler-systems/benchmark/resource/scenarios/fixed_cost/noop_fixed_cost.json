{
    "reference": "workload",
    "run": {
        "clean": [
            "/tmp/rocprofsys-bench-noop_fixed_cost"
        ],
        "mode": "medium",
        "output": "../../results/fixed_cost/noop_fixed_cost.json",
        "runs": 150
    },
    "tools": [
        {
            "name": "all_off",
            "tool": "rocprof-sys-run",
            "tool_env": [
                {
                    "key": "ROCPROFSYS_CONFIG_FILE",
                    "value": "../../configs/all_off.cfg"
                },
                {
                    "key": "ROCPROFSYS_USE_MPI",
                    "value": "false"
                },
                {
                    "key": "ROCPROFSYS_OUTPUT_PATH",
                    "value": "/tmp/rocprofsys-bench-noop_fixed_cost"
                }
            ]
        },
        {
            "name": "trace_only",
            "tool": "rocprof-sys-run",
            "tool_env": [
                {
                    "key": "ROCPROFSYS_CONFIG_FILE",
                    "value": "../../configs/trace_only.cfg"
                },
                {
                    "key": "ROCPROFSYS_USE_MPI",
                    "value": "false"
                },
                {
                    "key": "ROCPROFSYS_ROCM_DOMAINS",
                    "value": ""
                },
                {
                    "key": "ROCPROFSYS_OUTPUT_PATH",
                    "value": "/tmp/rocprofsys-bench-noop_fixed_cost"
                }
            ]
        },
        {
            "name": "sampling_300",
            "tool": "rocprof-sys-run",
            "tool_env": [
                {
                    "key": "ROCPROFSYS_CONFIG_FILE",
                    "value": "../../configs/sampling_perfetto.cfg"
                },
                {
                    "key": "ROCPROFSYS_USE_MPI",
                    "value": "false"
                },
                {
                    "key": "ROCPROFSYS_OUTPUT_PATH",
                    "value": "/tmp/rocprofsys-bench-noop_fixed_cost"
                }
            ]
        },
        {
            "name": "all_on",
            "tool": "rocprof-sys-run",
            "tool_env": [
                {
                    "key": "ROCPROFSYS_CONFIG_FILE",
                    "value": "../../configs/all_on.cfg"
                },
                {
                    "key": "ROCPROFSYS_ROCM_DOMAINS",
                    "value": "hip_api,hip_compiler_api,hip_compiler_api_ext,hip_event,hip_graph,hip_runtime_api,hip_runtime_api_ext,hip_stream,hipfile_api,hipfile_api_ext,hsa_amd_ext_api,hsa_api,hsa_core_api,hsa_finalize_ext_api,hsa_image_ext_api,kernel_dispatch,kernel_replay,kfd_event_dropped_events,kfd_event_page_fault,kfd_event_page_migrate,kfd_event_queue,kfd_event_unmap_from_gpu,kfd_events,kfd_page_fault,kfd_page_migrate,kfd_queue,marker_api,marker_core_range_api,memory_allocation,memory_copy,ompt,rccl_api,rocdecode_api,rocdecode_api_ext,rocjpeg_api,rocshmem_api,rocshmem_api_ext,roctx,runtime_initialization,scratch_memory"
                },
                {
                    "key": "ROCPROFSYS_OUTPUT_PATH",
                    "value": "/tmp/rocprofsys-bench-noop_fixed_cost"
                }
            ]
        }
    ],
    "workload": "../../../build/noop"
}
