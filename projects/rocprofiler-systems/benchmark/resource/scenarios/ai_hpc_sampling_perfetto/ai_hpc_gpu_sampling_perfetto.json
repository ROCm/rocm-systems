{
    "reference": "workload",
    "run": {
        "clean": [
            "/tmp/rocprofsys-bench-ai_hpc_gpu_sampling_perfetto"
        ],
        "mode": "medium",
        "output": "../../results/ai_hpc_sampling_perfetto/ai_hpc_gpu_sampling_perfetto.json",
        "runs": 150
    },
    "tools": [
        {
            "name": "sampling_perfetto",
            "tool": "rocprof-sys-run",
            "tool_env": [
                {
                    "key": "ROCPROFSYS_CONFIG_FILE",
                    "value": "../../configs/sampling_perfetto.cfg"
                },
                {
                    "key": "ROCPROFSYS_USE_MPI",
                    "value": "false"
                },
                {
                    "key": "ROCPROFSYS_OUTPUT_PATH",
                    "value": "/tmp/rocprofsys-bench-ai_hpc_gpu_sampling_perfetto"
                }
            ]
        }
    ],
    "workload": "../../../build/ai_hpc_gpu",
    "workload_arguments": [
        {
            "arg_name": "--size",
            "value": "2048"
        },
        {
            "arg_name": "--iters",
            "value": "8"
        },
        {
            "arg_name": "--depth",
            "value": "128"
        },
        {
            "arg_name": "--threads",
            "value": "4"
        }
    ]
}
