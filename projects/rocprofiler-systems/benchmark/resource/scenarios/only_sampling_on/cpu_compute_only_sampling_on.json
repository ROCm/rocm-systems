{
    "reference": "workload",
    "run": {
        "clean": [
            "/tmp/rocprofsys-bench-cpu_compute_only_sampling_on"
        ],
        "mode": "medium",
        "output": "../../results/only_sampling_on/cpu_compute_only_sampling_on.json",
        "runs": 150
    },
    "tools": [
        {
            "name": "only_sampling_on",
            "tool": "rocprof-sys-run",
            "tool_env": [
                {
                    "key": "ROCPROFSYS_CONFIG_FILE",
                    "value": "../../configs/only_sampling_on.cfg"
                },
                {
                    "key": "ROCPROFSYS_USE_MPI",
                    "value": "false"
                },
                {
                    "key": "ROCPROFSYS_OUTPUT_PATH",
                    "value": "/tmp/rocprofsys-bench-cpu_compute_only_sampling_on"
                }
            ]
        }
    ],
    "workload": "../../../build/cpu_compute"
}
