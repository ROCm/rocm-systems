set -e

src_path=$(dirname "$(realpath $0)")/../../
if [[ "${ASAN}" == true ]]; then
    export HSA_XNACK=1
fi

# Set RESOURCE_USAGE=ON to have the compiler emit per-kernel VGPR/SGPR/AGPR/
# scratch/LDS usage and occupancy remarks (via -Rpass-analysis=kernel-resource-usage)
# for every device kernel built in this tree.
if [[ "${RESOURCE_USAGE}" == "ON" ]]; then
    export CXXFLAGS="${CXXFLAGS} -Rpass-analysis=kernel-resource-usage"
fi

cmake \
    -DBUILD_CODE_COVERAGE=${CODE_COV:-OFF} \
    -DCMAKE_BUILD_TYPE=${BUILD_TYPE:-Release} \
    -DCMAKE_INSTALL_PREFIX=${INSTALL_PREFIX:-~/rocshmem} \
    -DCMAKE_VERBOSE_MAKEFILE=OFF \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DCMAKE_CXX_FLAGS="${CXXFLAGS:-}" \
    -DBUILD_FUNCTIONAL_TESTS=ON \
    -DBUILD_UNIT_TESTS=ON \
    -DBUILD_EXAMPLES=ON \
    -DBUILD_PYTHON_TESTS=ON \
    -DBUILD_CTESTS=ON \
    -DPROFILE=OFF \
    -DUSE_GDA=OFF \
    -DUSE_RO=OFF \
    -DUSE_IPC=ON \
    -DUSE_THREADS=OFF \
    -DUSE_WF_COAL=OFF \
    -DUSE_HDP_FLUSH=OFF \
    -DUSE_HDP_FLUSH_HOST_SIDE=OFF \
    -DUSE_SINGLE_NODE=ON \
    -DASAN=${ASAN:-OFF} \
    $* $src_path
if [[ "${RESOURCE_USAGE}" == "ON" ]]; then
    cmake --build . --parallel 8 2>&1 | tee resource_usage.log
    grep -B1 -A9 "Function Name:" resource_usage.log > resource_usage_summary.log || true
    echo "Per-kernel resource usage written to $(pwd)/resource_usage_summary.log"
else
    cmake --build . --parallel 8
fi
cmake --install .
