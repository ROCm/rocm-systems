// rocSHMEM build dependency graph (compact)
// Auto-generated by scripts/analysis/build_time_report.py from build/.ninja_log
// and build/build.ninja -- do not hand-edit, re-run the script instead.
// HSACO-chain add_dependencies() gates: tests/functional_tests/all.

digraph rocshmem_build_compact {
  rankdir=TB; fontname="Helvetica"; labelloc="t";
  label=<<B>rocSHMEM build dependency graph (compact)</B><BR/><FONT POINT-SIZE="9">wall 346.6s -- generated from .ninja_log</FONT>>;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.12,0.06"];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];

  subgraph cluster_legend {
    label="Legend"; style=dashed; fontsize=9; rank=same;
    leg_config [label="configure / source", style="rounded,filled", fillcolor="#cfe2ff"];
    leg_parallel [label="parallel compile (TUs)", style="rounded,filled", fillcolor="#b2f2bb"];
    leg_serial [label="serial custom step
(clang/opt/lld)", style="rounded,filled", fillcolor="#ffd8a8"];
    leg_bottleneck [label="SERIAL bottleneck
(red border = critical path)", style="rounded,filled", fillcolor="#ffd8a8", color=red, penwidth=2];
    leg_link [label="whole-program
-fgpu-rdc link", style="rounded,filled", fillcolor="#ffa8a8"];
    leg_artifact [label="artifact / target / install
(dashed, no duration of its own)", style="rounded,filled,dashed", fillcolor="#e9ecef"];
    leg_gate [label="cross-target
dependency gate", style="filled,dashed", fillcolor="#fff3bf", color=red, penwidth=2, shape=note];
    leg_done [label="final build outcome", style="rounded,filled", fillcolor="#d0bfff", shape=doubleoctagon];
    leg_duration [label="measured\nduration (s)", shape=circle, fixedsize=false, width=0.7, height=0.7, fontsize=7, fillcolor="#fff9db", color="#f08c00", penwidth=1.5];
    leg_config -> leg_parallel -> leg_serial -> leg_bottleneck -> leg_link -> leg_artifact -> leg_gate -> leg_done -> leg_duration [style=invis];
  }

  cmake_configure [label="cmake configure", style="rounded,filled", fillcolor="#cfe2ff"];
  t_cmake_configure [label="9.18s", shape=circle, fixedsize=true, width=0.55, height=0.55, fontsize=8, fillcolor="#fff9db", color="#f08c00", penwidth=1.5];
  cmake_configure -> t_cmake_configure [style=dashed, arrowhead=none, color="#f08c00", constraint=false, weight=0];
  {rank=same; cmake_configure; t_cmake_configure;}
  bc_sources [label="BITCODE_SOURCES (18 files)", style="rounded,filled,dashed", fillcolor="#cfe2ff"];
  bc_compile [label="clang++ per-source bitcode compile", style="rounded,filled", fillcolor="#b2f2bb"];
  t_bc_compile [label="longest
2.9s", shape=circle, fixedsize=true, width=0.55, height=0.55, fontsize=8, fillcolor="#fff9db", color="#f08c00", penwidth=1.5];
  bc_compile -> t_bc_compile [style=dashed, arrowhead=none, color="#f08c00", constraint=false, weight=0];
  {rank=same; bc_compile; t_bc_compile;}
  bc_llvmlink [label="llvm-link -> unopt.bc", style="rounded,filled", fillcolor="#ffd8a8"];
  t_bc_llvmlink [label="0.9s", shape=circle, fixedsize=true, width=0.4, height=0.4, fontsize=7, fillcolor="#fff9db", color="#f08c00", penwidth=1.5];
  bc_llvmlink -> t_bc_llvmlink [style=dashed, arrowhead=none, color="#f08c00", constraint=false, weight=0];
  {rank=same; bc_llvmlink; t_bc_llvmlink;}
  bc_opt [label="opt -O3 librocshmem_device.bc -- SERIAL
t=7.4s -> 107.8s", style="rounded,filled", fillcolor="#ffd8a8", color=red, penwidth=2];
  t_bc_opt [label="100.4s", shape=circle, fixedsize=true, width=0.6, height=0.6, fontsize=9, fillcolor="#fff9db", color="red", penwidth=2];
  bc_opt -> t_bc_opt [style=dashed, arrowhead=none, color="red", constraint=false, weight=0];
  {rank=same; bc_opt; t_bc_opt;}
  bc_target [label="rocshmem_device_bitcode (ALL)", style="rounded,filled,dashed", fillcolor="#e9ecef"];
  cmake_configure -> bc_sources;
  bc_sources -> bc_compile;
  bc_compile -> bc_llvmlink;
  bc_llvmlink -> bc_opt;
  bc_opt -> bc_target;
  host_sources [label="56 host/device TU compiles
parallel", style="rounded,filled", fillcolor="#b2f2bb"];
  t_host_sources [label="141.2s
cpu-sum", shape=circle, fixedsize=true, width=0.6, height=0.6, fontsize=8, fillcolor="#fff9db", color="#f08c00", penwidth=1.5];
  host_sources -> t_host_sources [style=dashed, arrowhead=none, color="#f08c00", constraint=false, weight=0];
  {rank=same; host_sources; t_host_sources;}
  host_archive [label="librocshmem.a (-fgpu-rdc PUBLIC)", style="rounded,filled,dashed", fillcolor="#e9ecef"];
  cmake_configure -> host_sources;
  host_sources -> host_archive;
  project_dep_hack [label="add_dependencies(${PROJECT_NAME},
device_bitcode_tester_hsacos)
gates: tests/functional_tests/all", style="filled,dashed", fillcolor="#fff3bf", color=red, penwidth=2, shape=note];
  subgraph cluster_hsaco {
    label="device_bitcode_tester_hsacos (238.8s serial chain)";
    style="filled,dashed"; fillcolor="#fff5f5"; color=red; fontsize=10;
  kernel_hip [label="device_bitcode_tester_kernel.hip", style="rounded,filled,dashed", fillcolor="#cfe2ff"];
  kernel_compile [label="clang++ kernel compile", style="rounded,filled", fillcolor="#b2f2bb", color="#f08c00"];
  t_kernel_compile [label="0.3s", shape=circle, fixedsize=true, width=0.5, height=0.5, fontsize=7, fillcolor="#fff9db", color="#f08c00", penwidth=1];
  kernel_compile -> t_kernel_compile [style=dashed, arrowhead=none, color="#f08c00", constraint=false, weight=0];
  {rank=same; kernel_compile; t_kernel_compile;}
  kernel_unopt_link [label="llvm-link kernel+library", style="rounded,filled", fillcolor="#ffd8a8", color="#f08c00"];
  t_kernel_unopt_link [label="5.2s", shape=circle, fixedsize=true, width=0.5, height=0.5, fontsize=7, fillcolor="#fff9db", color="#f08c00", penwidth=1];
  kernel_unopt_link -> t_kernel_unopt_link [style=dashed, arrowhead=none, color="#f08c00", constraint=false, weight=0];
  {rank=same; kernel_unopt_link; t_kernel_unopt_link;}
  hsaco_lld [label="clang -x ir codegen+link -> .hsaco -- SERIAL
SERIAL, single-threaded", style="rounded,filled", fillcolor="#ffd8a8", color=red, penwidth=2];
  t_hsaco_lld [label="233.3s", shape=circle, fixedsize=true, width=0.6000000000000001, height=0.6000000000000001, fontsize=8, fillcolor="#fff9db", color="red", penwidth=2];
  hsaco_lld -> t_hsaco_lld [style=dashed, arrowhead=none, color="red", constraint=false, weight=0];
  {rank=same; hsaco_lld; t_hsaco_lld;}
  hsaco_target [label="device_bitcode_tester_hsacos (ALL)", style="rounded,filled,dashed", fillcolor="#e9ecef"];
  }
  kernel_hip -> kernel_compile;
  kernel_compile -> kernel_unopt_link;
  bc_opt -> kernel_unopt_link [color=red];
  kernel_unopt_link -> hsaco_lld;
  hsaco_lld -> hsaco_target;
  hsaco_target -> project_dep_hack [color=red, penwidth=2];
  subgraph cluster_examples {
    label="examples -- depend on librocshmem.a only
(NOT gated by HSACO chain)";
    fillcolor="#f8f9fa"; style=filled; fontsize=10;
  examples_link [label="11 targets (examples/*)", style="rounded,filled", fillcolor="#ffa8a8"];
  t_examples_link [label="1284.4s
cpu total", shape=circle, fixedsize=true, width=0.7, height=0.7, fontsize=8, fillcolor="#fff9db", color="red", penwidth=1.5];
  examples_link -> t_examples_link [style=dashed, arrowhead=none, color="red", constraint=false, weight=0];
  {rank=same; examples_link; t_examples_link;}
  }
  host_archive -> examples_link;
  subgraph cluster_consumers {
    label="independent links -- depend on librocshmem.a only
(NOT gated by HSACO chain)";
    fillcolor="#f8f9fa"; style=filled; fontsize=10;
  other_links [label="3 targets (tools/unit-tests/
rocprofiler-register)", style="rounded,filled", fillcolor="#ffa8a8"];
  t_other_links [label="349.0s
cpu total", shape=circle, fixedsize=true, width=0.7, height=0.7, fontsize=8, fillcolor="#fff9db", color="red", penwidth=1.5];
  other_links -> t_other_links [style=dashed, arrowhead=none, color="red", constraint=false, weight=0];
  {rank=same; other_links; t_other_links;}
  }
  host_archive -> other_links;
  subgraph cluster_functest {
    label="rocshmem_functional_tests";
    style="filled,dashed"; fillcolor="#fff5f5"; color=red; fontsize=10;
  functest_sources [label="36 functional-test source compiles
parallel", style="rounded,filled", fillcolor="#b2f2bb"];
  t_functest_sources [label="86.6s cpu
longest 28.4s", shape=circle, fixedsize=true, width=0.7, height=0.7, fontsize=8, fillcolor="#fff9db", color="#f08c00", penwidth=1.5];
  functest_sources -> t_functest_sources [style=dashed, arrowhead=none, color="#f08c00", constraint=false, weight=0];
  {rank=same; functest_sources; t_functest_sources;}
  functest_link [label="rocshmem_functional_tests (link)", style="rounded,filled", fillcolor="#ffa8a8", penwidth=2];
  t_functest_link [label="234.2s", shape=circle, fixedsize=true, width=0.65, height=0.65, fontsize=9, fillcolor="#fff9db", color="red", penwidth=2];
  functest_link -> t_functest_link [style=dashed, arrowhead=none, color="red", constraint=false, weight=0];
  {rank=same; functest_link; t_functest_link;}
  }

  functest_sources -> functest_link;
  hsaco_target -> functest_link [style=dashed, label="  HSACO used at runtime"];
  build_done [label="ninja build complete
wall 346.6s", style="rounded,filled", fillcolor="#d0bfff", shape=doubleoctagon];
  t_build_done [label="346.6s
wall", shape=circle, fixedsize=true, width=0.65, height=0.65, fontsize=8, fillcolor="#fff9db", color="#7048e8", penwidth=2];
  build_done -> t_build_done [style=dashed, arrowhead=none, color="#7048e8", constraint=false, weight=0];
  {rank=same; build_done; t_build_done;}
  functest_link -> build_done;
  other_links -> build_done;
  examples_link -> build_done;
  bc_target -> build_done;
  install_step [label="cmake --install", style="rounded,filled", fillcolor="#e9ecef"];
  t_install_step [label="0.00s", shape=circle, fixedsize=true, width=0.45, height=0.45, fontsize=7, fillcolor="#fff9db", color="#868e96", penwidth=1.5];
  install_step -> t_install_step [style=dashed, arrowhead=none, color="#868e96", constraint=false, weight=0];
  {rank=same; install_step; t_install_step;}
  build_done -> install_step;
}
