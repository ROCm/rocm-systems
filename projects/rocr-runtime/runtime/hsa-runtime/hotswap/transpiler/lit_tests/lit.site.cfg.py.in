# -*- Python -*-
"""CMake-generated site configuration for llvm-lit (do not edit in the build tree).

CMake configure_file(@ONLY) fills TRANSPILER_BUILD_DIR, LIT_SOURCE_DIR, tool paths,
and LIT_FIXTURE_*_CO variables declared in lit_tests/CMakeLists.txt.
"""

import os

config.transpiler_build_dir = r"@TRANSPILER_BUILD_DIR@"
config.raise_cli = r"@LIT_TOOL_RAISE_CLI@"
config.file_check = r"@LIT_TOOL_FILECHECK@"
config.not_tool = r"@LIT_TOOL_NOT@"
config.test_source_root = r"@LIT_SOURCE_DIR@"
# Keep lit's per-test `Output/` artifacts (the generated `.script` files
# and any tmpfiles a test writes to `%t`) out of the source tree. Without
# this, lit defaults to co-locating `Output/` next to each .ll in the
# source dir, which pollutes `git status` after every run.
config.test_exec_root = os.path.dirname(os.path.abspath(__file__))

# Single source of truth for fixture paths; lit.cfg.py maps tags to %<tag>_co.
config.fixtures = {
    "abort_gate": r"@LIT_FIXTURE_ABORT_GATE_CO@",
    "cross_wave_warn": r"@LIT_FIXTURE_CROSS_WAVE_WARN_CO@",
    "divergent_vgpr_ir": r"@LIT_FIXTURE_DIVERGENT_VGPR_IR_CO@",
    "scalar_exec_writers": r"@LIT_FIXTURE_SCALAR_EXEC_WRITERS_CO@",
    "saveexec": r"@LIT_FIXTURE_SAVEEXEC_CO@",
    "v_cmpx_ballot": r"@LIT_FIXTURE_V_CMPX_BALLOT_CO@",
    "global_load_ushort_saddr": r"@LIT_FIXTURE_GLOBAL_LOAD_USHORT_SADDR_CO@",
    "ds_bpermute_b32": r"@LIT_FIXTURE_DS_BPERMUTE_B32_CO@",
    # Wave-size obstruction classifier fixtures — one per obstruction
    # class (Class 1..4) defined in hotswap/docs/wave-size-translation.md
    # §6. See wave_size_obstruction.{hpp,cpp} for the classifier.
    "c1_lane_id_leak": r"@LIT_FIXTURE_C1_LANE_ID_LEAK_CO@",
    # c1_ttmp_wave_id_lift — canonical wave_id rescue under cross-widening.
    # Pins the `s_bfe_u32 sDST, ttmp8, 0x50019` pattern-lift in
    # `handle_sop2.cpp::handleSOP2` that sidesteps the backend's
    # implicit scalarisation of the formally-scalar BFE → SGPR shape.
    # The lift emits `(workitem.id.x >> log2(W_s)) & 0x1F` directly
    # from the divergent-leaf intrinsic, preserving per-source-wave
    # divergence through the destination SGPR for the benefit of
    # every matmul / tiled-reduction kernel that keys tile offsets
    # on `wave_id_in_workgroup`. The classifier in
    # `wave_size_obstruction.cpp::isCanonicalWaveIdBfe` filters this
    # exact shape out of the Class-1 refusal list so the lift actually
    # takes effect; any *other* ttmp8 source read is still refused by
    # TtmpWaveIdLeak. See wave-size-translation.md §5.6.2 (lift) and
    # §6 / §7 Class-1 table (rescue vs. refuse).
    "c1_ttmp_wave_id_lift":
        r"@LIT_FIXTURE_C1_TTMP_WAVE_ID_LIFT_CO@",
    "c2_permlane_swap": r"@LIT_FIXTURE_C2_PERMLANE_SWAP_CO@",
    "c2_permlane16": r"@LIT_FIXTURE_C2_PERMLANE16_CO@",
    "c2_dpp_quad_perm": r"@LIT_FIXTURE_C2_DPP_QUAD_PERM_CO@",
    "c2_ds_swizzle": r"@LIT_FIXTURE_C2_DS_SWIZZLE_CO@",
    "c2_ds_swizzle_unsafe": r"@LIT_FIXTURE_C2_DS_SWIZZLE_UNSAFE_CO@",
    "c2_ds_swizzle_fft_reserved":
        r"@LIT_FIXTURE_C2_DS_SWIZZLE_FFT_RESERVED_CO@",
    "decoder_madmk_v_fmamk_f32":
        r"@LIT_FIXTURE_DECODER_MADMK_V_FMAMK_F32_CO@",
    "v_rcp_f64": r"@LIT_FIXTURE_V_RCP_F64_CO@",
    "s_cmov_b32": r"@LIT_FIXTURE_S_CMOV_B32_CO@",
    "s_mul_hi_i32": r"@LIT_FIXTURE_S_MUL_HI_I32_CO@",
    "s_sub_nc_u64": r"@LIT_FIXTURE_S_SUB_NC_U64_CO@",
    "s_sub_f32": r"@LIT_FIXTURE_S_SUB_F32_CO@",
    "v_max3_u32": r"@LIT_FIXTURE_V_MAX3_U32_CO@",
    "v_xor3_b32": r"@LIT_FIXTURE_V_XOR3_B32_CO@",
    "v_add_nc_u16": r"@LIT_FIXTURE_V_ADD_NC_U16_CO@",
    "v_xad_u32": r"@LIT_FIXTURE_V_XAD_U32_CO@",
    "v_alignbit_b32": r"@LIT_FIXTURE_V_ALIGNBIT_B32_CO@",
    # v_bfi_b32 (VOP3 gfx6+ bit-field insert) — pins the
    # `(mask & one) | (~mask & zero)` IR shape the handler in
    # `handle_valu.cpp` emits for the VOP3 ternary mask-and-merge
    # opcode.  Before the handler landed, every kernel exercising
    # this opcode (asin / atan / copysign idioms in libdevice; the
    # compare_correctness v_bfi_b32 probe; corpus_asin_fp32) failed
    # the raise step with `unsupported instruction: v_bfi_b32`.
    # The handler unblocks raise; this fixture regression-pins the
    # specific IR shape so the backend's `AMDGPUbfiPattern` will
    # isel back to a single v_bfi_b32 on the way down.
    "v_bfi_b32": r"@LIT_FIXTURE_V_BFI_B32_CO@",
    "v_minmax_num_f32": r"@LIT_FIXTURE_V_MINMAX_NUM_F32_CO@",
    # v_med3_i32 (VOP3, signed integer median-of-three) — pins the
    # canonical `smax(smin(a, b), smin(smax(a, b), c))` lowering the
    # handler in `handle_valu.cpp` emits via paired `llvm.smin.i32`
    # / `llvm.smax.i32` intrinsics. The shape is the round-trip
    # identity that the AMDGPU backend's `AMDGPUsmed3` SDAG pattern
    # (AMDGPUInstructions.td) matches back to V_MED3_I32, so the
    # generated assembly recovers the original instruction without
    # codegen quality loss.
    "v_med3_i32": r"@LIT_FIXTURE_V_MED3_I32_CO@",
    "v_mul_u64": r"@LIT_FIXTURE_V_MUL_U64_CO@",
    "c3_atomic_cas": r"@LIT_FIXTURE_C3_ATOMIC_CAS_CO@",
    "c4_lane_dep_cmpx": r"@LIT_FIXTURE_C4_LANE_DEP_CMPX_CO@",
    # s_set_pc_i64 (SOP1) — four sibling fixtures, one per analysis
    # outcome class. See setpc_analysis.cpp / handle_sop1.cpp for the
    # Pattern A (DirectA, br) / Pattern B (IndirectB, indirectbr) /
    # DispatchSet (multi-target indirectbr enumerated by inter-block
    # PC-chain dataflow — the tensilelite "activation function
    # dispatcher" pattern) / Unresolvable (refusal) lowering contract
    # documented on SemOp::S_SET_PC_I64.
    "s_set_pc_i64_pattern_a":
        r"@LIT_FIXTURE_S_SET_PC_I64_PATTERN_A_CO@",
    "s_set_pc_i64_pattern_b":
        r"@LIT_FIXTURE_S_SET_PC_I64_PATTERN_B_CO@",
    "s_set_pc_i64_dispatch_set":
        r"@LIT_FIXTURE_S_SET_PC_I64_DISPATCH_SET_CO@",
    "s_set_pc_i64_unresolvable":
        r"@LIT_FIXTURE_S_SET_PC_I64_UNRESOLVABLE_CO@",
    # s_swap_pc_i64 (SOP1, branch-and-link) — three sibling fixtures.
    # Pattern A pins the chain-resolved direct lowering (swap_ret
    # blockaddress + br label %callee). DispatchSet pins the
    # multi-target indirect-call lowering (swap_ret blockaddress +
    # indirectbr ptr %callee_ptr, [list]) emitted when the inter-
    # block PC-chain dataflow enumerates a bounded set of in-kernel
    # callees converging on the swap site (the tensilelite
    # "activation function dispatcher" pattern). Unresolvable pins
    # the loud refusal contract (RaiseFailure::unsupportedShape)
    # for sites whose call target is not statically resolvable. See
    # SemOp::S_SWAP_PC_I64 in semop.hpp and the swap branch in
    # setpc_analysis.cpp / handle_sop1.cpp.
    "s_swap_pc_i64_pattern_a":
        r"@LIT_FIXTURE_S_SWAP_PC_I64_PATTERN_A_CO@",
    "s_swap_pc_i64_dispatch_set":
        r"@LIT_FIXTURE_S_SWAP_PC_I64_DISPATCH_SET_CO@",
    "s_swap_pc_i64_unresolvable":
        r"@LIT_FIXTURE_S_SWAP_PC_I64_UNRESOLVABLE_CO@",
    # ds_load_tr8_b64 (DS) — gfx1250 64-bit transposed LDS load with
    # 8-bit elements.  See handle_ds.cpp's `emitDsLoadTr8B64` shared
    # lambda and the SemOp::DS_LOAD_TR8_B64 docstring in semop.hpp
    # for the lowering contract; the fixture pins the bpermute-based
    # emulation that gfx942 needs because neither HasGFX950Insts nor
    # isGFX1250Plus isel patterns fire on gfx942.
    "ds_load_tr8_b64": r"@LIT_FIXTURE_DS_LOAD_TR8_B64_CO@",
    # ds_load_b96 / ds_store_b96 (DS) — gfx1250 96-bit (3 x i32) LDS
    # load+store pair.  See SemOp::DS_READ_B96 / DS_WRITE_B96 in
    # semop.hpp and the {dwords=3, loadBits=96} entry in dsClassify
    # in handle_ds.cpp; the fixture pins the generic `<3 x i32>`
    # vector-load/store path the handler routes both ops through.
    "ds_load_b96": r"@LIT_FIXTURE_DS_LOAD_B96_CO@",
    # v_cvt_scale_pk8_bf16_fp4 (VOP3 gfx1250-only scaled packed-8
    # FP4 -> BF16 convert, V_CVT_SCALE_PK8_BF16_FP4_e64).  Pins both
    # the same-target intrinsic-emit shape (call <8 x bfloat>
    # @llvm.amdgcn.cvt.scale.pk8.bf16.fp4 + i128 bitcast + writeRegVec)
    # AND the cross-target refusal path (--target-isa=gfx942 must
    # surface a loud RaiseFailure::unsupportedShape referencing
    # `isGFX125xOnly`).  Closes the corpus gap on scope_discovery
    # `_matmul_ogs_NNT_bf16xbf16xmxfp4_32x256x128x1`.
    "v_cvt_scale_pk8_bf16_fp4":
        r"@LIT_FIXTURE_V_CVT_SCALE_PK8_BF16_FP4_CO@",
    # v_fma_mix_f32 + v_fma_mix_f32_bf16 (VOP3P mixed-precision FMA
    # family) — pins the shared narrow-half extraction + fpext chain
    # for both mnemonics in one fixture.  The BF16 sibling is the
    # gfx9.5+/gfx1250 variant that closes the kerneldex `_attn_fwd`
    # corpus blocker (one `v_fma_mix_f32_bf16` at
    # op_sel:[0,1,0] op_sel_hi:[1,1,0]).  Fixture runs the lift under
    # `--target-isa=gfx942` specifically to prove the BF16 narrow
    # half does not require a cross-target refusal — `fpext bfloat`
    # is universally lowered on every AMDGPU target.  The handler in
    # handle_valu_vop3p.cpp folds both variants through one
    # `narrowTy`-parameterised switch case; this fixture is the
    # regression guard for that shared path.
    "v_fma_mix_f32_bf16":
        r"@LIT_FIXTURE_V_FMA_MIX_F32_BF16_CO@",
    # ds_load_2addr_b32 / ds_load_2addr_stride64_b32 (DS) — gfx11+
    # two-address LDS loads.  See SemOp::DS_READ2_B32 /
    # DS_READ2ST64_B32 in semop.hpp and the dedicated `ds2Classify`
    # block in handle_ds.cpp; the fixture pins the correct per-offset-
    # independent lowering (two `load i32, ptr addrspace(3)` at
    # raw-field-scaled byte offsets) for BOTH the dword-unit variant
    # (unit=4) and the stride-64 variant (unit=256).  Guards against
    # regression to the pre-rewrite silent-miscompile shape that
    # lifted every DS_READ2_B32 into a single contiguous
    # `load <2 x i32>` at `vaddr + raw_offset0`, correct only for
    # the (0,1) offset pair.
    "ds_load_2addr_b32":
        r"@LIT_FIXTURE_DS_LOAD_2ADDR_B32_CO@",
    # s_bitcmp family (SOPC, SOPInstructions.td:1411-1414) — one
    # fixture covers all four variants
    # (s_bitcmp{0,1}_{b32,b64}) because the handler in
    # handle_sopc.cpp folds them through a single
    # {is64 || isB32}-parameterised block (only the source-operand
    # width and the final icmp predicate differ).  Closes the
    # kerneldex corpus blocker on scope_discovery `_attn_fwd`
    # (one `s_bitcmp0_b32 s68, 1` that the pre-fix handler dropped
    # on the floor, leaving the downstream SCC-dependent branch
    # undef-driven).
    "s_bitcmp": r"@LIT_FIXTURE_S_BITCMP_CO@",
    # buffer_atomic_add_u32 (MUBUF/VBUFFER) — gfx11+/gfx1250 VBUFFER
    # encoding for what the legacy MUBUF named BUFFER_ATOMIC_ADD.  The
    # SemOp + handler already existed for the legacy MUBUF addressing
    # forms; the gap was the missing VBUF4 entries in opcode_map.cpp
    # for the gfx12 `_VBUFFER_*` opcodes that the disassembler emits
    # for `buffer_atomic_add_u32`.  See VBUF4(BUFFER_ATOMIC_ADD,
    # BUFFER_ATOMIC_ADD) in opcode_map.cpp.
    "buffer_atomic_add_u32":
        r"@LIT_FIXTURE_BUFFER_ATOMIC_ADD_U32_CO@",
    # buffer_load_d16_u8 (MUBUF/VBUFFER) — gfx9+/gfx1250 D16 partial-
    # write byte loads.  Pins both half-merge directions:
    #   `_d16_u8`     -> (prior & 0xFFFF0000) | zext(byte, i32)
    #   `_d16_hi_u8`  -> (prior & 0x0000FFFF) | (zext(byte, i32) << 16)
    # See SemOp::BUFFER_LOAD_UBYTE_D16{,_HI} in semop.hpp, the d16Half
    # branch of mubufClassify in handle_mubuf.cpp, and the matching
    # MUBUF4 + VBUF4 entries in opcode_map.cpp.  Adding this fixture
    # also retroactively pins the bug fix for `BUFFER_LOAD_SHORT_D16`,
    # which previously zext'd the loaded value to i32 and overwrote
    # the whole VGPR (silently violating `D16PreservesUnusedBits`).
    "buffer_load_d16_u8": r"@LIT_FIXTURE_BUFFER_LOAD_D16_U8_CO@",
    # buffer_store_no_scratch_alloca (MUBUF/VBUFFER) — regression guard
    # for the principled BUFFER_STORE_* lowering.  See SemOp::
    # BUFFER_STORE_DWORDX4 in semop.hpp, the `if (isStore)` block in
    # transpiler/handle_mubuf.cpp, and the design discussion in
    # hotswap/docs/buffer-store-lowering.md.  The fixture pins both the
    # positive shape (`call void @llvm.amdgcn.raw.buffer.store.v4i32`)
    # and — more importantly — the ABI invariant that fixed Triton
    # vector-add R1: ZERO `addrspace(5)` allocas in the lifted module.
    # Any future change that reintroduces an `addrspace(5)` alloca in
    # a BUFFER_STORE-only kernel re-couples the kernel descriptor to
    # `enable_private_segment` and resurrects the SIGSEGV under
    # salmon's KD (which models only the source ABI's user-SGPR set
    # and therefore does not request flat_scratch_init).  Sibling
    # widths BUFFER_STORE_BYTE / SHORT / DWORD / DWORDX2 / DWORDX3
    # share the same handler shape and are covered transitively;
    # a per-width follow-up fixture would close the lit-coverage
    # gap called out in the principled review.
    "buffer_store_no_scratch_alloca":
        r"@LIT_FIXTURE_BUFFER_STORE_NO_SCRATCH_ALLOCA_CO@",
    # v_pk_add_f32 with inline literal source — pins the broadcast
    # path the VOP3P handler emits for non-register operands.
    # See the readPkSrc lambda in handle_valu_vop3p.cpp; the
    # tensilelite swiglu kernel was previously rejected at this
    # operand shape with "non-register source ... immediate in VOP3P
    # not supported".  Register/register form is exercised
    # transitively through the corpus.
    "v_pk_add_f32_lit": r"@LIT_FIXTURE_V_PK_ADD_F32_LIT_CO@",
    # s_bitset0_b32 (SOP1) — bit-clear with tied sdst_in.  Pins the
    # read-modify-write shape under the AMDGPU disassembler's tied-
    # operand collapse: the prior dst value must come from
    # `regs.readReg32(op.dst())`, not srcMap (the disassembler emits
    # only `(sdst, src0)` even though TableGen declares `$sdst_in`
    # tied).  See the S_BITSET block in handle_sop1.cpp and the
    # caveat note appended to `kKnownTiedIn` in decode.cpp.
    "s_bitset0_b32": r"@LIT_FIXTURE_S_BITSET0_B32_CO@",
    # s_load_b96 (SMEM) over a kernarg buffer with a `by_value`
    # aggregate larger than 8 bytes — pins the per-dword
    # `extractKernargDword` resolution path AND the raiser's
    # `byValueSize > 8 && % 4 == 0` decomposition into i32 IR slots.
    # 502 tensilelite + Triton attention kernels were blocked on
    # this row before the fix; the fixture exists to regression-pin
    # the (i32 %arg0, i32 %arg1, i32 %arg2, i32 %arg3, ptr %arg4)
    # signature shape and the (%arg1, %arg2, %arg3) -> s[0:2] data
    # flow through the SMEM kernarg branch in handle_smem.cpp.
    "s_load_b96_kernarg":
        r"@LIT_FIXTURE_S_LOAD_B96_KERNARG_CO@",
    # s_load_b32 with an SGPR offset carrying the `scale_offset`
    # (CPol::SCAL) modifier — pins the `mul i64 <offset>, 4` the
    # SMEM handler in `handle_smem.cpp` emits to honour hardware's
    # element-index-to-byte-offset scaling.  Before the fix, the
    # SGPR-offset arm silently ignored `di.hasScaleOffset` and
    # emitted a raw-byte GEP off the zero-extended offset; the
    # resulting off-by-N* miscompile surfaced on the
    # `s_and_saveexec_b32` compare_correctness probe as a
    # single-block-matches, multi-block-mismatches pattern.  This
    # fixture closes the SMEM-side gap in the `hasScaleOffset`
    # coverage matrix (the FLAT/GLOBAL sibling paths in
    # `flat_addr.cpp` were already scaling correctly).
    "s_load_b32_scale_offset":
        r"@LIT_FIXTURE_S_LOAD_B32_SCALE_OFFSET_CO@",
    # s_lshr_b64 (SOP2 64-bit logical right shift) with an
    # immediate shift count — the dominant corpus shape (every
    # observed `s_lshr_b64` in the kerneldex sweep uses an
    # immediate, typically `>> 16` for high-half pointer
    # extraction). Pins the i32→i64 zext of the shift amount
    # constant-folding away into a single `lshr i64 ..., 16`.
    "s_lshr_b64_imm": r"@LIT_FIXTURE_S_LSHR_B64_IMM_CO@",
    # s_cmp_eq_u64 (SOPC_CMP_64 unsigned 64-bit equality) — the
    # gfx8+ 64-bit sibling of s_cmp_eq_u32. Pins the icmp eq i64
    # SCC-writeback shape and the s_cselect_b32 chain that
    # surfaces SCC into a normal SGPR write.
    "s_cmp_eq_u64": r"@LIT_FIXTURE_S_CMP_EQ_U64_CO@",
    # ds_store_b16_d16_hi (DS, gfx8+ HasD16LoadStore D16_HI
    # partial-store family) — pins the `lshr i32 %src, 16` then
    # `trunc i32 ... to i16` chain that surfaces the UPPER half
    # of the source VGPR for the LDS store. By handler-shape
    # identity this fixture also pins ds_store_b8_d16_hi (the
    # only delta is an extra trunc-to-i8 in the same code path).
    "ds_store_b16_d16_hi":
        r"@LIT_FIXTURE_DS_STORE_B16_D16_HI_CO@",
    # v_wmma_f32_16x16x32_bf16 (gfx1250 RDNA4 VOP3P opcode 0x062)
    # lowered to gfx942 (CDNA3) via the parameterised emitWMMAtoMFMA
    # helper. Pins the bf16-specific CDNA3 MFMA intrinsic
    # (mfma.f32.16x16x16bf16.1k), the per-MFMA <4 x i16> bitcast,
    # and the 2x K=16 decomposition with chained accumulator.
    # Sibling V_WMMA_F32_16x16x32_F16 case is covered transitively
    # by the existing Gfx1250Gpu.Matmul128x128 GPU gtest.
    "wmma_f32_16x16x32_bf16":
        r"@LIT_FIXTURE_WMMA_F32_16X16X32_BF16_CO@",
    # v_wmma_f32_16x16x64_fp8_fp8 (gfx1250 RDNA4 VOP3P opcode 0x06a)
    # lowered to gfx942 (CDNA3) via the parameterised emitWMMAtoMFMA
    # helper with WMMAInputType::FP8_FP8.  Pins the fp8_fp8-specific
    # CDNA3 MFMA intrinsic (mfma.f32.16x16x32.fp8.fp8), the per-MFMA
    # `bitcast <2 x i32> ... to i64` (CDNA3's pre-fp8-type intrinsic
    # signature), and the 2x K=32 decomposition with chained
    # accumulator over two virtual Wave32 groups (4 MFMA calls total).
    # Sibling FP8_BF8 / BF8_FP8 / BF8_BF8 cases are covered
