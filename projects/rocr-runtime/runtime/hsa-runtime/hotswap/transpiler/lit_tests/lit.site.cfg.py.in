    "wmma_f32_16x16x64_fp8_fp8":
        r"@LIT_FIXTURE_WMMA_F32_16X16X64_FP8_FP8_CO@",
    # v_wmma_i32_16x16x64_iu8 (gfx1250 RDNA4 VOP3P opcode 0x072)
    # lowered to gfx942 (CDNA3) via the parameterised emitWMMAtoMFMA
    # helper with WMMAInputType::IU8.  This is the ONLY WMMA variant
    # with an integer accumulator — the fixture pins (a) the
    # mfma.i32.16x16x32.i8 intrinsic dispatch (vs every other variant
    # which dispatches to mfma.f32.*), (b) the `<4 x i32>` accumulator
    # pack type (vs `<4 x float>` everywhere else), (c) the per-MFMA
    # `bitcast <2 x i32> ... to i64` AB pack (shared shape with the
    # FP8/BF8 siblings), and (d) the K=64 -> 2x K=32 chained
    # decomposition over two virtual Wave32 groups (4 MFMA calls
    # total, matching the FP8/BF8 shape exactly).
    "wmma_i32_16x16x64_iu8":
        r"@LIT_FIXTURE_WMMA_I32_16X16X64_IU8_CO@",
    # VOPD extra sub-operations — pins three previously-unhandled
    # shapes routed through `parseVOPDHalf` in
    # transpiler/handle_vopd.cpp:
    #   * v_dual_mov_b32 with an f32 inline-constant literal source
    #     (the AMDGPU instruction printer surfaces these as their
    #     decimal float spelling, e.g. `1.0`, rather than as the
    #     hex bit pattern; the literal-parse fallback in the handler
    #     maps the printed string back to its IEEE-754 32-bit
    #     encoding via a finite enumeration mirrored from the
    #     printer).
    #   * v_dual_ashrrev_i32 — arithmetic right shift, reversed
    #     operand order (sign-extension idiom in Triton kernels).
    #   * v_dual_max_i32     — signed max via `llvm.smax.i32`.
    # The fixture pins all three shapes in a single kernel; sibling
    # ops added in the same pass (v_dual_min_i32, v_dual_max_u32,
    # v_dual_min_u32, v_dual_xor_b32, v_dual_or_b32) follow the
    # identical (s0, s1) -> intrinsic / IRBuilder dispatch pattern
    # and are covered transitively.
    "vopd_extra_subops":
        r"@LIT_FIXTURE_VOPD_EXTRA_SUBOPS_CO@",
    # tensor_load_to_lds (VIMAGE TENSOR, gfx1250-only) — single
    # `.co` fixture shared by two complementary lit tests in the
    # `tensor_load_to_lds/` directory:
    #   * `tensor_load_to_lds.ll` — pins the cross-target
    #     (gfx1250 -> gfx942) loud refusal contract. The handler in
    #     `handle_vimage.cpp` refuses via
    #     `RaiseFailure::unsupportedShape` because the per-dim
    #     addressing semantics of a Tensor Descriptor cannot be
    #     reconstructed from gfx9xx primitives, and the matching LLVM
    #     intrinsic `int_amdgcn_tensor_load_to_lds`
    #     (IntrinsicsAMDGPU.td:4213) is itself `isGFX125xOnly`.
    #   * `tensor_load_to_lds_same_target.ll` — pins the same-target
    #     (gfx1250 -> gfx1250) intrinsic-emit path: marshalling of
    #     vaddr0 / vaddr1 SGPR ranges into the `<4 x i32>` /
    #     `<8 x i32>` D# group operands, zero-fill of the unused `_d2`
    #     groups (2 and 3) and the always-reserved group 4, and the
    #     `i32 0` cpol immediate, ending in a single
    #     `llvm.amdgcn.tensor.load.to.lds` call.
    # Sibling `tensor_store_from_lds` and the `_d4` operand-shape
    # variant follow the identical SemOp dispatch (only the trailing
    # intrinsic name and the operand-count branch differ); the
    # corpus blockers we unblocked are all `_d2` loads, so we keep
    # the fixture as a single `_d2` payload and exercise both
    # contracts off it.
    "tensor_load_to_lds":
        r"@LIT_FIXTURE_TENSOR_LOAD_TO_LDS_CO@",
    # v_wmma_f32_16x16x4_f32 (gfx1250 RDNA4 VOP3P opcode 0x05D) —
    # single `.co` fixture shared by two complementary lit tests in
    # the `wmma_f32_16x16x4_f32/` directory:
    #   * `wmma_f32_16x16x4_f32.ll` — pins the cross-target
    #     (gfx1250 -> gfx942) lift contract. The handler in
    #     `handle_valu_vop3p.cpp` dispatches to
    #     `emitWMMAtoMFMA_F32_16x16x4` (`wmma_lowering.cpp`),
    #     which decomposes the Wave32 WMMA into one
    #     `mfma_f32_16x16x4f32` call per virtual Wave32 group via
    #     ds.bpermute lane redistribution. The K=4 MFMA matches
    #     the WMMA's K exactly, so the per-group K-tiling that the
    #     K=32/K=64 family does is NOT needed — exactly 2 MFMAs
    #     total instead of 4.
    #   * `wmma_f32_16x16x4_f32_same_target.ll` — pins the
    #     same-target (gfx1250 -> gfx1250) intrinsic-emit shape:
    #     the `<2 x f32>` A/B fragments and `<8 x float>`
    #     accumulator, the canonical defaulted modifier args
    #     (i1 false / i16 0), and the absence of any cross-K
    #     dispatch / MFMA fallback. Same-target gating is
    #     `ISAProfile::hasTensorOps` (FeatureGFX1250Insts) — NOT
    #     `hasWMMA12`, since the gfx12 RDNA4-base WMMA family
    #     (`AMDGPUWMMAIntrinsicsGFX12`, FeatureWMMA{128,256}bInsts)
    #     does NOT include this K=4 f32 intrinsic.
    "wmma_f32_16x16x4_f32":
        r"@LIT_FIXTURE_WMMA_F32_16X16X4_F32_CO@",
    # global_load_async_to_lds_b{8,32,64,128} (FLAT, gfx1250-only) —
    # single `.co` fixture shared by two complementary lit tests in
    # the `global_load_async_to_lds/` directory:
    #   * `global_load_async_to_lds.ll` — pins the cross-target
    #     (gfx1250 → gfx942) loud refusal contract. The handler in
    #     `handle_flat.cpp` refuses via
    #     `RaiseFailure::unsupportedShape` because gfx942 has no
    #     asynccnt unit and the matching LLVM intrinsic family
    #     `int_amdgcn_global_load_async_to_lds_b{8,32,64,128}`
    #     (IntrinsicsAMDGPU.td:3939-3946) is gated by
    #     `FeatureGFX1250Insts`. A synthesised
    #     `global_load + ds_write` pair would alter the wave's
    #     memory-ordering and asynccnt observable state.
    #   * `global_load_async_to_lds_same_target.ll` — pins the
    #     same-target (gfx1250 → gfx1250) intrinsic-emit shape:
    #     `inttoptr i32 → ptr addrspace(3)` for the per-lane VGPR_32
    #     LDS base, and the canonical
    #     `call void @llvm.amdgcn.global.load.async.to.lds.b{32,64,128}`
    #     with the FLAT `offset` and `cpol` immediates threaded
    #     through. The b8 sibling shares the identical handler shape
    #     (only the trailing intrinsic ID differs) and is covered
    #     transitively by the SemOp-keyed switch arm.
    "global_load_async_to_lds":
        r"@LIT_FIXTURE_GLOBAL_LOAD_ASYNC_TO_LDS_CO@",
    # global_prefetch_b8 (FLAT, gfx1250-only) — single `.co` fixture
    # shared by two complementary lit tests in the
    # `global_prefetch_b8/` directory:
    #   * `global_prefetch_b8.ll` — pins the cross-target
    #     (gfx1250 → gfx942) loud refusal contract. The handler in
    #     `handle_flat.cpp` refuses via
    #     `RaiseFailure::unsupportedShape` because gfx942 has no
    #     VMEM-prefetch unit and the matching LLVM intrinsic
    #     `int_amdgcn_global_prefetch` (IntrinsicsAMDGPU.td:3211,
    #     LLVM PR #150466) is gated by `HasVmemPrefInsts`, only
    #     set on gfx1250+.  The closest sibling
    #     `int_amdgcn_s_prefetch_data` requires a UNIFORM SGPR
    #     pointer, which we cannot prove at lift time for the
    #     divergent VGPR address used here without a divergence
    #     analysis pass.  Silently dropping the hint would mask
    #     both the cross-target capability gap and the resulting
    #     pipeline-stall regression in any software-pipelined
    #     kernel that relied on the prefetch overlapping a prior
    #     compute chain (the dominant Triton corpus shape).
    #   * `global_prefetch_b8_same_target.ll` — pins the
    #     same-target (gfx1250 → gfx1250) intrinsic-emit shape:
    #     `add i64 saddr, zext i32 vaddr` named `saddr_vaddr`,
    #     `inttoptr i64 ... to ptr addrspace(1)`, optional
    #     non-inbounds `getelementptr i8, ..., i64 <offset>`
    #     named `prefetch_addr` for the FLAT `flat_offset`
    #     immediate, and the canonical
    #     `call void @llvm.amdgcn.global.prefetch(ptr addrspace(1), i32)`
    #     with the `cpol` immediate threaded through.  The call
    #     is NOT wrapped in `ctx.emitUnderExec` because the
    #     intrinsic carries the EXEC mask implicitly through
    #     `IntrInaccessibleMemOrArgMemOnly` — semantically a hint
    #     with no observable side effect on inactive lanes.
    #
    # Sibling `flat_prefetch_b8` (the generic-address-space
    # sibling, lifted via `int_amdgcn_flat_prefetch`) is NOT in
    # the corpus and so is intentionally omitted from
    # `opcode_map.cpp` — adding it would be unprincipled (no
    # corpus producer to validate the lifted shape against).
    "global_prefetch_b8":
        r"@LIT_FIXTURE_GLOBAL_PREFETCH_B8_CO@",
    # v_wmma_scale_f32_16x16x128_f8f6f4 (gfx1250 RDNA4 VOP3PX2 opcode
    # 0x033, ScaledWMMA family) — single `.co` fixture shared by two
    # complementary lit tests in the
    # `wmma_scale_f32_16x16x128_f8f6f4/` directory:
    #   * `wmma_scale_f32_16x16x128_f8f6f4.ll` — pins the cross-target
    #     (gfx1250 -> gfx942) loud refusal contract. The handler in
    #     `handle_valu_vop3p.cpp` refuses via
    #     `RaiseFailure::unsupportedShape` because gfx942 has no
    #     scaled-WMMA hardware AND the WMMA -> MFMA decomposition for
    #     K=128 + per-matrix-fmt selection + scale-exponent
    #     application is not modelled in `wmma_lowering.cpp` (only
    #     K=32 / K=64 fp16/bf16/fp8/bf8/iu8 paths exist). The matching
    #     LLVM intrinsic
    #     `int_amdgcn_wmma_scale_f32_16x16x128_f8f6f4`
    #     (IntrinsicsAMDGPU.td:4138) is itself `isGFX125xOnly`, so
    #     even an intrinsic-emit on a non-gfx1250 target would fail
    #     at codegen — the principled lift is the loud refusal.
    #   * `wmma_scale_f32_16x16x128_f8f6f4_same_target.ll` — pins the
    #     same-target (gfx1250 -> gfx1250) intrinsic-emit shape:
    #     `i32 matrix_a_fmt` / `i32 matrix_b_fmt` named-immediate
    #     decode (`MATRIX_FMT_BF8=1`, `MATRIX_FMT_FP8=0`), per-matrix
    #     dword count `<16 x i32>` for the f8_f8 family (suffix
    #     `_f8_f8_w32_*` of the MC pseudo per `WMMA_F8F6F4_Profiles`),
    #     `<8 x float>` accumulator, scale_src0 / scale_src1 read as
    #     runtime VGPR values via `getNamedOperandIdx`, and the
    #     canonical `i1 false` reuse defaults. 18 MC pseudos
    #     (9 mantissa pairs `{f4,f6,f8} A × {f4,f6,f8} B` ×
    #     `_twoaddr`/`_threeaddr`) collapse onto the single SemOp;
    #     the f8_f8 form covered here is what the failing kerneldex
    #     B8F8 / F8B8 ID73f0 tensilelite GEMMs emit. Same-target
    #     gating is `ISAProfile::hasTensorOps` (FeatureGFX1250Insts)
    #     — matching the LLVM intrinsic's actual subtarget gating.
    "wmma_scale_f32_16x16x128_f8f6f4":
        r"@LIT_FIXTURE_WMMA_SCALE_F32_16X16X128_F8F6F4_CO@",
    # v_cmp_class_f32_e64 (VOPC, floating-point IEEE class predicate)
    # — closes the parser-level gap in `parseVCmpPseudoName` in
    # transpiler/opcode_map.cpp: `V_CMP_CLASS_F<bits>` MC pseudos
    # were leaving the map as `SemOp::Unknown` because the pseudo
    # name parser only recognised the predicate-compare token grammar
    # (EQ/NE/LT/.../O), not the special `CLASS` token. The handler
    # in `handle_valu_vcmp.cpp` already had the `if (m->isClass)`
    # branch wired up to emit `llvm.amdgcn.class.f<bits>`; the parser
    # fix flips on `VCmpMeta::isClass` for the matched MC pseudo and
    # makes the existing handler-side dispatch reachable.
    #
    # Fixture pins both sides of the contract:
    #   * `llvm.amdgcn.class.f32(float, i32 <mask>)` — the special-case
    #     intrinsic-emit path (NOT a CreateFCmp); the mask immediate
    #     (here `0x200` = +inf singleton class) threads through
    #     verbatim.
    #   * `llvm.amdgcn.ballot.i64` + `trunc i64 -> i32` — the wave-mask
    #     write-back tail that the V_CMP class branch shares with the
    #     V_CMP/V_CMPX predicate-compare branch (same `vcmp_ballot` /
    #     `vcmp_ballot_trunc` identifiers as the v_cmpx_ballot
    #     fixture; this is the cross-wave wave32 -> wave64 routing
    #     contract).
    #
    # Sibling V_CMP_CLASS_F16 / V_CMP_CLASS_F64 share the same parser
    # path (same `_e64` -> `CLASS_F<bits>` token grammar) and the same
    # handler dispatch (the `m->bits == 16/32/64` switch in the
    # `if (m->isClass)` block); they are covered transitively. The
    # V_CMPX_CLASS_F* compare-and-EXEC siblings exercise the same
    # parser branch and route through the V_CMPX EXEC-AND tail
    # already pinned by v_cmpx_ballot.
    "v_cmp_class_f32":
        r"@LIT_FIXTURE_V_CMP_CLASS_F32_CO@",
    # v_pk_int_b16 (VOP3P packed `<2 x i16>` int family) — pins both
    # opcodes the kerneldex corpus exercises today (V_PK_LSHLREV_B16
    # + V_PK_ADD_U16) under one fixture so the shared
    # operand-decode + write-back shape is asserted from a single
    # producer. Unblocks the scope_discovery `_upcast_from_mxfp`
    # kernel in the kerneldex sweep.
    #
    # Fixture pins:
    #   * Shared decode shape — `bitcast i32 -> <2 x i16>` + the
    #     extract/insert round-trip the handler emits to encode the
    #     op_sel / op_sel_hi default (lo->lo, hi->hi) permutation.
    #   * V_PK_LSHLREV_B16: explicit `and <2 x i16> ..., <i16 15,
    #     i16 15>` shift-count mask matching the AMDGPU clshl_rev_16
    #     hardware clamp, then `shl <2 x i16>` in the reversed
    #     (value, count) operand order.
    #   * V_PK_ADD_U16: `add <2 x i16>`.
    #   * Write-back via `bitcast <2 x i16> -> i32` named
    #     `pk_i16_pack`.
    #
    # Sibling V_PK_LSHRREV_B16 / V_PK_ASHRREV_I16 / V_PK_SUB_U16 /
    # V_PK_MUL_LO_U16 / V_PK_MAX_{I,U}16 / V_PK_MIN_{I,U}16 share
    # this exact handler shape (one extra inner-switch case + IR
    # opcode dispatch); they are intentionally NOT pre-enumerated
    # in opcode_map.cpp / semop.hpp because the kerneldex corpus
    # has zero producers for them today (no fallback / design what
    # the corpus exercises).
    "v_pk_int_b16":
        r"@LIT_FIXTURE_V_PK_INT_B16_CO@",
    # s_load_u16 (SMEM, gfx12+ scalar narrow-load family) — pins the
    # Position-α permissive-lift contract for the only shape the
    # kerneldex corpus exercises today: an unsigned half-word scalar
    # load through a runtime-materialised SGPR-pair base pointer
    # (NOT the kernarg pointer — that case is routed to a separate
    # defensive refusal branch that does not fire on any corpus
    # kernel, see handle_smem.cpp's narrow-load block).
    #
    # Fixture pins:
    #   * `load i16, ptr addrspace(1) %{{.*}}, align 2` — half-word
    #     element type + global address space + explicit hardware-
    #     mandated 2-byte alignment.
    #   * `zext i16 %smem_load_h to i32` — zero-extension for the
    #     unsigned variant. (The I16 sibling routes through the same
    #     handler block with `sext` via the `isSigned` switch.)
    #
    # Two negative assertions guard the two adjacent mis-lifts:
    #   * `load i32 ..., align 4` — catches a dword-widen-and-mask
    #     lift that would risk OOB reads past a 2-byte allocation.
    #   * `sext i16 %smem_load_h to i32` — catches an accidental
    #     sign-extension that would corrupt every high-bit-set u16
    #     silently.
    #
    # Sibling SemOps (S_LOAD_U8 / S_LOAD_I8 / S_LOAD_I16) share the
    # shared handler body and differ only in element type, Align
    # immediate, and zext/sext finale; they are covered transitively
    # and are NOT given their own fixtures because no corpus producer
    # exercises them today (no fixture without a producer).
    "s_load_u16":
        r"@LIT_FIXTURE_S_LOAD_U16_CO@",
    # scratch_refusal — pins the loud-failure contract of the early
    # `SIInstrFlags::FlatScratch` branch in handle_flat.cpp for the
    # entire FLAT scratch family (`scratch_load_*`, `scratch_store_*`,
    # `scratch_atomic_*`). One fixture covers every scratch SemOp
    # that would reach the dispatcher because the refusal is keyed on
    # the encoding-level TSFlags bit (set by the `IsFlatScratch` field
    # on every `FLAT_Scratch_*_Pseudo` in FLATInstructions.td), not on
    # a per-mnemonic SemOp — the regression guard is
    # format-symmetric.
    #
    # Fixture pins:
    #   * raise_cli exits non-zero (refusal is contractual, not a
    #     silent miscompile).
    #   * Handler diagnostic names the mnemonic (`scratch_store_b32`),
    #     the ABI anchor (`flat_scratch_init`), and back-links to the
    #     `buffer_store_no_scratch_alloca` regression guard that
    #     forbids the `addrspace(5)` alloca path a naïve lift would
    #     take.
    #   * raise_cli failure line pins the same anchors on the
    #     outer-tool side (kernel name, mnemonic, `[FLAT]` format,
    #     `flat_scratch_init`, `buffer_store_no_scratch_alloca`).
    #
    # This is a REFUSAL fixture — there is no companion
    # `_same_target.ll`, because the refusal applies on every
    # (isa, target-isa) combination until the Salmon ABI is
    # extended to request `flat_scratch_init` in the generated KD.
    # When that lands, this fixture becomes the single anchor point
    # for a corresponding positive-emit fixture.
    "scratch_refusal":
        r"@LIT_FIXTURE_SCRATCH_REFUSAL_CO@",
}

lit_config.load_config(
    config, os.path.join(r"@LIT_SOURCE_DIR@", "lit.cfg.py")
)
