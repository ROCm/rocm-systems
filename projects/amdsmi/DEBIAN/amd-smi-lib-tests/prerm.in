# The tests package installs only test binaries and python test files. It must
# not touch the main package's state (ldconfig entry, module bytecode, doc,
# symlinks). The only thing left behind that dpkg's file tracking cannot remove
# is the __pycache__ generated when the installed python tests run, so clean
# only that, and only on a full remove -- on upgrade the new tests package's
# files are already in place.
case "$1" in
  ( remove )
    tests_root="@CPACK_PACKAGING_INSTALL_PREFIX@/@SHARE_INSTALL_PREFIX@"
    rm -rf "${tests_root}/tests/python_unittest/__pycache__"
    rm -rf "${tests_root}/tests/__pycache__"
    rm -rf "${tests_root}/tools/__pycache__"
  ;;
  ( * )
    exit 0
  ;;
esac
