# for details see:
# https://setuptools.pypa.io/en/latest/userguide/pyproject_config.html

[build-system]
requires = ["setuptools>=59.0"]
build-backend = "setuptools.build_meta"

[project]
name = "amdsmi"
authors = [
    {name = "AMD", email = "amd-smi.support@amd.com"},
]
version = "@amd_smi_lib_WHEEL_VERSION@"
license = {file = "amdsmi/LICENSE"}
readme = {file = "amdsmi/README.md", content-type = "text/markdown"}
description = "AMDSMI Python LIB - AMD GPU Monitoring Library"
requires-python = ">=3.6"
classifiers = [
    "Programming Language :: Python :: 3"
]
[project.urls]
"Homepage" = "https://github.com/ROCm/rocm-systems/tree/develop/projects/amdsmi"
"Documentation" = "https://rocm.docs.amd.com/projects/amdsmi/en/latest/"

[tool.setuptools]
packages = ["amdsmi"]
zip-safe = false
include-package-data = true
# Lists the notices as License-File metadata. The [tool.setuptools] key works
# on setuptools >= 61; PEP 639's [project] key would need setuptools >= 77.
license-files = ["amdsmi/LICENSE", "amdsmi/THIRD_PARTY_LICENSES/*"]

[tool.setuptools.package-data]
# Notices also ship inside the package. Same glob the bundled .so relies on.
amdsmi = ["*.so", "THIRD_PARTY_LICENSES/*"]

[tool.pytest.ini_options]
addopts = [
    "--import-mode=importlib",
]
