    },
    {
      "id": "wheel",
      "stage": "channel",
      "label": "amdsmi PyPI wheel",
      "spec": "amdsmi-python-wheel",
      "note": "BUILD_PYTHON_WHEEL=ON only"
    },
    {
      "id": "artifact_core",
      "stage": "channel",
      "label": "core-amdsmi artifact",
      "spec": "amdsmi-therock-artifact",
