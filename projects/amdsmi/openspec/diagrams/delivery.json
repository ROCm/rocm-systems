    {
      "id": "install",
      "label": "Where it lands"
    }
  ],
  "nodes": [
    {
      "id": "sources",
      "stage": "source",
      "label": "projects/amdsmi",
      "note": "C++ library, Python module, CLI, Go shim, Rust crate"
    },
    {
      "id": "tree",
      "stage": "artifact",
