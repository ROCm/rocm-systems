      "stage": "install",
      "label": "system site-packages",
      "spec": "amdsmi-python-system-package",
      "note": "the only channel that puts amdsmi on the default sys.path"
    },
    {
      "id": "venv",
      "stage": "install",
      "label": "venv site-packages",
      "spec": "amdsmi-python-loader",
      "note": "bundled libamd_smi_python.so; system fallback disabled"
