# The tests package installs only test binaries and python test files. It must
# not touch the main package's state (ldconfig entry, module bytecode, doc,
# symlinks). The only thing left behind that RPM's file tracking cannot remove
# is the __pycache__ generated when the installed python tests run, so clean
# only that, and only on a full erase ($1=0) -- on upgrade ($1=1) the new
# tests package's files are already in place.
if [ "$1" -eq 0 ]; then
    # $RPM_INSTALL_PREFIX0 is the prefix the package was actually installed
    # under, which is what the rest of the scriptlets use; the configure-time
    # prefix would miss the real tree for a relocated install.
    _tests_root="$RPM_INSTALL_PREFIX0/@SHARE_INSTALL_PREFIX@"
    rm -rf "${_tests_root}/tests/python_unittest/__pycache__"
    rm -rf "${_tests_root}/tests/__pycache__"
    rm -rf "${_tests_root}/tools/__pycache__"
fi
