    <EncodingIdentifierAddition>
      <EncodingName>ENC_SMEM</EncodingName>
      <Opcode>38</Opcode>
      <EncodingIdentifier Radix="2">0000000000000000000000000000000011110100100110000000000000000000</EncodingIdentifier>
    </EncodingIdentifierAddition>
    <EncodingIdentifierAddition>
      <EncodingName>ENC_SMEM</EncodingName>
      <Opcode>39</Opcode>
      <EncodingIdentifier Radix="2">0000000000000000000000000000000011110100100111000000000000000000</EncodingIdentifier>
    </EncodingIdentifierAddition>
  </EncodingIdentifierAdditions>
