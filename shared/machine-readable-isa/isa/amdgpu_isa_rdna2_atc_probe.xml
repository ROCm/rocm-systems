        <IsProgramTerminator>FALSE</IsProgramTerminator>
        <IsImmediatelyExecuted>FALSE</IsImmediatelyExecuted>
      </InstructionFlags>
      <InstructionName>S_ATC_PROBE_BUFFER</InstructionName>
      <Description>Probe or prefetch an address into the scalar data cache.</Description>
      <InstructionEncodings>
        <InstructionEncoding>
          <EncodingName>ENC_SMEM</EncodingName>
          <EncodingCondition>default</EncodingCondition>
          <Opcode Radix="10">39</Opcode>
          <Operands>
            <Operand Input="true" Output="false" IsImplicit="false" IsBinaryMicrocodeRequired="true" Order="1">
