<IsaAdditions Id="rdna2-atc-probe" BaseArchitecture="AMD RDNA 2" BaseSchemaVersion="1.1.1">
  <!-- RDNA2 manual sections 12.6 and 13.2, SMEM opcodes 38 and 39.
       The GFX10 layout and operands match RDNA1. LLVM SMInstructions.td
       defines both gfx10 probe encodings. RDNA2 has no SIMM8 operand
       enumerator; represent the eight-bit argument with its integer immediate
       class and retain OperandSize=8 and the encoded SDATA width. -->
