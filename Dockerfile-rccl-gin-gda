## base docker image
ARG ROCM_IMAGE_NAME=rocm/dev-ubuntu-24.04
ARG ROCM_IMAGE_TAG=latest
FROM "${ROCM_IMAGE_NAME}:${ROCM_IMAGE_TAG}"

## creating scratch space
ENV WORKDIR /workspace
RUN mkdir -p ${WORKDIR}
WORKDIR ${WORKDIR}
ENV SRC /src
RUN mkdir -p ${SRC}

