## AMD GPU Targets
ARG GPU_TARGETS=gfx950

# DEBUG_BUILD=1: build all components with debug symbols (-g, Debug).
ARG DEBUG_BUILD=0

# If USE_LOCAL_SRC=0: pull that branch from that repo and use it to build.
ARG ROCM_REPO=https://github.com/ROCm/rocm-systems.git
ARG BRANCH=users/abouteiller/gin-stage2

# USE_LOCAL_SRC=1: use the CWD worktree instead of cloning from ROCM_REPO.
# Build with:  docker build --build-arg USE_LOCAL_SRC=1 ...  from the repo root.
# projects/ always exists even in a sparse checkout, so COPY never fails;
# individual subdirs are checked in shell before use.
ARG USE_LOCAL_SRC=0
# Set CACHE_BUST to a new value to force reloading the sources and rebuild (in
# case docker build didn't autodetect it needed to)
ARG CACHE_BUST=1 ROCSHMEM_CACHE_BUST='' RCCL_CACHE_BUST=''
RUN echo "cache bust: ${CACHE_BUST} ${ROCSHMEM_CACHE_BUST} ${RCCL_CACHE_BUST}"
## All projects share a mono-repo layout under ${SRC}/projects/ so that
## cmake auto-detect (CMAKE_SOURCE_DIR/../..) finds sibling projects.
## install.sh --rocshmem-gin builds rocshmem from source automatically.
##
## rocshmem + rccl are COPYed and built first; rccl-tests is COPYed separately
## so that changes to rccl-tests don't invalidate the rccl/rocshmem build layers.
ENV RCCL_INSTALL_PREFIX=${WORKDIR}/rccl
COPY projects/rocshmem/   /tmp/local/projects/rocshmem/
COPY projects/rccl/       /tmp/local/projects/rccl/
RUN if [ "${USE_LOCAL_SRC}" = "1" ]; then \
      mkdir -p ${SRC}/projects && \
      for proj in rocshmem rccl; do \
        [ -d /tmp/local/projects/$proj ] || { echo "ERROR: projects/$proj not in build context"; exit 1; }; \
        find /tmp/local/projects/$proj -name CMakeCache.txt -delete && \
        find /tmp/local/projects/$proj -name CMakeFiles -type d -exec rm -rf {} + 2>/dev/null; \
        find /tmp/local/projects/$proj -name build -type d -exec rm -rf {} + 2>/dev/null; \
        cp -r /tmp/local/projects/$proj ${SRC}/projects/$proj; \
      done && \
      git init ${SRC}; \
    else \
      git clone --no-checkout --filter=blob:none ${ROCM_REPO} ${SRC} && \
      cd ${SRC} && \
      git sparse-checkout set --cone projects/rocshmem projects/rccl projects/rccl-tests && \
      git checkout ${BRANCH}; \
    fi

## building RCCL (builds rocshmem from source via --rocshmem-gin)
RUN cd ${SRC}/projects/rccl \
 && ./install.sh --amdgpu_targets=${GPU_TARGETS} --prefix=${RCCL_INSTALL_PREFIX} \
      --no-device-linker --no_clean --rocshmem-gin \
      --cmake-options "-DROCSHMEM_CMAKE_OPTIONS=-DBUILD_DEBUG_TRACE_DEVICE=ON -DBUILD_DEBUG_DEVICE=ON -DBUILD_DEBUG_TRACE_HOST=ON" \
      $([ "${DEBUG_BUILD}" = "1" ] && echo "--debug")

## Copy rccl-tests separately so edits don't rebuild rccl/rocshmem
COPY projects/rccl-tests/ /tmp/local/projects/rccl-tests/
RUN if [ "${USE_LOCAL_SRC}" = "1" ]; then \
      cp -r /tmp/local/projects/rccl-tests ${SRC}/projects/rccl-tests; \
    fi

## building RCCL-Tests
# ROCSHMEM_INSTALL_DIR points to the ExternalProject install created by --rocshmem-gin
RUN mkdir -p rccl-tests \
    && cd rccl-tests \
    && cmake $([ "${DEBUG_BUILD}" = "1" ] && echo "-DCMAKE_BUILD_TYPE=Debug" || echo "-DCMAKE_BUILD_TYPE=Release") \
       -DUSE_MPI=ON -DENABLE_DEVICE_API=ON -DENABLE_ROCSHMEM=ON \
       -DRCCL_ROOT="${RCCL_INSTALL_PREFIX}" \
       -DCMAKE_PREFIX_PATH="${RCCL_INSTALL_PREFIX};${MPI_INSTALL_PREFIX}" \
       -DGPU_TARGETS=${GPU_TARGETS} \
       ${SRC}/projects/rccl-tests \
    && make -j16



# OPTIONAL: Setup ssh (only needed to use mpirun launch method, e.g., rocshmem functional tests)
# The following block is OPTIONAL and can be commented out if you only want to run 1-node testing
# Note: all deployed containers must share the SAME KEY!
#   Same docker image build must be deployed on all nodes (docker save, docker load)
ARG SSH_PORT=2222
RUN ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519
# Alternative: comment line above, uncomment lines below:
#   import an invariant ssh-key from outside the docker (so you can build the docker on each nodes)
#COPY id_ed25519 /root/.ssh/id_ed25519
#COPY id_ed25519.pub /root/.ssh/id_ed25519.pub
RUN cat ~/.ssh/id_ed25519.pub >~/.ssh/authorized_keys && \
    sed -i "s/#Port 22/Port $SSH_PORT/" /etc/ssh/sshd_config && \
    mkdir -p /run/sshd && ssh-keygen -A && \
    echo " StrictHostKeyChecking=accept-new" >>/root/.ssh/config
CMD ["sh", "-c", "\
        set -e; \
        rocshmem/bin/rocshmem_info \
     && echo \"Starting SSH server for mpiexec with OMPI_MCA_plm_rsh_arg=$OMPI_MCA_plm_rsh_args\" \
     && exec /usr/sbin/sshd -D"]
# End of ssh setup

