+/* The caller must retain the unencrypted VRAM backing until this returns. */
+int amdgpu_ttm_zero_vram_checked(struct amdgpu_device *adev, u64 offset,
+				 u64 bytes)
+{
+	struct amdgpu_ttm_buffer_entity *entity;
+	u64 address = amdgpu_ttm_domain_start(adev, TTM_PL_VRAM);
+	int r;
+
+	if (!adev->mman.buffer_funcs_enabled ||
+	    !adev->mman.num_clear_entities || !bytes ||
+	    ((offset | bytes) & ~PAGE_MASK) ||
+	    offset > U64_MAX - address || bytes > U64_MAX - (address + offset))
+		return -EINVAL;
+	address += offset;
+	entity = &adev->mman.clear_entities[0];
+	while (bytes) {
+		struct dma_fence *fence = NULL;
+		/* Match clear_buffer's bound and the fill helper's u32 size. */
+		u32 chunk = min_t(u64, bytes, 256ULL << 20);
+
+		mutex_lock(&entity->lock);
+		r = amdgpu_ttm_fill_mem(adev, entity, 0, address, chunk,
+				       NULL, &fence, false,
+				       AMDGPU_KERNEL_JOB_ID_TTM_CLEAR_BUFFER);
+		mutex_unlock(&entity->lock);
+		if (r)
+			return r;
+		/* Retire each bounded job before reusing or releasing backing. */
+		r = dma_fence_wait(fence, false);
+		if (!r) {
+			r = dma_fence_get_status(fence);
+			r = r > 0 ? 0 : (r ? r : -EIO);
+		}
+		dma_fence_put(fence);
+		if (r)
+			return r;
+		address += chunk;
+		bytes -= chunk;
+	}
+	return 0;
+}
