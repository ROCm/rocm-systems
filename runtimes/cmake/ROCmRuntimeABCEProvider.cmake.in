@PACKAGE_INIT@

if(NOT TARGET rocm_runtime::abce_shared)
    add_library(rocm_runtime::abce_shared SHARED IMPORTED)
    if("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
        set_target_properties(rocm_runtime::abce_shared PROPERTIES
            IMPORTED_LOCATION "@PACKAGE_CMAKE_INSTALL_BINDIR@/rocddi_runtime.dll"
            IMPORTED_IMPLIB "@PACKAGE_CMAKE_INSTALL_LIBDIR@/rocddi_runtime.dll.lib")
    else()
        set_target_properties(rocm_runtime::abce_shared PROPERTIES
            IMPORTED_LOCATION "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libhsa-runtime64.so.@_runtime_hsa_abi_version@"
            IMPORTED_SONAME "libhsa-runtime64.so.@_runtime_hsa_abi_major@")
    endif()
    set_target_properties(rocm_runtime::abce_shared PROPERTIES
        INTERFACE_LINK_LIBRARIES rocm_runtime::runtime_headers
        INTERFACE_COMPILE_DEFINITIONS ABCE_ENABLE_IMPLEMENTATION=0)
endif()
