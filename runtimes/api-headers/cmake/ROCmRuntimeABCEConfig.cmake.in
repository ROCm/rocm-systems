@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/ROCmRuntimeABCEHeaders.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ROCmRuntimeABCEProvider.cmake" OPTIONAL)

option(ABCE_HEADER_ONLY "Use the ABCE header implementation" ON)
if(NOT ABCE_HEADER_ONLY AND NOT TARGET rocm_runtime::abce_shared)
    set(ROCmRuntimeABCE_FOUND FALSE)
    set(ROCmRuntimeABCE_NOT_FOUND_MESSAGE
        "ABCE_HEADER_ONLY=OFF requires the Rust provider; install the full ROCm runtimes package")
    return()
endif()
if(NOT TARGET rocm_runtime::abce)
    add_library(rocm_runtime::abce INTERFACE IMPORTED)
    if(ABCE_HEADER_ONLY)
        set_property(TARGET rocm_runtime::abce PROPERTY
            INTERFACE_LINK_LIBRARIES rocm_runtime::abce_headers)
    else()
        set_property(TARGET rocm_runtime::abce PROPERTY
            INTERFACE_LINK_LIBRARIES rocm_runtime::abce_shared)
    endif()
endif()
check_required_components(ROCmRuntimeABCE)
