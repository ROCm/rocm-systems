{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Phase-10 Feature G Flash/SDPA/KV-cache attention signatures. Consumed by the Compute Specialist.",
  "required": ["version", "patterns"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "signature": {"type": "object"},
          "verdict": {"type": "string"},
          "recommend": {
            "type": "array",
            "items": {"type": "string"}
          },
          "recommend_if_absent": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "derivation": {"type": "object"},
    "notes": {"type": "string"}
  }
}
