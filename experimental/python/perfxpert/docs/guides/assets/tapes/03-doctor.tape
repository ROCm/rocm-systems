# perfxpert getting-started demo — scenario 03-doctor
# Generated via: vhs 03-doctor.tape
# See docs/guides/getting-started.md

Output ../gifs/03-doctor.gif

Set Shell "bash"
Set FontSize 14
Set Width 1200
Set Height 700
Set Theme "TokyoNight"
Set TypingSpeed 25ms
Set Padding 20

Hide
Type "cd /tmp/perfxpert-vhs-demo"
Enter
Sleep 200ms
Type "clear"
Enter
Sleep 200ms
Show

Type "# perfxpert doctor: one-shot health check"
Enter
Sleep 500ms
Type "perfxpert doctor"
Enter
Sleep 6s
