# perfxpert getting-started demo — scenario 14-perfxpert-code
# Generated via: vhs 14-perfxpert-code.tape
# See docs/guides/getting-started.md

Output ../gifs/14-perfxpert-code.gif

Set Shell "bash"
Set FontSize 13
Set Width 1200
Set Height 750
Set Theme "TokyoNight"
Set TypingSpeed 25ms
Set Padding 20

Hide
Type "cd /tmp/perfxpert-vhs-demo"
Enter
Sleep 200ms
Type "clear"
Enter
Sleep 200ms
Show

Type "# AMD-branded opencode TUI — command tree"
Enter
Sleep 500ms
Type "perfxpert-code opencode --help 2>&1 | head -35"
Enter
Sleep 7s
