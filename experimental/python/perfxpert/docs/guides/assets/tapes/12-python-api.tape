# perfxpert getting-started demo — scenario 12-python-api
# Generated via: vhs 12-python-api.tape
# See docs/guides/getting-started.md

Output ../gifs/12-python-api.gif

Set Shell "./vhs-demo-shell.sh"
Set FontSize 14
Set Width 1200
Set Height 600
Set Theme "TokyoNight"
Set TypingSpeed 25ms
Set Padding 20

Hide
Type "cd /tmp/perfxpert-vhs-demo"
Enter
Sleep 200ms
Type "clear"
Enter
Sleep 200ms
Show

Type "# Public Python API — embed PerfXpert in your own tooling"
Enter
Sleep 500ms
Type "cat _python_api_demo.py"
Enter
Sleep 3s
Type "python3 _python_api_demo.py"
Enter
Sleep 6s
