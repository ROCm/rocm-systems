{
  "max_ticks": 100000,
  "num_threads": 1,
  "exec_mode": "functional",
  "vm": { "arch": "cdna4" },
  "topology": {
    "root": {
      "name": "soc", "type": "soc",
      "children": [
        { "name": "vram", "type": "gpu_memory" },
        {
          "name": "xcd[0:1]", "type": "xcd",
          "children": [
            { "name": "l2", "type": "l2_cache" },
            { "name": "cp", "type": "command_processor" },
            {
              "name": "se[0:1]", "type": "shader_engine",
              "children": [{
                "name": "cu[0:4]", "type": "compute_unit",
                "config": [
                  { "key": "num_wf_slots", "value": "10" },
                  { "key": "sgprs_per_wf", "value": "104" },
                  { "key": "vgprs_per_wf", "value": "256" },
                  { "key": "lds_size_kb", "value": "160" }
                ]
              }]
            }
          ]
        }
      ]
    },
    "links": [
      {
        "pattern": "xcd[i].cp.req_[j*4+k] -> xcd[i].se[j].cu[k].cpl",
        "for_ranges": [
          { "var_name": "i", "start": 0, "end": 1 },
          { "var_name": "j", "start": 0, "end": 1 },
          { "var_name": "k", "start": 0, "end": 4 }
        ],
        "latency": 1, "weight": 2
      },
      {
        "pattern": "xcd[i].se[j].cu[k].req -> xcd[i].l2.cpl_[j*4+k]",
        "for_ranges": [
          { "var_name": "i", "start": 0, "end": 1 },
          { "var_name": "j", "start": 0, "end": 1 },
          { "var_name": "k", "start": 0, "end": 4 }
        ],
        "latency": 1, "weight": 10
      }
    ]
  }
}
